@using HortiBts.Client.MultiLanguage
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Common
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using MudBlazor

@inject LanguageService Lang
@inject AuthApiService AuthService
@inject LocalStorageService Storage
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IUserContextService UserContextService

@inherits LayoutComponentBase

<MudShadcnProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />

<MudLayout Style="min-height:100vh; display:flex; flex-direction:column;">

    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Outlined.KeyboardArrowUp" />
    </MudScrollToTop>

    <!-- App Bar -->
    <MudAppBar Elevation="1">

        <MudToggleIconButton @bind-Toggled="_drawerOpen" Icon="@Icons.Material.Outlined.Menu"
                             ToggledIcon="@Icons.Material.Outlined.Menu" />

        <MudAvatar Size="Size.Medium" Class="ms-2 mr-2">
            <MudImage Src="images/icons/Coat_of_arms_of_Chhattisgarh.jpg" Alt="Logo" Height="40" />
        </MudAvatar>

        <MudAvatar Size="Size.Medium" Class="mr-2">
            <MudImage Src="images/icons/HortiLogo.jpg" Alt="Logo" Height="40" />
        </MudAvatar>

        <MudHidden Breakpoint="Breakpoint.Lg" Invert="true">
            <MudText Typo="Typo.h6" Class="ml-3">
                @Lang.Text(
                    "Chhattisgarh Horticulture Beneficiary Tracking System",
                    "छत्तीसगढ़ हॉर्टिकल्चर बेनेफिशियरी ट्रैकिंग सिस्टम")
            </MudText>
        </MudHidden>
        <MudSpacer />
        <MudChip T="string" Label="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled">
            <MudStack Spacing="0" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">
                    @UserContextService.GetUserRoleText(_currentUser)
                    @UserContextService.GetUserNameText(_currentUser)
                </MudText>
            </MudStack>
        </MudChip>
        <!-- Dark Mode -->
        <MudTooltip Text="@(_isDarkMode ? Lang.Text("Light Mode", "लाइट मोड") : Lang.Text("Dark Mode", "डार्क मोड"))">
            <MudToggleIconButton Toggled="@_isDarkMode" ToggledChanged="ToggleDarkMode" Color="Color.Primary"
                                 Icon="@Icons.Material.Outlined.DarkMode" ToggledIcon="@Icons.Material.Outlined.LightMode" />
        </MudTooltip>

        <!-- Language -->
        <MudTooltip Text="@Lang.Text("Change to Hindi", "अंग्रेजी मे बदले")">
            <MudToggleIconButton Toggled="@_isHindi" ToggledChanged="ToggleLanguage" Color="Color.Primary"
                                 Icon="material-symbols-outlined/translate_indic"
                                 ToggledIcon="material-symbols-outlined/translate_indic" />
        </MudTooltip>

        <!-- Settings -->
        <MudTooltip Text="@Lang.Text("Open Settings", "सेटिंग्स खोले")">
            <MudMenu Icon="@Icons.Material.Outlined.Settings" Color="Color.Primary" AriaLabel="Open user menu">

                <MudMenuItem Icon="@Icons.Material.Outlined.DisplaySettings" IconColor="Color.Primary"
                             Href="admin/update-password" Label="@Lang.Text("Update Admin Password", "एडमिन पासवर्ड अपडेट")" />

                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Primary" OnClick="Logout"
                             Label="@Lang.Text("Log Out", "लॉग आउट")" />

            </MudMenu>
        </MudTooltip>

    </MudAppBar>

    <!-- Drawer -->
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" Width="300px" ClipMode="DrawerClipMode.Always" Elevation="2">
        <AuthorizeView Roles="Admin">
            <AdminNavMenu />
        </AuthorizeView>

        <AuthorizeView Roles="District">
            <DistrictNavMenu />
        </AuthorizeView>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="pt-16 pa-4 mt-4">
        @Body
    </MudMainContent>

    <!-- Footer -->
    <MudPaper Elevation="2" Class="pa-3 d-flex justify-end">
        <MudText Typo="Typo.caption" Align="Align.End">
            @Lang.Text(
                "© 2026 Chhattisgarh Government. All Rights Reserved.",
                "© 2026 छत्तीसगढ़ शासन। सर्वाधिकार सुरक्षित।")
        </MudText>
    </MudPaper>

</MudLayout>

<!-- Blazor Error UI -->
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _isHindi = true;
    private CurrentUserInfo _currentUser = new("", "", "", 0);

    // ---------------------------------------------------------
    // Initialization
    // ---------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {

        Lang.OnLanguageChanged += OnLanguageChanged;

        try
        {
            await LoadPreferencesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout preference error: {ex}");
        }

        try
        {
            await LoadCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout user error: {ex}");
        }
    }

    private readonly ShadcnTheme _theme = MudShadcnTheme.Create(new ShadcnThemeOptions
    {
        Style = ShadcnStyle.Rhea,
        Theme = ShadcnColor.Emerald,
        FontFamily = ["Geist", "Noto Sans Devanagari", .. MudShadcnTheme.DefaultFontFamily],
        IconLibrary = ShadcnIconLibrary.Lucide,
    });


    // ---------------------------------------------------------
    // Preferences
    // ---------------------------------------------------------

    private async Task LoadPreferencesAsync()
    {
        var darkMode = await Storage.GetAsync<bool>("darkMode");
        var isHindi = await Storage.GetAsync<bool>("isHindi");

        _isDarkMode = darkMode.Success ? darkMode.Value : false;
        _isHindi = isHindi.Success ? isHindi.Value : true;

        Lang.SetLanguage(_isHindi);
    }

    // ---------------------------------------------------------
    // Current User
    // ---------------------------------------------------------

    private async Task LoadCurrentUserAsync()
    {
        _currentUser = await UserContextService.GetCurrentUserAsync();
    }

    // ---------------------------------------------------------
    // Dark Mode
    // ---------------------------------------------------------

    private async Task ToggleDarkMode(bool value)
    {
        _isDarkMode = value;
        await Storage.SetAsync("darkMode", value);
    }

    // ---------------------------------------------------------
    // Language
    // ---------------------------------------------------------

    private async Task ToggleLanguage(bool value)
    {
        _isHindi = value;
        Lang.SetLanguage(value);
        await Storage.SetAsync("isHindi", value);
    }

    private void OnLanguageChanged()
    {
        _isHindi = Lang.IsHindi;
        InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------
    // Logout
    // ---------------------------------------------------------

    private async Task Logout()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            Lang.Text("Confirm Logout", "लॉगआउट पुष्टिकरण"),
            Lang.Text("Are you sure you want to logout?", "क्या आप वाकई लॉगआउट करना चाहते हैं?"),
            yesText: Lang.Text("Logout", "लॉगआउट"),
            cancelText: Lang.Text("Cancel", "रद्द करें"));

        if (result == true)
        {
            await AuthService.LogoutAsync();
            Nav.NavigateTo("login", forceLoad: true);
        }
    }
   
}
