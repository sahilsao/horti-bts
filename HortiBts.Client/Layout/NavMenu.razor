@using Microsoft.AspNetCore.Components.Authorization
<MudNavMenu>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="/admin/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                @Lang.Text("Dashboard", "डैशबोर्ड")
            </MudNavLink>
            <MudNavLink Href="/admin/farmer-details" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PersonSearch">
                @Lang.Text("Farmer Details", "कृषक विवरण")
            </MudNavLink>
            <MudNavLink Href="/admin/farmer-verification" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DomainVerification">
                @Lang.Text("Farmer Verification", "कृषक भौतिक सत्यापन")
            </MudNavLink>
            <MudNavGroup Title="@Lang.Text("Master Entry", "मास्टर एंट्री")" Icon="@Icons.Material.Filled.Edit">
                <MudNavLink Href="/admin/add-benefit" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AddAlarm">
                    @Lang.Text("Add Benefit", "लाभ जोड़ें")
                </MudNavLink>
                <MudNavLink Href="/admin/add-scheme" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PostAdd">
                    @Lang.Text("Add Scheme", "योजना जोड़ें")
                </MudNavLink>
                <MudNavLink Href="/admin/add-component" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.BookmarkAdd">
                    @Lang.Text("Add Component", "घटक जोड़ें")
                </MudNavLink>
                <MudNavLink Href="/admin/add-target" Match="NavLinkMatch.All" Icon="material-symbols-outlined/target">
                    @Lang.Text("Physical targets (for the district) ", "भौतिक लक्ष्य जोड़े (जिला हेतु)")
                </MudNavLink>
                <MudNavLink Href="/admin/add-midh-scheme" Match="NavLinkMatch.All" Icon="material-symbols-outlined/assignment_add">
                    @Lang.Text("Add MIDH Scheme", "MIDH योजना जोड़ें")
                </MudNavLink>
                <MudNavLink Href="/admin/add-midh-component-type" Match="NavLinkMatch.All" Icon="material-symbols-outlined/box_add">
                    @Lang.Text("Add MIDH Component Type", "MIDH घटक प्रकार जोड़ें")
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>