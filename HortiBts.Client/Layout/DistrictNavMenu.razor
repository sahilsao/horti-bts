                    @Lang.Text("Scheme-Wise Farmer Registration Report", "योजनावार कृषक पंजीयन रिपोर्ट")
                </MudNavLink>
                <MudNavLink Href="/reports/scheme/componentwise-farmer-registration-report" Match="NavLinkMatch.Prefix"
                            Ripple Icon="@Icons.Material.Filled.LineStyle">
                    @Lang.Text("Component-Wise Farmer Registration Report", "घटकवार कृषक पंजीयन रिपोर्ट")
                </MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="@Lang.Text("User Report", "यूजर रिपोर्ट")" Ripple Icon="@Icons.Material.Filled.ListAlt">
                <MudNavLink Href="/users/add-officer" Match="NavLinkMatch.Prefix" Ripple
                            Icon="material-symbols-outlined/person_add">
                    @Lang.Text("Add New Officer", "नया अधिकारी जोड़ें")
                </MudNavLink>
                <MudNavLink Href="/users/officer-charge-transfer" Match="NavLinkMatch.Prefix" Ripple
                            Icon="material-symbols-outlined/transfer_within_a_station">
                    @Lang.Text("Transfer of Charge (Officer)", "(अधिकारी) प्रभार स्थानांतरण")
                </MudNavLink>
                <MudNavLink Href="/reports/rheo-list" Match="NavLinkMatch.Prefix" Ripple
                            Icon="material-symbols-outlined/patient_list">
                    @Lang.Text("RHEO List/Mapping", "आर.एच.ई.ओ. सूची/मैपिंग")
                </MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/district/reset-others-password" Match="NavLinkMatch.Prefix" Ripple
                        Icon="@Icons.Material.Filled.LockReset">
                @Lang.Text("Reset Password (District/RHEO)", "रिसेट पासवर्ड (जिला/आर.एच.ई.ओ.)")
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>


@code {

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private List<FinancialYearDto> _finyears = [];
    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadFinancialYearsAsync();
    }

    private async Task LoadCurrentUserAsync()
    {
        _currentUser = await UserContextService.GetCurrentUserAsync();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(1).ToList();

    }
}