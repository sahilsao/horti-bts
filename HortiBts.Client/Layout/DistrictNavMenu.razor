@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Shared.Dtos.FinancialYear
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserContextService UserContextService
@inject FinancialYearsApiService FinancialYearsApiService

<MudNavMenu Bordered="true" MultiExpansion="false" Margin="Margin.Normal" Color="Color.Primary">
    <AuthorizeView Roles="District">
        <Authorized>
            <MudNavLink Href="/district/dashboard" Match="NavLinkMatch.Prefix" Ripple
                        Icon="@Icons.Material.Filled.Dashboard">
                @Lang.Text("Dashboard", "डैशबोर्ड")
            </MudNavLink>
            <MudNavLink Href="/district/farmer-details" Match="NavLinkMatch.Prefix" Ripple
                        Icon="@Icons.Material.Filled.PersonSearch">
                @Lang.Text("Farmer Details", "कृषक विवरण")
            </MudNavLink>
            <MudNavLink Href="/district/farmer-verification" Match="NavLinkMatch.Prefix" Ripple
                        Icon="@Icons.Material.Filled.DomainVerification">
                @Lang.Text("Farmer Verification", "कृषक भौतिक सत्यापन")
            </MudNavLink>
            <MudNavGroup Ripple Icon="@Icons.Material.Filled.Edit">
                <TitleContent>
                    @Lang.Text("Application Verification", "आवेदन सत्यापन")
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">FY (2025-26 / 2026-27)</MudChip>
                </TitleContent>
                <ChildContent>
                    <MudNavLink Href="/district/scheme-type-wise-new-application-list" Match="NavLinkMatch.Prefix"
                                Ripple Icon="@Icons.Material.Filled.DomainVerification">
                        @Lang.Text("Scheme Wise New Application List (2025-26 / 2026-27)", "योजनावार नविन आवेदन सूची (2025-26 / 2026-27)")
                    </MudNavLink>
                    <MudNavLink Href="/district/scheme-wise-new-application-beneficiary-list"
                                Match="NavLinkMatch.Prefix" Ripple Icon="@Icons.Material.Filled.ViewList">
                        @Lang.Text("New Application Beneficiary List (2025-26 / 2026-27)", "नविन आवेदन लाभार्थी सूची (2025-26 / 2026-27)")
                    </MudNavLink>
                </ChildContent>
            </MudNavGroup>
            <MudNavGroup Ripple Icon="@Icons.Material.Filled.Edit">
                <TitleContent>
                    @Lang.Text("Application Verification", "आवेदन सत्यापन")
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">FY (2018-19 / 2024-25)</MudChip>
                </TitleContent>
                <ChildContent>
                    <MudNavLink Href="/district/scheme-type-wise-old-application-list" Match="NavLinkMatch.Prefix"
                                Ripple Icon="@Icons.Material.Filled.DomainVerification">
                        @Lang.Text("Scheme Wise Old Application List (2018-19 / 2024-25)", "योजनावार पूर्व आवेदन सूची (2018-19 / 2024-25)")
                    </MudNavLink>
                    <MudNavLink Href="/district/scheme-wise-old-application-beneficiary-list"
                                Match="NavLinkMatch.Prefix" Ripple Icon="@Icons.Material.Filled.ViewList">
                        @Lang.Text("Old Application Beneficiary List (2018-19 / 2024-25)", "पूर्व आवेदन लाभार्थी सूची (2018-19 / 2024-25)")
                    </MudNavLink>
                </ChildContent>
            </MudNavGroup>
            <MudNavGroup Ripple Icon="@Icons.Material.Filled.FileOpen">
                <TitleContent>
                    @Lang.Text("Reports", "रिपोर्ट्स")
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">FY (2026-27)</MudChip>
                </TitleContent>
                <ChildContent>
                    <MudNavGroup Title="@Lang.Text("Applications Reports", "आवेदन रिपोर्ट्स")" Ripple
                                 Icon="material-symbols-outlined/order_approve">
                        @if (_finyears.FirstOrDefault() is { } financialYear)
                        {
                            <MudNavLink
                                Href="@($"/reports/applications/current/farmerwise-farmer-applications-list/{_currentUser.UserId}/0/0/0/{financialYear.Id}")"
                                Match="NavLinkMatch.Prefix" Ripple="true" Icon="material-symbols-outlined/domain">

                                @Lang.Text(
                                    "Farmer Wise Applications List",
                                    "किसानवार आवेदन सूची")

                            </MudNavLink>
                        }
                    </MudNavGroup>
                </ChildContent>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>


@code {

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private List<FinancialYearDto> _finyears = [];
    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadFinancialYearsAsync();
    }

    private async Task LoadCurrentUserAsync()
    {
        _currentUser = await UserContextService.GetCurrentUserAsync();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(1).ToList();

    }
}