@page "/admin/farmer-verification" 
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.SubDistricts
@using HortiBts.Client.Services.Villages
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Shared.Dtos.SubDistricts
@using HortiBts.Shared.Dtos.Villages
@inject DistrictsApiService DistrictsApiService
@inject SubdistrictsApiService SubdistrictsApiService
@inject VillagesApiService VillagesApiService

@* todo: change to /farmer-verification when ready for public *@

<PageTitle>@Lang.Text("Farmer Verification", "कृषक भौतिक सत्यापन")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.DomainVerification" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Farmer Verification", "कृषक भौतिक सत्यापन")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Search for farmers in the Integrated Farmer Portal.", "एकीकृत किसान पोर्टल में किसान खोजें")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedDistrictCensus"
                   Label="@Lang.Text("District", "जिला")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnDistrictChanged">
            @foreach (var d in _districts)
            {
                <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                    @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Value="_selectedSubdistrictId"
                   Label="@Lang.Text("Block", "विकासखण्ड")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnSubdistrictChanged"
                   Disabled="_selectedDistrictCensus is null || _isLoadingVillages">
            @foreach (var s in _subdistricts)
            {
                <MudSelectItem T="int?" Value="s.SubDistrictCode">
                    @(Lang.IsHindi ? s.SubDistrictNameHi : s.SubDistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudAutocomplete T="VillagesDto"
                         Label="@Lang.Text("Village", "ग्राम")"
                         Variant="Variant.Outlined"
                         Value="_selectedVillage"
                         ValueChanged="OnVillageSelected"
                         SearchFunc="SearchVillages"
                         ToStringFunc="@(v => v is null ? string.Empty : Lang.Text(v.VillageName, v.VillageNameHi))"
                         Disabled="_selectedSubdistrictId is null || _isLoadingVillages"
                         ResetValueOnEmptyText="true"
                         CoerceText="true" />
    </MudItem>
</MudGrid>
@* ---------- Search / Reset ---------- *@
<MudStack Row="true" Spacing="3" Class="mb-6">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SearchByLocationAsync"
               Disabled="_isLoading || _selectedVillageId is null">
        @Lang.Text("Search", "खोजें")
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               OnClick="ResetLocationFilters"
               Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@code {
    private List<DistrictsDto> _districts = new();
    private List<SubDistrictsDto> _subdistricts = new();
    private List<VillagesDto> _villages = new();

    private int? _selectedDistrictCensus;
    private int? _selectedSubdistrictId;
    private int? _selectedVillageId;

    private bool _isLoadingDistricts;
    private bool _isLoadingSubdistricts;
    private bool _isLoadingVillages;
    private bool _isLoading;
    private bool _hasSearched;

    protected override async Task OnInitializedAsync()
    {
        _isLoadingDistricts = true;
        try
        {
            var result = await DistrictsApiService.GetDistrictsAsync();
            if (result.IsSuccess && result.Data is not null)
                _districts = result.Data;
        }
        finally
        {
            _isLoadingDistricts = false;
        }
    }

    private async Task OnDistrictChanged(int? districtId)
    {
        _selectedDistrictCensus = districtId;

        // reset everything downstream
        _selectedSubdistrictId = null;
        _selectedVillageId = null;
        _subdistricts = new();
        _villages = new();

        if (districtId is null)
            return;

        _isLoadingSubdistricts = true;
        try
        {
            var result = await SubdistrictsApiService.GetSubdistrictsAsync(districtId.Value);
            if (result.IsSuccess && result.Data is not null)
                _subdistricts = result.Data;
        }
        finally
        {
            _isLoadingSubdistricts = false;
        }
    }

    private async Task OnSubdistrictChanged(int? subdistrictId)
    {
        _selectedSubdistrictId = subdistrictId;

        // reset village downstream
        _selectedVillageId = null;
        _villages = new();

        if (subdistrictId is null)
            return;

        _isLoadingVillages = true;
        try
        {
            var result = await VillagesApiService.GetVillagesAsync(subdistrictId.Value);
            if (result.IsSuccess && result.Data is not null)
                _villages = result.Data;
        }
        finally
        {
            _isLoadingVillages = false;
        }
    }

    private VillagesDto? _selectedVillage;

    private Task<IEnumerable<VillagesDto>> SearchVillages(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_villages.AsEnumerable());

        var filtered = _villages
            .Where(v =>
            (v.VillageName is not null && v.VillageName.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (v.VillageNameHi is not null && v.VillageNameHi.Contains(value, StringComparison.OrdinalIgnoreCase)))
        .ToList();

        return Task.FromResult(filtered.AsEnumerable());
    }

    private void OnVillageSelected(VillagesDto? village)
    {
        _selectedVillage = village;
        _selectedVillageId = village?.VillageCode;
    }

    private async Task SearchByLocationAsync()
    {
        if (_selectedVillageId is null)
            return;

        _isLoading = true;
        _hasSearched = true;

        try
        {
            // call whichever farmer/list-by-village API applies here, e.g.:
            // var result = await FarmersDetailsApiService.GetFarmersByVillageAsync(_selectedVillageId.Value);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetLocationFilters()
    {
        _selectedDistrictCensus = null;
        _selectedSubdistrictId = null;
        _selectedVillageId = null;
        _selectedVillage = null;
        _subdistricts = new();
        _villages = new();
        _hasSearched = false;
    }
}
