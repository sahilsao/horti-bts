        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Address Details", "पता विवरण")</strong></MudText>
        <MudDivider />
        <MudTable Items="_farmerAddressDetails" Hover="true" Dense="true" Class="pa-2" Elevation="0">
            <HeaderContent>
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh>@Lang.Text("Address", "पता")</MudTh>
                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                <MudTh>@Lang.Text("Block", "विकासखण्ड")</MudTh>
                <MudTh>@Lang.Text("District", "जिला")</MudTh>
            </HeaderContent>
