                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(bnk.DistrictName)</MudTd>
                <MudTd DataLabel="@Lang.Text("State", "राज्य")">@StateLabel(bnk.BankStateName)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* ---------- Land Details Result (Tabbed by Financial Year) ---------- *@
@if (_finYears.Any())
{
    @* ---------- Land Details Result ---------- *@
    <MudPaper Class="pa-0 overflow-hidden mt-6" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Land Details", "भूमि विवरण")</strong></MudText>
        <MudDivider />
        <MudTabs Elevation="0" Rounded="true" Class="pa-2" ApplyEffectsToContainer="true">
            @foreach (var fy in _finYears)
            {
                <MudTabPanel Text="@fy.FinancialYear">
                    @{
                        var yearRows = _farmerLandDetails.Where(l => l.FinancialYear == fy.Id).ToList();
                    }

                    @if (yearRows.Any())
                    {
                        <MudTable Items="yearRows" Hover="true" Breakpoint="Breakpoint.None" Class="mt-2" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                                <MudTh>@Lang.Text("Khasra No.", "खसरा क्रमांक")</MudTh>
                                <MudTh>@Lang.Text("Owner", "स्वामी")</MudTh>
                                <MudTh>@Lang.Text("Owner Type", "स्वामी प्रकार")</MudTh>
                                <MudTh>@Lang.Text("Area", "रकबा")</MudTh>
                                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                                <MudTh>@Lang.Text("Block", "विकासखण्ड")</MudTh>
                                <MudTh>@Lang.Text("District", "जिला")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(yearRows.IndexOf(context) + 1)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Khasra No.", "खसरा क्रमांक")">@Or(context.KhasraNo)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Owner", "स्वामी")">@Or(context.OwnerName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Owner Type", "स्वामी प्रकार")">@Or(context.Ownertype)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Area", "रकबा")">@context.Area</MudTd>
                                <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(context.VillageName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Block", "विकासखण्ड")">@Or(context.SubdistrictName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(context.DistrictName)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="ma-2">
                            @Lang.Text("No land records found for this financial year.", "इस वित्तीय वर्ष के लिए कोई भूमि विवरण नहीं मिला।")
                        </MudAlert>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>

    @* ---------- Scheme Details Result ---------- *@
    <MudPaper Class="pa-0 overflow-hidden mt-6" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Scheme Details", "योजना विवरण")</strong></MudText>
        <MudDivider />
        <MudTabs Elevation="0" Rounded="true" Class="pa-2" ApplyEffectsToContainer="true">
            @foreach (var fy in _finYears)
            {
                <MudTabPanel Text="@fy.FinancialYear">
                    @{
                        var yearRows = _farmerSchemeDetails.Where(l => l.FinancialYear == fy.Id).ToList();
                    }

                    @if (yearRows.Any())
                    {
                        <MudTable Items="yearRows" Hover="true" Breakpoint="Breakpoint.None" Class="mt-2" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                                <MudTh>@Lang.Text("District", "जिला")</MudTh>
                                <MudTh>@Lang.Text("Block", "विकासखण्ड")</MudTh>
                                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                                <MudTh>@Lang.Text("Scheme Name", "योजना का नाम")</MudTh>
                                <MudTh>@Lang.Text("Benefit", "लाभ")</MudTh>
                                <MudTh>@Lang.Text("Grant Amount", "अनुदान राशि")</MudTh>
                                <MudTh>@Lang.Text("Khasra No.", "खसरा क्रमांक")</MudTh>
                                <MudTh>@Lang.Text("Area", "रकबा")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(yearRows.IndexOf(context) + 1)</MudTd>
                                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(context.DistrictName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Block", "विकासखण्ड")">@Or(context.SubdistrictName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(context.VillageName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Scheme Name", "योजना का नाम")">@Or(context.SchemeName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Benefit", "लाभ")">@FormatBenefit(context)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Grant Amount", "अनुदान राशि")">@Or(context.Cash.ToString())</MudTd>
                                <MudTd DataLabel="@Lang.Text("Khasra No.", "खसरा क्रमांक")">@Or(context.KhasraNo)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Area", "रकबा")">@context.Area</MudTd>
