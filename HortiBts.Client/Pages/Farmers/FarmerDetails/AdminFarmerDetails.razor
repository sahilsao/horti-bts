                                <MudTh>@Lang.Text("District", "जिला")</MudTh>
                                <MudTh>@Lang.Text("Block", "विकासखण्ड")</MudTh>
                                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                                <MudTh>@Lang.Text("Crop Type", "फसल का प्रकार")</MudTh>
                                <MudTh>@Lang.Text("Crop Name", "फसल का नाम")</MudTh>
                                <MudTh>@Lang.Text("Variety", "किस्म")</MudTh>
                                <MudTh>@Lang.Text("Season", "सीजन")</MudTh>
                                <MudTh>@Lang.Text("Khasra No.", "खसरा क्रमांक")</MudTh>
                                <MudTh>@Lang.Text("Area", "रकबा")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(yearRows.IndexOf(context) + 1)</MudTd>
                                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(context.DistrictName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Block", "विकासखण्ड")">@Or(context.SubdistrictName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(context.VillageName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Crop Type", "फसल का प्रकार")">@Or(context.CropCategoryName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Crop Name", "फसल का नाम")">@Or(context.CropName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Variety", "किस्म")">@Or(context.CropVariety)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Season", "सीजन")">@Or(context.CropSeasonName)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Khasra No.", "खसरा क्रमांक")">@Or(context.KhasraNo)</MudTd>
                                <MudTd DataLabel="@Lang.Text("Area", "रकबा")">@context.CropArea</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="ma-2">
                            @Lang.Text("No scheme records found for this financial year.", "इस वित्तीय वर्ष के लिए कोई योजना विवरण नहीं मिला।")
                        </MudAlert>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>
}

@code {
    private string _searchUfId = string.Empty;
    private List<FarmerBasicDetailsDto> _farmerBasicDetails = new();
    private List<FarmerAddressDetailsDto> _farmerAddressDetails = new();
    private List<FarmerBankDetailsDto> _farmerBankDetails = new();

    private List<FinancialYearDto> _finYears = new();
    private List<FarmerLandDetailsDto> _farmerLandDetails = new();
    private List<FarmerSchemeDetailsDto> _farmerSchemeDetails = new();
    private List<FarmerCropDetailsDto> _farmerCropDetails = new();
    private bool _isLoading;
    private bool _hasSearched;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchUfId))
            return;

        _isLoading = true;
        _hasSearched = true;
        _farmerBasicDetails = new();
        _farmerAddressDetails = new();
        _farmerBankDetails = new();
        _finYears = new();
        _farmerLandDetails = new();
        _farmerSchemeDetails = new();
        _farmerCropDetails = new();

        try
        {
            var resultBasicDetails = await FarmersDetailsApiService.GetFarmersBasicDetailsAsync(_searchUfId.Trim());
            var resultAddressDetails = await FarmersDetailsApiService.GetFarmersAddressDetailsAsync(_searchUfId.Trim());
            var resultBankDetails = await FarmersDetailsApiService.GetFarmersBankDetailsAsync(_searchUfId.Trim());

            var resultFinYears = await FinancialYearApiService.GetFinancialYearsForReportAsync();

            if (resultBasicDetails.IsSuccess && resultBasicDetails.Data is not null && resultBasicDetails.Data.Any())
            {
                _farmerBasicDetails = resultBasicDetails.Data;
            }

            if (resultAddressDetails.IsSuccess && resultAddressDetails.Data is not null && resultAddressDetails.Data.Any())
            {
                _farmerAddressDetails = resultAddressDetails.Data;
            }

            if (resultBankDetails.IsSuccess && resultBankDetails.Data is not null && resultBankDetails.Data.Any())
            {
                _farmerBankDetails = resultBankDetails.Data;
            }

            if (resultFinYears.IsSuccess && resultFinYears.Data is not null)
            {
                // newest year first (id 17 -> 9), matches your sample order already
                _finYears = resultFinYears.Data.OrderByDescending(fy => fy.Id).ToList();

                // Land Details
                var tasksLandDetails = _finYears
                    .Select(fy => FarmersDetailsApiService.GetFarmersLandDetailsAsync(_searchUfId.Trim(), fy.Id.ToString()))
                    .ToList();

                var resultLandDetails = await Task.WhenAll(tasksLandDetails);

                _farmerLandDetails = resultLandDetails
                    .Where(r => r.IsSuccess && r.Data is not null)
                    .SelectMany(r => r.Data!)
                    .ToList();

                // Scheme Details
                var tasksSchemeDetails = _finYears
                .Select(fy => FarmersDetailsApiService.GetFarmersSchemeDetailsAsync(_searchUfId.Trim(), fy.Id.ToString()))
                .ToList();

                var resultSchemeDetails = await Task.WhenAll(tasksSchemeDetails);

                _farmerSchemeDetails = resultSchemeDetails
                    .Where(r => r.IsSuccess && r.Data is not null)
                    .SelectMany(r => r.Data!)
                    .ToList();

                // Crop Details
                var tasksCropDetails = _finYears
                .Select(fy => FarmersDetailsApiService.GetFarmersCropDetailsAsync(_searchUfId.Trim(), fy.Id.ToString()))
                .ToList();

                var resultCropDetails = await Task.WhenAll(tasksCropDetails);

                _farmerCropDetails = resultCropDetails
                    .Where(r => r.IsSuccess && r.Data is not null)
                    .SelectMany(r => r.Data!)
                    .ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Reset()
    {
        _searchUfId = string.Empty;
        _farmerBasicDetails = new();
        _farmerAddressDetails = new();
        _farmerBankDetails = new();
        _finYears = new();
        _farmerLandDetails = new();
        _farmerSchemeDetails = new();
        _farmerCropDetails = new();

        _hasSearched = false;
    }

    private async Task OnSearchBoxKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private string GenderLabel(string? gender) => gender switch
    {
        "M" => @Lang.Text("Male", "पुरुष"),
        "F" => @Lang.Text("Female", "महिला"),
        "T" => @Lang.Text("Transgender", "ट्रांसजेंडर"),
        _ => "-"
    };

    private string Or(string? value)
    => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatAddress(FarmerAddressDetailsDto a)
    => $"मकान संख्या/गली : {a.HouseNo}, वार्ड संख्या : {a.WardNo}, {a.Address}, पिनकोड: {a.Pincode}";

    private string StateLabel(string? stateName)
    => string.IsNullOrWhiteSpace(stateName) ? Lang.Text("Chhattisgarh", "छत्तीसगढ़") : stateName;

    private string FormatBenefit(FarmerSchemeDetailsDto s)
    {
        var type = string.IsNullOrWhiteSpace(s.BenefitTypeName) ? null : s.BenefitTypeName;
        var name = string.IsNullOrWhiteSpace(s.BenefitName) ? null : s.BenefitName;

        if (type is null && name is null)
            return "-";

        return type is null ? name!
             : name is null ? type
             : $"{type} - {name}";
    }
}
