@page "/admin/farmer-details"
@using HortiBts.Shared.Dtos.Farmers
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Client.Services.Farmers
@using HortiBts.Client.Services.FinancialYears
@using Microsoft.AspNetCore.Components.Web

@inject FarmersDetailsApiService FarmersDetailsApiService
@inject FinancialYearsApiService FinancialYearApiService

@inject ISnackbar Snackbar


<PageTitle>@Lang.Text("Farmer Details", "कृषक विवरण")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Farmer Details", "कृषक विवरण")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("View farmer details by entering the UFID.", "यु.एफ.आईडी दर्ज कर कृषक का विवरण देखें")
</MudText>
@* ---------- Search bar ---------- *@
<MudGrid>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-3 mb-6 d-flex align-center gap-3" Elevation="0"
                  Style="border:1px solid var(--mud-palette-lines-default); border-radius:12px;">
            <MudTextField @bind-Value="_searchUfId"
                          Placeholder="@Lang.Text("Enter the UFID", "यु.एफ.आईडी दर्ज करें")"
                          Variant="Variant.Text"
                          Immediate="true"
                          OnKeyDown="OnSearchBoxKeyDown"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Disabled="_isLoading"
                          Margin="Margin.Dense" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="SearchAsync"
                       Disabled="_isLoading || string.IsNullOrWhiteSpace(_searchUfId)">
                @Lang.Text("Search", "खोजें")
            </MudButton>

            @if (_hasSearched)
            {
                <MudTooltip Text="@Lang.Text("Reset", "रीसेट")">
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="Reset"
                                   Disabled="_isLoading" />
                </MudTooltip>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
@* ---------- Loading ---------- *@
@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-6" Rounded="true" />
}

@* ---------- Empty state ---------- *@
@if (_hasSearched && !_isLoading && !_farmerBasicDetails.Any())
{
    <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0"
              Style="border:1px dashed var(--mud-palette-lines-default); border-radius:12px;">
        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Class="mud-text-secondary mb-2" />
        <MudText Typo="Typo.body1" Class="mud-text-secondary">
            @Lang.Text("No details found for the entered UFID.", "दर्ज किए गए यु.एफ.आईडी के लिए कोई विवरण नहीं मिला")
        </MudText>
    </MudPaper>
}

@* ---------- Basic Details Result ---------- *@
@if (_farmerBasicDetails.Any())
{
    <MudPaper Class="pa-0 overflow-hidden" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Basic Details", "आधारभूत जानकारी")</strong></MudText>
        <MudDivider />
        <MudTable Items="_farmerBasicDetails" Hover="true" Dense="true" Class="pa-2" Elevation="0">
            <HeaderContent>
                <MudTh>@Lang.Text("UFID", "यु.एफ.आईडी")</MudTh>
                <MudTh>@Lang.Text("Name (English)", "नाम (अंग्रेजी)")</MudTh>
                <MudTh>@Lang.Text("Name (Hindi)", "नाम (हिंदी)")</MudTh>
                <MudTh>@Lang.Text("Father/Mother/Spouse", "पिता/माता/पति")</MudTh>
                <MudTh>@Lang.Text("Gender", "लिंग")</MudTh>
                <MudTh>@Lang.Text("Mobile Number 1", "मोबाइल नंबर 1")</MudTh>
                <MudTh>@Lang.Text("Mobile Number 2", "मोबाइल नंबर 2")</MudTh>
                <MudTh>@Lang.Text("Date of Birth", "जन्म तिथि")</MudTh>
                <MudTh>@Lang.Text("Caste", "वर्ग")</MudTh>
                <MudTh>@Lang.Text("Subcaste", "विशेष जनजाति")</MudTh>
            </HeaderContent>
            <RowTemplate Context="b">
                <MudTd DataLabel="@Lang.Text("UFID", "यु.एफ.आईडी")">@b.UfId</MudTd>
                <MudTd DataLabel="@Lang.Text("Name (English)", "नाम (अंग्रेजी)")">@b.FarmerNameEng</MudTd>
                <MudTd DataLabel="@Lang.Text("Name (Hindi)", "नाम (हिंदी)")">@b.FarmerNameHi</MudTd>
                <MudTd DataLabel="@Lang.Text("Father/Mother/Spouse", "पिता/माता/पति")">@Or(b.FatherName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Gender", "लिंग")">@GenderLabel(b.Gender)</MudTd>
                <MudTd DataLabel="@Lang.Text("Mobile Number 1", "मोबाइल नंबर 1")">@Or(b.MobileNo)</MudTd>
                <MudTd DataLabel="@Lang.Text("Mobile Number 2", "मोबाइल नंबर 2")">@Or(b.MobileNo1)</MudTd>
                <MudTd DataLabel="@Lang.Text("Date of Birth", "जन्म तिथि")">@Or(b.Dob?.ToString("dd/MM/yyyy"))</MudTd>
                <MudTd DataLabel="@Lang.Text("Caste", "वर्ग")">@Or(b.CasteName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Subcaste", "विशेष जनजाति")">@Or(b.SubcasteName)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}


@* ---------- Basic Address Result ---------- *@

