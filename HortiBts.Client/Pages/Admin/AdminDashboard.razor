@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]
@using HortiBts.Client.Services.Dashboard
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Shared.Dtos.Dashboard.Admin
@using HortiBts.Shared.Dtos.FinancialYear
@inject DashboardApiService DashboardService
@inject FinancialYearsApiService FinancialYearApiService
@inject ISnackbar Snackbar

<PageTitle>@Lang.Text("Admin Dashboard", "एडमिन डैशबोर्ड")</PageTitle>
<MudText Typo="Typo.h5" Class="mb-6 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.Agriculture" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Admin - Horticulture Farmer Dashboard", "एडमिन - उद्यानिकी कृषक डैशबोर्ड")
</MudText>

<!-- ===================== OVERALL SUMMARY ===================== -->
<MudGrid Spacing="3" Class="mb-4">
    <!-- Total RHEO -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="rounded-lg" Style="border-left: 6px solid var(--mud-palette-primary);">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Lang.Text("Total RHEO", "कुल RHEO")
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Primary">@_totRheo</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                </MudAvatar>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Registered Farmers -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="rounded-lg" Style="border-left: 6px solid var(--mud-palette-success);">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Lang.Text("Total Registered Farmers", "कुल पंजीकृत कृषक")
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Success">@_totRegFarmers</MudText>
                </div>
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.People" />
                </MudAvatar>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Backlog Farmers -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="rounded-lg" Style="border-left: 6px solid var(--mud-palette-warning);">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Lang.Text("Total Registered Backlog Farmers", "कुल पंजीकृत बैकलॉग कृषक")
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1" Color="Color.Warning">@_totRegBacklogFarmers</MudText>
                </div>
                <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" />
                </MudAvatar>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- ===================== CURRENT YEAR ===================== -->
<MudDivider Class="my-4" />
<MudText Typo="Typo.h6" Class="mb-3 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Tertiary" />
    @(_finyears.Count > 0 ? _finyears[0].FinancialYear : "")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Total Applications", "कुल आवेदन")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_currentYearDashboard.TotalApplications</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Info" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Lang.Text("Total Approved Farmers (RHEO)", "कुल स्वीकृत कृषक (RHEO)")
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_currentYearDashboard.TotalRheoApproved</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Total Approved Farmers (DDH)", "कुल स्वीकृत कृषक (DDH)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_currentYearDashboard.TotalDdhApproved</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Centrally Sponsored Scheme (Total Applications)", "केंद्र प्रवर्तित योजना (कुल आवेदन)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_currentYearDashboard.TotalCentralSponsored</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Class="rounded-lg">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("State-Sponsored Scheme (Total applications)", "राज्य पोषित योजना (कुल आवेदन)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_currentYearDashboard.TotalStateSponsored</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Secondary" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- ===================== PREVIOUS YEAR ===================== -->
<MudDivider Class="my-4" />
<MudText Typo="Typo.h6" Class="mb-3 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Default" />
    @(_finyears.Count > 0 ? _finyears[1].FinancialYear : "")
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="rounded-lg" Style="opacity: 0.9;">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Total Applications", "कुल आवेदन")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_previousYearDashboard.TotalApplications</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Info" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="rounded-lg" Style="opacity: 0.9;">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        @Lang.Text("Total Approved Farmers (RHEO)", "कुल स्वीकृत कृषक (RHEO)")
                    </MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_previousYearDashboard.TotalRheoApproved</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="rounded-lg" Style="opacity: 0.9;">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Total Approved Farmers (DDH)", "कुल स्वीकृत कृषक (DDH)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_previousYearDashboard.TotalDdhApproved</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="rounded-lg" Style="opacity: 0.9;">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("Centrally Sponsored Scheme (Total Applications)", "केंद्र प्रवर्तित योजना (कुल आवेदन)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_previousYearDashboard.TotalCentralSponsored</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="1" Class="rounded-lg" Style="opacity: 0.9;">
            <MudCardContent Class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@Lang.Text("State-Sponsored Scheme (Total applications)", "राज्य पोषित योजना (कुल आवेदन)")</MudText>
                    <MudText Typo="Typo.h4" Class="mt-1">@_previousYearDashboard.TotalStateSponsored</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Secondary" Size="Size.Large" />
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _totRheo;
    private int _totRegFarmers;
    private int _totRegBacklogFarmers;

    private List<FinancialYearDto> _finyears = [];

    private ApplicationDashboardDto _currentYearDashboard = new();
    private ApplicationDashboardDto _previousYearDashboard = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFinancialYearsAsync();

        if (_finyears.Count < 2)
        {
            Snackbar.Add(
                Lang.Text(
                    "At least two financial years are required.",
                    "कम से कम दो वित्तीय वर्ष आवश्यक हैं।"),
                Severity.Warning);

            return;
        }

        await LoadDashboardAsync();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
        {
            _finyears = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load financial years.",
                    "वित्त वर्ष लोड करने में विफल।"),
                Severity.Warning);
        }
    }

    private async Task LoadDashboardAsync()
    {
        // First financial year
        var currentFinYearId = _finyears[0].Id;

        // Second financial year
        var previousFinYearId = _finyears[1].Id;

        // Start all API calls together
        var rheoTask =
            DashboardService.GetTotRheoAsync();

        var farmersTask =
            DashboardService.GetTotRegFarmersCountAsync();

        var backlogTask =
            DashboardService.GetTotRegBacklogFarmersCountAsync(
                currentFinYearId.ToString());

        var applicationTask =
            DashboardService.GetApplicationDashboardAsync(
                currentFinYearId.ToString());

        var applicationTask2 =
            DashboardService.GetApplicationDashboardAsync(
                previousFinYearId.ToString());

        await Task.WhenAll(
            rheoTask,
            farmersTask,
            backlogTask,
            applicationTask,
            applicationTask2);

        // Get results
        var rheoResult = await rheoTask;
        var farmersResult = await farmersTask;
        var backlogResult = await backlogTask;
        var applicationResult = await applicationTask;
        var applicationResult2 = await applicationTask2;

        // RHEO
        if (rheoResult.IsSuccess && rheoResult.Data is not null)
        {
            _totRheo = rheoResult.Data.Count;
        }

        // Registered Farmers
        if (farmersResult.IsSuccess && farmersResult.Data is not null)
        {
            _totRegFarmers = farmersResult.Data.Count;
        }

        // Backlog Farmers
        if (backlogResult.IsSuccess && backlogResult.Data is not null)
        {
            _totRegBacklogFarmers = backlogResult.Data.Count;
        }

        // Current Financial Year
        if (applicationResult.IsSuccess && applicationResult.Data is not null)
        {
            _currentYearDashboard = applicationResult.Data;
        }

        // Previous Financial Year
        if (applicationResult2.IsSuccess && applicationResult2.Data is not null)
        {
            _previousYearDashboard = applicationResult2.Data;
        }
    }
}
