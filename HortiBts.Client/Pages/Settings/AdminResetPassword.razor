@page "/admin/reset-password"
@using HortiBts.Client.Services.Users
@using HortiBts.Shared.Dtos.Users
@attribute [Authorize(Roles = "Admin")]

@inject UsersApiService UsersApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>
    @Lang.Text("Reset Password", "रिसेट पासवर्ड")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Reset Password", "रिसेट पासवर्ड")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Select the user to reset the password.", "पासवर्ड रिसेट करने के लिए यूजर का चयन करें।")
</MudText>

<MudGrid Spacing="3" Class="mb-2">
    <MudItem xs="12" sm="6">
        <MudToggleGroup T="int" Value="_userType" ValueChanged="OnUserTypeChanged"
                        SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Outlined="true">

            <MudToggleItem T="int" Value="1" Text="@Lang.Text("District (ADH/DDH)", "जिला (ए.डी.एच/डी.डी.एच)")" />
            <MudToggleItem T="int" Value="8" Text="@Lang.Text("SHDO", "एस.एच.डी.ओ.")" />
            <MudToggleItem T="int" Value="3" Text="@Lang.Text("RHEO", "आर.एच.ई.ओ.")" />

        </MudToggleGroup>
    </MudItem>
</MudGrid>

<MudGrid Spacing="3" Class="mb-2">

    @if (_userType == 1)
    {
        <MudItem xs="12" sm="4">
            <MudSelect T="int?" @bind-Value="_selectedDistrictCode" Label="@Lang.Text("District", "जिला")"
                       Variant="Variant.Outlined" ToStringFunc="@GetDistrictName">

                @foreach (var d in _districtsUsers)
                {
                    <MudSelectItem T="int?" Value="@((int?)d.DistrictCode)">
                        @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    else
    {
        <MudItem xs="12" sm="4">
            <MudTextField T="string" @bind-Value="_userId" Label="@Lang.Text("User ID", "यूजर आईडी")" Variant="Variant.Outlined"
                          Immediate="true" />
        </MudItem>
    }

    <MudItem xs="12">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanReset || _isBusy)"
                   OnClick="ResetPasswordAsync">
            @if (_isBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            @Lang.Text("Reset Password", "रिसेट पासवर्ड")
        </MudButton>
    </MudItem>

</MudGrid>

@code {
    private List<DistrictUsersDto> _districtsUsers = [];
    private int? _selectedDistrictCode;
    private int _userType = 1; // default: District
    private string? _userId;
    private bool _isBusy;

    // District needs a selected district; SHDO/RHEO need a user id
    private bool CanReset => _userType == 1
        ? _selectedDistrictCode.HasValue
        : !string.IsNullOrWhiteSpace(_userId);

    protected override async Task OnInitializedAsync()
    {
        await LoadDistrictsUsersAsync();
    }

    private string GetDistrictName(int? code)
    {
        if (code is null) return string.Empty;

        var d = _districtsUsers.FirstOrDefault(x => x.DistrictCode == code);
        if (d is null) return code.ToString()!;

        return Lang.IsHindi ? d.DistrictNameHindi! : d.DistrictName!;
    }

    private void OnUserTypeChanged(int value)
    {
        _userType = value;
        _selectedDistrictCode = null;
        _userId = null;
    }

    private async Task LoadDistrictsUsersAsync()
    {

        var result = await UsersApiService.GetDistrictsUsersAsync(3, _userType);
        if (result.IsSuccess)
            _districtsUsers = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts users.", "जिले के यूजर लोड करने में विफल।"), Severity.Warning);
    }

    private string GetTargetDescription() => _userType == 1
     ? GetDistrictName(_selectedDistrictCode)
     : _userId!.Trim();

    private async Task ResetPasswordAsync()
    {
        if (!CanReset) return;

        var target = System.Net.WebUtility.HtmlEncode(GetTargetDescription());

        var question = Lang.Text(
            $"Are you sure you want to reset the password for <b>{target}</b>?",
            $"क्या आप वाकई <b>{target}</b> का पासवर्ड रिसेट करना चाहते हैं?");

        var note = Lang.Text(
            "Note: Recovery is not possible after reset.",
            "नोट: रिसेट के बाद रिकवरी संभव नहीं है।");

        var message = new MarkupString(
            $"<p>{question}</p><p style=\"color:var(--mud-palette-error); font-weight:600;\">{note}</p>");

        var confirmed = await DialogService.ShowMessageBoxAsync(
            title: Lang.Text("Confirm Password Reset", "पासवर्ड रिसेट की पुष्टि करें"),
            markupMessage: message,
            yesText: Lang.Text("Yes, Reset", "हाँ, रिसेट करें"),
            cancelText: Lang.Text("Cancel", "रद्द करें"),
            options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true });

        if (confirmed != true) return;

        _isBusy = true;
        try
        {
            if (_userType == 1)
            {
                var result = await UsersApiService.DistrictResetPasswordAsync(_selectedDistrictCode!.Value, 3, 1);

                if (!result.IsSuccess)
                {
                    Snackbar.Add(Lang.Text("Failed to reset password.", "पासवर्ड रिसेट करने में विफल।"), Severity.Error);
                    return;
                }

                Snackbar.Add(Lang.Text("Password reset successfully.", "पासवर्ड सफलतापूर्वक रिसेट हो गया।"), Severity.Success);
            }
            else if (_userType == 8)
            {
                if (!int.TryParse(_userId, out var shdoUserId))
                {
                    Snackbar.Add(Lang.Text("Invalid User ID.", "अमान्य यूजर आईडी।"), Severity.Warning);
                    return;
                }

                var result = await UsersApiService.ShdoResetPasswordAsync(shdoUserId, 1);

                if (!result.IsSuccess)
                {
                    Snackbar.Add(Lang.Text("Failed to reset password.", "पासवर्ड रिसेट करने में विफल।"), Severity.Error);
                    return;
                }

                Snackbar.Add(Lang.Text("Password reset successfully.", "पासवर्ड सफलतापूर्वक रिसेट हो गया।"), Severity.Success);
            }
            else if (_userType == 3)
            {
                if (!int.TryParse(_userId, out var rheoUserId))
                {
                    Snackbar.Add(Lang.Text("Invalid User ID.", "अमान्य यूजर आईडी।"), Severity.Warning);
                    return;
                }

                var result = await UsersApiService.RheoResetPasswordAsync(rheoUserId, 1);

                if (!result.IsSuccess)
                {
                    Snackbar.Add(Lang.Text("Failed to reset password.", "पासवर्ड रिसेट करने में विफल।"), Severity.Error);
                    return;
                }

                Snackbar.Add(Lang.Text("Password reset successfully.", "पासवर्ड सफलतापूर्वक रिसेट हो गया।"), Severity.Success);
            }
            else
            {
                Snackbar.Add(Lang.Text("Failed to reset password.", "पासवर्ड रिसेट करने में विफल।"), Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to reset password.", "पासवर्ड रिसेट करने में विफल।"), Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }
}