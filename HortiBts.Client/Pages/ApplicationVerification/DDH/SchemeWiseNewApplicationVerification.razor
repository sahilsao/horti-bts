@* @page "/district/schemewise-new-application-verification"
@attribute [Authorize(Roles = "District")]
@using HortiBts.Client.Services.ApplicationVerification.DDH
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Schemes
@using HortiBts.Shared.Dtos.ApplicationVerification.DDH
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Schemes

@inject FinancialYearsApiService FinancialYearsApiService
@inject SchemesApiService SchemesApiService
@inject SchemeWiseApplicationVerificationApiService SchemeWiseApplicationVerificationApiService
@inject ISnackbar Snackbar
@inject IUserContextService UserContextService

<PageTitle>@Lang.Text("Scheme Wise New Application Verification (2025-26 / 2026-27)", "योजनावार नविन आवेदन सत्यापन (2025-26 / 2026-27)")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Scheme Wise New Application Verification (2025-26 / 2026-27)", "योजनावार नविन आवेदन सत्यापन (2025-26 / 2026-27)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("View New Application details from scheme wise.", "योजनावार नविन आवेदन का विवरण देखें")
</MudText>

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" @bind-Value="_selectedSchemeTypeId" Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                   Variant="Variant.Outlined" Required="true">
           
            @foreach (var st in _schemesTypes)
            {
                <MudSelectItem T="int?" Value="@((int?)st.SchemeId)">
                    @st.SchemeTypeName

                    @if (!string.IsNullOrWhiteSpace(st.SchemeTypeNameEn))
                    {
                        <span> / @st.SchemeTypeNameEn</span>
                    }
                   
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करें")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Bordered="true" HeaderClass="report-header-row" Dense="true"
              Hover="true" Elevation="1" Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("Distwise Farmer Registration Report (Yearly)", "जिलावार रिपोर्ट उद्यानिकी कृषक पंजीयन रिपोर्ट (वार्षिक)")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => Lang.Text(x.DistrictNameEn!, x.DistrictNameEn!))">
                    @Lang.Text("District", "जिला")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.Target!)">
                    @Lang.Text("Target Count", "लक्ष्य (संख्या में)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.FarmerCount!)">
                    @Lang.Text("Farmer Count", "कृषक संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.SchemeCount!)">
                    @Lang.Text("Applications Count", "आवेदन संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.Area!)">@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.Subsidy!)">
                    @Lang.Text("Subsidy Amount", "अनुदान राशि")
                </MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("District", "जिला")">
                <MudLink
                    Href="@($"/reports/yearly/previous/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{_selectedFinancialYear!.Value}")"
                    Color="Color.Info">
                    @Lang.Text(context.DistrictNameEn!, context.DistrictNameHi!)
                </MudLink>
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Target Count", "लक्ष्य (संख्या में)")">@context.Target</MudTd>
            <MudTd DataLabel="@Lang.Text("Farmer Count", "कृषक संख्या")">@context.FarmerCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.SchemeCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")">
                @context.Area?.ToString("N2")</MudTd>
                <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.Subsidy?.ToString("N2")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
                <MudTd></MudTd>
                <MudTd><b>@_filteredReportData.Sum(x => x.Target ?? 0)</b></MudTd>
                <MudTd><b>@_filteredReportData.Sum(x => x.FarmerCount ?? 0)</b></MudTd>
                <MudTd><b>@_filteredReportData.Sum(x => x.SchemeCount ?? 0)</b></MudTd>
                <MudTd><b>@_filteredReportData.Sum(x => x.Area ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b>
                </MudTd>
                <MudTd><b>₹@_filteredReportData.Sum(x => x.Subsidy ?? 0).ToString("N2")</b></MudTd>
            </FooterContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    }

@code {

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private List<FinancialYearDto> _finyears = [];
    private List<SchemeTypeDto> _schemesTypes = new();
    private int? _selectedFinancialYear;
    private int? _selectedSchemeTypeId;

    private bool _isLoading = false;

    private List<SchemeWiseApplicationsListDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserContextService.GetCurrentUserAsync();
        await LoadFinancialYearsAsync();
        await LoadSchemeTypes();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(2).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadSchemeTypes()
    {
        var schemeTypesTask = await SchemesApiService.GetSchemesTypesAsync();
        if (schemeTypesTask.IsSuccess && schemeTypesTask.Data is not null)
        {
            _schemesTypes = schemeTypesTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadReport()
    {
        
        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            int _selectedDistrictCode = int.Parse(_currentUser.UserId);
            var result =
                await SchemeWiseApplicationVerificationApiService
                    .GetSchemeWiseDistrictApplicationsAsync(
                        _selectedFinancialYear!.Value,
                        _selectedDistrictCode,
                        _selectedSchemeTypeId!.Value);

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    if (result.Data.Any())
                    {
                        _reportData = result.Data;
                    }
                    else
                    {
                        _reportData = [];
                        Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                    }
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedSchemeTypeId = null;
    }

    private IEnumerable<DistWiseFarmerRegistrationDto> _filteredReportData =>
    _reportData.Where(t =>
    string.IsNullOrWhiteSpace(_searchString)
    || (t.DistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.Target?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.FarmerCount?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.SchemeCount?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.Subsidy?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.Area?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ExcelColumn<DistWiseFarmerRegistrationDto>> GetColumns() => new()
    {
        new() { HeaderEn = "District", HeaderHi = "जिला",
                ValueSelector = x => Lang.Text(x.DistrictNameEn!, x.DistrictNameHi!) },
        new() { HeaderEn = "Target Count", HeaderHi = "लक्ष्य (संख्या में)",
                ValueSelector = x => x.Target ?? 0,
                TotalSelector = list => list.Sum(x => x.Target ?? 0) },
        new() { HeaderEn = "Farmer Count", HeaderHi = "कृषक संख्या",
                ValueSelector = x => x.FarmerCount ?? 0,
                TotalSelector = list => list.Sum(x => x.FarmerCount ?? 0) },
        new() { HeaderEn = "Applications Count", HeaderHi = "आवेदन संख्या",
                ValueSelector = x => x.SchemeCount ?? 0,
                TotalSelector = list => list.Sum(x => x.SchemeCount ?? 0) },
        new() { HeaderEn = "Target Area (Hectares)", HeaderHi = "लक्षित रकबा (हेक्टेयर में)",
                ValueSelector = x => x.Area ?? 0,
                TotalSelector = list => list.Sum(x => x.Area ?? 0) },
        new() { HeaderEn = "Subsidy Amount", HeaderHi = "अनुदान राशि",
                ValueSelector = x => x.Subsidy ?? 0,
                TotalSelector = list => list.Sum(x => x.Subsidy ?? 0) },
    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("District-Wise Farmer Registration Report (Yearly)", "जिलावार कृषक पंजीयन रिपोर्ट (वार्षिक)"),
            (en, hi) => Lang.Text(en, hi),
            $"DistrictWise_FarmerRegistrationReport_{finYear}.xlsx");
    }
} *@
