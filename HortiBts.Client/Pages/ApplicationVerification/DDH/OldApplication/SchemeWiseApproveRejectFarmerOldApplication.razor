@page "/district/approve-reject-farmer-old-application/{HfId:int}/{FdId:int}/{SdId:int}/{VillageType}/{FinancialYear:int}"
@using HortiBts.Client.Services.ApplicationVerification.DDH.OldApplication
@using HortiBts.Client.Services.Farmers
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Soil
@using HortiBts.Shared.Dtos.ApplicationVerification.OldFarmersApplication
@using HortiBts.Shared.Models.Soil
@using Microsoft.AspNetCore.Components.Web

@inject FarmersDetailsApiService FarmersDetailsApiService
@inject SoilDetailsApiService SoilDetailsApiService
@inject FinancialYearsApiService FinancialYearApiService

@* @inject ApproveRejectFarmerApplicationByDDHApiService ApproveRejectFarmerApplicationByDDHApiService *@
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>@Lang.Text("Application Verification", "आवेदन सत्यापन")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Application Verification", "आवेदन सत्यापन")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Verification of applications on the Horticulture Farmers Portal to avail benefits under Central or State Government horticulture schemes.", "उद्यानिकी कृषक पोर्टल पर केन्द्रीय अथवा राज्य सरकार की उद्यानिकी योजना से लाभ प्राप्त करने हेतु आवेदन पत्र का सत्यापन।")
</MudText>

<MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0"
          Style="border:1px dashed var(--mud-palette-lines-default); border-radius:12px;">
    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Class="mud-text-secondary mb-2" />
    <MudText Typo="Typo.body1" Class="mud-text-secondary">
        @Lang.Text("Note: The farmer/entrepreneur details provided below must be verified by the official. The official may approve the application after verifying all the information. It may be rejected if the information is found to be incorrect. Providing the reason for approval or rejection in the remarks field is mandatory.", "नोट: नीचे दिये गए कृषक/उद्यमी विवरण का अधिकारी द्वारा सत्यापन किया जाना है। सभी जानकारी सत्यापित करने के पश्चात अधिकारी इस आवेदन को अप्रूव कर सकते है। जानकारी सही नही होने की स्थिति मे निरस्त किया जा सकता है। रिमार्क फील्ड मे अप्रूव या निरस्त करने का कारण बताना अनिवार्य है।")
    </MudText>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
    @* ---------- Basic Details Result ---------- *@
    @if (_farmerBasicDetails.Any())
    {
        
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Basic Details", "आधारभूत जानकारी")</strong>
        </MudText>
            
        <MudTable Items="_farmerBasicDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>@Lang.Text("UFID", "यु.एफ.आईडी")</MudTh>
                <MudTh>@Lang.Text("Name (English)", "नाम (अंग्रेजी)")</MudTh>
                <MudTh>@Lang.Text("Name (Hindi)", "नाम (हिंदी)")</MudTh>
                <MudTh>@Lang.Text("Father/Mother/Spouse", "पिता/माता/पति")</MudTh>
                <MudTh>@Lang.Text("Gender", "लिंग")</MudTh>
                <MudTh>@Lang.Text("Mobile Number 1", "मोबाइल नंबर 1")</MudTh>
                <MudTh>@Lang.Text("Mobile Number 2", "मोबाइल नंबर 2")</MudTh>
                <MudTh>@Lang.Text("Date of Birth", "जन्म तिथि")</MudTh>
                <MudTh>@Lang.Text("Caste", "वर्ग")</MudTh>
                <MudTh>@Lang.Text("Subcaste", "विशेष जनजाति")</MudTh>
                <MudTh>@Lang.Text("Membership No", "सदस्यता क्रमांक")</MudTh>
            </HeaderContent>
            <RowTemplate Context="b">
                <MudTd DataLabel="@Lang.Text("UFID", "यु.एफ.आईडी")">@b.UfId</MudTd>
                <MudTd DataLabel="@Lang.Text("Name (English)", "नाम (अंग्रेजी)")">@b.FarmerNameEng</MudTd>
                <MudTd DataLabel="@Lang.Text("Name (Hindi)", "नाम (हिंदी)")">@b.FarmerNameHi</MudTd>
                <MudTd DataLabel="@Lang.Text("Father/Mother/Spouse", "पिता/माता/पति")">@Or(b.FatherName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Gender", "लिंग")">@GenderLabel(b.Gender)</MudTd>
                <MudTd DataLabel="@Lang.Text("Mobile Number 1", "मोबाइल नंबर 1")">@Or(b.MobileNo)</MudTd>
                <MudTd DataLabel="@Lang.Text("Mobile Number 2", "मोबाइल नंबर 2")">@Or(b.MobileNo)</MudTd>
                <MudTd DataLabel="@Lang.Text("Date of Birth", "जन्म तिथि")">@Or(b.Dob?.ToString("dd/MM/yyyy"))</MudTd>
                <MudTd DataLabel="@Lang.Text("Caste", "वर्ग")">@Or(b.Category)</MudTd>
                <MudTd DataLabel="@Lang.Text("Subcaste", "विशेष जनजाति")">@Or(b.Subcategory)</MudTd>
                <MudTd DataLabel="@Lang.Text("Membership No", "सदस्यता क्रमांक")">@Or(b.MembershipNo)</MudTd>
            </RowTemplate>
        </MudTable>
       
    }

    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-6">
            @Lang.Text("No Personal Details Available.", "कोई व्यक्तिगत विवरण उपलब्ध नहीं है।")
        </MudAlert>
    }

    @* ---------- Basic Address Result ---------- *@
    @if (_farmerAddressDetails.Any())
    {
        
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Address Details", "पता विवरण")</strong>
        </MudText>
            
        <MudTable Items="_farmerAddressDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>                
                <MudTh>@Lang.Text("District", "जिला")</MudTh>
                <MudTh>@Lang.Text("Block", "विकासखण्ड")</MudTh>
                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                <MudTh>@Lang.Text("Address", "पता")</MudTh>
            </HeaderContent>
            <RowTemplate Context="a">
                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_farmerAddressDetails.IndexOf(a) + 1)</MudTd>
                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(a.DistrictName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Block", "विकासखण्ड")">@Or(a.SubdistrictName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(a.VillageName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Address", "पता")">@FormatAddress(a)</MudTd>
            </RowTemplate>
        </MudTable>
       
    }

    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-6">
            @Lang.Text("No Address Details Available.", "कोई पता विवरण उपलब्ध नहीं है।")
        </MudAlert>
    }

    @* ---------- Bank Details Result ---------- *@
    @if (_farmerBankDetails.Any())
    {
        
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Bank Details", "बैंक विवरण")</strong></MudText>
            
        <MudTable Items="_farmerBankDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh>@Lang.Text("Account No.", "खाता क्रमांक")</MudTh>
                <MudTh>@Lang.Text("IFSC Code", "आई.एफ.एस.सी. कोड")</MudTh>
                <MudTh>@Lang.Text("Branch", "शाखा")</MudTh>
                <MudTh>@Lang.Text("Bank", "बैंक")</MudTh>
                <MudTh>@Lang.Text("District", "जिला")</MudTh>
                <MudTh>@Lang.Text("State", "राज्य")</MudTh>
            </HeaderContent>
            <RowTemplate Context="bnk">
                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_farmerBankDetails.IndexOf(bnk) + 1)</MudTd>
                <MudTd DataLabel="@Lang.Text("Account No.", "खाता क्रमांक")">@Or(bnk.AccountNo)</MudTd>
                <MudTd DataLabel="@Lang.Text("IFSC Code", "आई.एफ.एस.सी. कोड")">@Or(bnk.IfscCode)</MudTd>
                <MudTd DataLabel="@Lang.Text("Branch", "शाखा")">@Or(bnk.BranchName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Bank", "बैंक")">@Or(bnk.BankName)</MudTd>
                <MudTd DataLabel="@Lang.Text("District", "जिला")">@Or(bnk.BankDistrict.ToString())</MudTd>
                <MudTd DataLabel="@Lang.Text("State", "राज्य")">@StateLabel(bnk.BankState.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
       
    }

    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-6">
            @Lang.Text("No Bank Details Available.", "कोई बैंक विवरण उपलब्ध नहीं है।")
        </MudAlert>
    }
 

    @if (_farmerLandDetails.Any())
    {
        @* ---------- Land Details Result ---------- *@
        
        <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Land Details", "भूमि विवरण")</strong>
            @Lang.Text(
                "(Information regarding the farmer's land obtained from the Bhuiyan portal. These details pertain only to the land in the village for which the application was made.)",
                "(भुइयाँ पोर्टल से प्राप्त किसान के भूमि की जानकारी। यह विवरण केवल आवेदन किये गए भूमि ग्राम का है।)")
        </MudText>
            
        <MudTable Items="_farmerLandDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                <MudTh>@Lang.Text("Irrigated/Unirrigated", "सिंचित/असिंचित")</MudTh>
                <MudTh>@Lang.Text("Kafiyat", "कैफियेत")</MudTh>
                <MudTh>@Lang.Text("Loan Book Number", "ऋण पुस्तिका क्रमांक")</MudTh>
                <MudTh>@Lang.Text("Land Owner Type", "भू-स्वामी प्रकार")</MudTh>
                <MudTh>@Lang.Text("Patwari Halka Number", "पटवारी हल्का क्रमांक")</MudTh>
                <MudTh>@Lang.Text("Khasra No.", "खसरा क्रमांक")</MudTh>
                <MudTh>@Lang.Text("Area (in hectares)", "रकबा (हेक्टेयर में)")</MudTh>
                <MudTh>@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")</MudTh>
                <MudTh>@Lang.Text("Verified against land records", "भू-अभिलेख से सत्यापित")</MudTh>
            </HeaderContent>
            <RowTemplate Context="l">
                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_farmerLandDetails.IndexOf(l) + 1)</MudTd>
                <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(l.VillageName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Irrigated/Unirrigated", "सिंचित/असिंचित")">@Or(l.SinchitAsinchit)</MudTd>
                <MudTd DataLabel="@Lang.Text("Kafiyat", "कैफियेत")">@Or(l.SichaiName)</MudTd>
                <MudTd DataLabel="@Lang.Text("Loan Book Number", "ऋण पुस्तिका क्रमांक")">@Or(l.BookletNo)</MudTd>
                <MudTd DataLabel="@Lang.Text("Land Owner Type", "भू-स्वामी प्रकार")">@Or(l.Ownertype)</MudTd>
                <MudTd DataLabel="@Lang.Text("Patwari Halka Number", "पटवारी हल्का क्रमांक")">
                    @Or(l.PatwariHalka.ToString())
                    </MudTd>
                    <MudTd DataLabel="@Lang.Text("Khasra No.", "खसरा क्रमांक")">@Or(l.KhasraNo)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Area (in hectares)", "रकबा (हेक्टेयर में)")">@l.Area?.ToString("N2")
                    </MudTd>
                       <MudTd DataLabel="@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")"> @((l.Area * 2.47105m)?.ToString("N4"))
                    </MudTd>
                    <MudTd DataLabel="@Lang.Text("Verified against land records", "भू-अभिलेख से सत्यापित")"> @Or(l.IsVerified) </MudTd>
                </RowTemplate>
                 <FooterContent>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                     <MudTd>@Lang.Text("Total","योग")</MudTd>
                    <MudTd>@_farmerLandDetails.Sum(x => x.Area)</MudTd>
                    <MudTd>@_farmerLandDetails.Sum(x => (x.Area * 2.47105m))</MudTd>
                    <MudTd></MudTd>
                </FooterContent>
            </MudTable>           
        }

    else
        {
            <MudAlert Severity="Severity.Info" Class="mt-6">
                @Lang.Text("No Land Details Available.", "कोई भूमि विवरण उपलब्ध नहीं है।")
            </MudAlert>
        }

       
        @if (_farmerSchemeDetails.Any())
        {
            @* ---------- Scheme Details Result ---------- *@
            
            <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Scheme and Component Details", "योजना एवं घटक विवरण")</strong>
           @Lang.Text("Details of benefits availed by the farmer under government schemes.","कृषक द्वारा शासकीय योजना द्वारा लिए जाने वाले लाभ का विवरण।")
           </MudText>
            <MudTable Items="@_farmerSchemeDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                    <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>
                    <MudTh>@Lang.Text("Scheme Type", "योजना का प्रकार")</MudTh>
                    <MudTh>@Lang.Text("Scheme Name", "योजना का नाम")</MudTh>
                    <MudTh>@Lang.Text("Component Name", "घटक")</MudTh>
                    <MudTh>@Lang.Text("Khasra No", "खसरा क्रमांक")</MudTh>
                    <MudTh>@Lang.Text("Area (selected area in hectares)", "रकबा (चयनित रकबा हेक्टेयर में)")</MudTh>
                    <MudTh>@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")</MudTh>
                    <MudTh>@Lang.Text("Number (optional)", "संख्या (वैकल्पिक)")</MudTh>
                </HeaderContent>
                <RowTemplate Context="s">
                    <MudTd DataLabel=@Lang.Text("S.No.", "क्रमाँक")>@(_farmerSchemeDetails.IndexOf(s) + 1)</MudTd>
                    <MudTd DataLabel=@Lang.Text("Village", "ग्राम")>@s.VillageName</MudTd>
                    <MudTd DataLabel=@Lang.Text("Scheme Type", "योजना का प्रकार")>@s.SchemeTypeName</MudTd>
                    <MudTd DataLabel=@Lang.Text("Scheme Name", "योजना का नाम")>@s.SchemeName</MudTd>
                    <MudTd DataLabel=@Lang.Text("Component Name", "घटक")>@s.Cname</MudTd>
                    <MudTd DataLabel=@Lang.Text("Khasra No", "खसरा क्रमांक")>@s.KhasraNo</MudTd>
                    <MudTd DataLabel=@Lang.Text("Area (selected area in hectares)", "रकबा (चयनित रकबा हेक्टेयर में)")>@s.Area?.ToString("N2")</MudTd>
                    <MudTd DataLabel=@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")>@((s.Area * 2.47105m)?.ToString("N4"))</MudTd>
                    <MudTd DataLabel=@Lang.Text("Number (optional)", "संख्या (वैकल्पिक)")>@s.Quantity</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                     <MudTd>@Lang.Text("Total","योग")</MudTd>
                    <MudTd>@_farmerSchemeDetails.Sum(x => x.Area)</MudTd>
                    <MudTd>@_farmerSchemeDetails.Sum(x => (x.Area * 2.47105m))</MudTd>
                    <MudTd></MudTd>
                </FooterContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 5, 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
           
        }

        else
        {
            <MudAlert Severity="Severity.Info" Class="mt-6">
                @Lang.Text("No Land Details Available.", "कोई भूमि विवरण उपलब्ध नहीं है।")
            </MudAlert>
        }

        @if (_farmerCropDetails.Any())
        {
            @* ---------- Crop Details Result ---------- *@
            
            <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Crop Details", "फसल विवरण")</strong></MudText>
                
            
            <MudTable Items="_farmerCropDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>  
                    <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>                  
                    <MudTh>@Lang.Text("Season", "मौसम")</MudTh>
                    <MudTh>@Lang.Text("Crop Type", "फसल का प्रकार")</MudTh>
                    <MudTh>@Lang.Text("Crop Name", "फसल का नाम")</MudTh>
                    <MudTh>@Lang.Text("Variety", "किस्म")</MudTh>
                    <MudTh>@Lang.Text("Khasra No.", "खसरा क्रमांक")</MudTh>
                    <MudTh>@Lang.Text("Area (in hectares)", "रकबा (हेक्टेयर में)")</MudTh>
                    <MudTh>@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")</MudTh>
                    <MudTh>@Lang.Text("Combined Khasra", "संयुक्त खसरा")</MudTh>
                    <MudTh>@Lang.Text("Seed Production", "बीज उत्पादन")</MudTh>
                </HeaderContent>
                <RowTemplate Context="c">
                    <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_farmerCropDetails.IndexOf(c) + 1)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(c.VillageName)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Season", "मौसम")">@Or(c.CropSeason.ToString())</MudTd>
                    <MudTd DataLabel="@Lang.Text("Crop Type", "फसल का प्रकार")">@Or(c.SubCropCategoryName)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Crop Name", "फसल का नाम")">@Or(c.CropName)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Variety", "किस्म")">@Or(c.CropVariety)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Khasra No.", "खसरा क्रमांक")">@Or(c.KhasraNo)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Area (in hectares)", "रकबा (हेक्टेयर में)")">@Or(c.CropArea?.ToString("N2"))</MudTd>
                    <MudTd DataLabel="@Lang.Text("Area (in acres)", "रकबा (एकड़ में)")">@Or((c.CropArea * 2.47105m)?.ToString("N4"))</MudTd>
                    <MudTd DataLabel="@Lang.Text("Seed Production", "बीज उत्पादन")">@Or(c.IsSeed?.ToString())</MudTd>
                </RowTemplate>
                 <FooterContent>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                     <MudTd>@Lang.Text("Total","योग")</MudTd>
                    <MudTd>@_farmerCropDetails.Sum(x => x.CropArea)</MudTd>
                    <MudTd>@_farmerCropDetails.Sum(x => (x.CropArea * 2.47105m))</MudTd>
                    <MudTd></MudTd>
                </FooterContent>
            </MudTable>
           
        }

        else
        {
            <MudAlert Severity="Severity.Info" Class="mt-6">
                @Lang.Text("No Crop Details Available.", "कोई फसल विवरण उपलब्ध नहीं है।")
            </MudAlert>
        }


        @if (_farmerMachineryDetails.Any())
        {
            @* ---------- Machinery Details Result ---------- *@
            
            <MudText Typo="Typo.subtitle1" Class="pa-4 pb-0"><strong>@Lang.Text("Machinery Details", "उपकरण विवरण")</strong>                
            @Lang.Text("(Equipment available to the farmer through self-purchase.)","(कृषक के पास स्वयं के क्रय से उपलब्ध उपकरण।)")
            </MudText>
            <MudTable Items="_farmerMachineryDetails" Hover="true" Dense="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>  
                    <MudTh>@Lang.Text("Village", "ग्राम")</MudTh>                  
                    <MudTh>@Lang.Text("Machinery", "उपकरण")</MudTh>
                    <MudTh>@Lang.Text("Machinery Type", "उपकरण का प्रकार")</MudTh>
                    <MudTh>@Lang.Text("Number", "संख्या")</MudTh>
                </HeaderContent>
                <RowTemplate Context="m">
                    <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_farmerMachineryDetails.IndexOf(m) + 1)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@Or(m.VillageName)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Machinery", "उपकरण")">@Or(m.MachineryName)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Machinery Type", "उपकरण का प्रकार")">@Or(m.MachineryCategory)</MudTd>
                    <MudTd DataLabel="@Lang.Text("Number", "संख्या")">@Or(m.Quantity.ToString())</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                     <MudTd>@Lang.Text("Total","योग")</MudTd>
                    <MudTd>@_farmerMachineryDetails.Sum(x => x.Quantity)</MudTd>
                </FooterContent>
            </MudTable>           
        }

        else
        {
            <MudAlert Severity="Severity.Info" Class="mt-6">
                @Lang.Text("No Machinery Details Available.", "कोई उपकरण विवरण उपलब्ध नहीं है।")
            </MudAlert>
        }

        <MudTextField T="string" Class="mt-4" @bind-Value="_remarks" Label="@Lang.Text("Remarks", "टिप्पणी")"
                      Placeholder="@Lang.Text("Enter remarks", "टिप्पणी दर्ज करें")" Variant="Variant.Outlined" Lines="4" FullWidth="true"
                      Margin="Margin.Dense" />

        <MudStack Row="true" Spacing="2" Class="mt-3">

            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                       OnClick="ConfirmApproveAsync">
                @Lang.Text("Approve", "स्वीकृत करें")
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close"
                       OnClick="ConfirmRejectAsync">
                @Lang.Text("Reject", "अस्वीकृत करें")
            </MudButton>

            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="CloseAsync">
                @Lang.Text("Close", "बंद करें")
            </MudButton>

        </MudStack>
    }
    
@code {
    private int _searchHfId { get; set; }
    private int _searchFdId { get; set; }
    private int _searchSdId { get; set; }
    private string? _searchVillageType { get; set; }
    private int _searchFy { get; set; }
    private List<OldFarmerApplicationBasicDetailsDto> _farmerBasicDetails = new();
    private List<OldFarmerApplicationAddressDetailsDto> _farmerAddressDetails = new();
    private List<OldFarmerApplicationBankDetailsDto> _farmerBankDetails = new();
    private List<OldFarmerApplicationLandDetailsDto> _farmerLandDetails = new();
    private List<OldFarmerApplicationSchemeDetailsDto> _farmerSchemeDetails = new();
    private List<OldFarmerApplicationCropDetailsDto> _farmerCropDetails = new();
    private List<OldFarmerApplicationMachineryDetailsDto> _farmerMachineryDetails = new();
    private bool _isLoading;
    private string _remarks = string.Empty;


    [Parameter]
    public int HfId { get; set; }
    
    [Parameter]
    public int FdId { get; set; }

    [Parameter]
    public int SdId { get; set; }

    [Parameter]
    public string? VillageType { get; set; }
    
    [Parameter]
    public int FinancialYear { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HfId > 0 && FdId > 0)
        {
            _searchHfId = HfId;
            _searchFdId = FdId;
            _searchSdId = SdId;
            _searchVillageType = VillageType;
            _searchFy = FinancialYear;
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (_searchHfId <= 0 && _searchFdId <= 0 && _searchSdId <= 0 && _searchFy <= 0)
            return;

        _isLoading = true;
        _farmerBasicDetails = new();
        _farmerAddressDetails = new();
        _farmerBankDetails = new();
        _farmerLandDetails = new();
        _farmerSchemeDetails = new();
        _farmerCropDetails = new();
        _farmerMachineryDetails = new();

        try
        {
            var resultBasicDetails =
            await FarmersDetailsApiService.GetFarmersBasicDetailsByHfIdAsync(_searchHfId);

            var resultAddressDetails =
            await FarmersDetailsApiService.GetFarmersAddressDetailsByFdIdAsync(_searchFdId);

            var resultBankDetails =
            await FarmersDetailsApiService.GetFarmersBankDetailsByFdIdAsync(_searchFdId);

            var resultLandDetails =
            await FarmersDetailsApiService.GetFarmersLandDetailsByFdIdAsync(_searchFdId,_searchVillageType!,_searchFy);            
            
            var resultSchemeDetails =
            await FarmersDetailsApiService.GetFarmersSchemeDetailsByFdIdAsync(_searchFdId, _searchSdId,_searchFy);

            var resultCropDetails =
            await FarmersDetailsApiService.GetFarmersCropDetailsByFdIdAsync(_searchFdId,_searchFy);

            var resultMachineryDetails =
            await FarmersDetailsApiService.GetFarmersMachineryDetailsByFdIdAsync(_searchFdId,_searchFy);

            if (resultBasicDetails.IsSuccess && resultBasicDetails.Data is not null && resultBasicDetails.Data.Any())
            {
                _farmerBasicDetails = resultBasicDetails.Data;
            }

            if (resultAddressDetails.IsSuccess && resultAddressDetails.Data is not null && resultAddressDetails.Data.Any())
            {
                _farmerAddressDetails = resultAddressDetails.Data;
            }

            if (resultBankDetails.IsSuccess && resultBankDetails.Data is not null && resultBankDetails.Data.Any())
            {
                _farmerBankDetails = resultBankDetails.Data;
            }

            if (resultLandDetails.IsSuccess && resultLandDetails.Data is not null && resultLandDetails.Data.Any())
            {
                _farmerLandDetails = resultLandDetails.Data;
            }
            
            if (resultSchemeDetails.IsSuccess && resultSchemeDetails.Data is not null && resultSchemeDetails.Data.Any())
            {
                _farmerSchemeDetails = resultSchemeDetails.Data;
            }  

            if (resultCropDetails.IsSuccess && resultCropDetails.Data is not null && resultCropDetails.Data.Any())
            {
                _farmerCropDetails = resultCropDetails.Data;
            }

            if (resultMachineryDetails.IsSuccess && resultMachineryDetails.Data is not null && resultMachineryDetails.Data.Any())
            {
                _farmerMachineryDetails = resultMachineryDetails.Data;
            }
            
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Reset()
    {
        _searchHfId = 0;
        _searchSdId = 0;
        _searchFdId = 0;
        _searchVillageType = "";
        _searchFy = 0;
        _farmerBasicDetails = new();
        _farmerAddressDetails = new();
        _farmerBankDetails = new();
        _farmerLandDetails = new();
        _farmerSchemeDetails = new();
        _farmerCropDetails = new();
        _farmerMachineryDetails = new();
    }

    private async Task OnSearchBoxKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private string GenderLabel(string? gender) => gender switch
    {
        "M" => @Lang.Text("Male", "पुरुष"),
        "F" => @Lang.Text("Female", "महिला"),
        "T" => @Lang.Text("Transgender", "ट्रांसजेंडर"),
        _ => "-"
    };

    private string Or(string? value)
    => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatAddress(OldFarmerApplicationAddressDetailsDto a)
    => $"मकान संख्या/गली : {a.HouseNo}, वार्ड संख्या : {a.WardNo}, {a.Address}, पिनकोड: {a.Pincode}";

    private string StateLabel(string? stateName)
    => string.IsNullOrWhiteSpace(stateName) ? Lang.Text("Chhattisgarh", "छत्तीसगढ़") : stateName;

