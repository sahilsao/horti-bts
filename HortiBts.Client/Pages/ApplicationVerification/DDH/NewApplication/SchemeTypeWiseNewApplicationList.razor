@page "/district/scheme-type-wise-new-application-list"
@attribute [Authorize(Roles = "District")]
@using HortiBts.Client.Services.ApplicationVerification.DDH.NewApplication
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Schemes
@using HortiBts.Shared.Dtos.ApplicationVerification.DDH.NewApplication
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Schemes

@inject FinancialYearsApiService FinancialYearsApiService
@inject SchemesApiService SchemesApiService
@inject SchemeTypeWiseNewApplicationVerificationApiService SchemeTypeWiseNewApplicationVerificationApiService
@inject ISnackbar Snackbar
@inject IUserContextService UserContextService
@inject ExcelExportService ExcelExport

<PageTitle>@Lang.Text("Scheme Wise New Application List (2025-26 / 2026-27)", "योजनावार नविन आवेदन सूची (2025-26 / 2026-27)")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.DomainVerification" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Scheme Wise New Application Verification List (2025-26 / 2026-27)", "योजनावार नविन आवेदन सूची (2025-26 / 2026-27)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("View New Application details from scheme wise for verification.", "सत्यापन हेतु योजनावार नविन आवेदन का विवरण देखें")
</MudText>

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" @bind-Value="_selectedSchemeTypeId" Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                   Variant="Variant.Outlined" Required="true">
           
            @foreach (var st in _schemesTypes)
            {
                <MudSelectItem T="int?" Value="@((int?)st.SchemeId)">
                    @st.SchemeTypeName

                    @if (!string.IsNullOrWhiteSpace(st.SchemeTypeNameEn))
                    {
                        <span> / @st.SchemeTypeNameEn</span>
                    }
                   
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करें")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudText Typo="Typo.body2" Class="mt-4">@Lang.Text("Note: The table displays the number of applications scheme-wise. Only applications approved by the RHEO can be approved by the DDH.", "नोट: तालिका मे योजनावार आवेदनों की संख्या दिखाया जा रहा है। RHEO द्वारा स्वीकृत आवेदनों को ही DDH द्वारा स्वीकृत किया जा सकता है।")</MudText>
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Bordered="true" HeaderClass="report-header-row" Dense="true"
              CustomHeader="true" Hover="true" Elevation="1" Class="mt-4">
        <ToolBarContent>
            <MudStack Row="false" Spacing="0">
                <MudText Typo="Typo.h6">
                    @_schemesTypes.FirstOrDefault(x => x.SchemeId == _selectedSchemeTypeId)?.SchemeTypeName
                    (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
                </MudText>
                <MudText Typo="Typo.body2">@Lang.Text("Number of applications received scheme-wise", "योजनावार प्राप्त आवेदनों की संख्या")</MudText>
            </MudStack>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTHeadRow Class="report-header-row">
                <MudTh ColSpan="3"></MudTh>
                <MudTh ColSpan="3">RHEO</MudTh>
                <MudTh ColSpan="3">DDH</MudTh>
                <MudTh></MudTh>
            </MudTHeadRow>
            <MudTHeadRow Class="report-header-row">
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.SchemeName!)">
                        @Lang.Text("Scheme", "योजना")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.TotalApplications!)">
                        @Lang.Text("Applications Count", "आवेदनों की संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.RheoPending!)">
                        @Lang.Text("Pending", "लंबित")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.RheoApproved!)">
                        @Lang.Text("Approved", "स्वीकृत")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.RheoRejected!)">
                        @Lang.Text("Rejected", "अस्वीकृत")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.DdhPending!)">
                        @Lang.Text("Pending", "लंबित")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.DdhApproved!)">
                        @Lang.Text("Approved", "स्वीकृत")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SchemeTypeWiseNewApplicationsListDto, object>(x => x.DdhRejected!)">
                        @Lang.Text("Rejected", "अस्वीकृत")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>@Lang.Text("Action", "एक्शन")</MudTh>
            </MudTHeadRow>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("Scheme", "योजना")">
                @context.SchemeName
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदनों की संख्या")">@context.TotalApplications</MudTd>
            <MudTd DataLabel="@Lang.Text("Pending", "लंबित")">@context.RheoPending</MudTd>
            <MudTd DataLabel="@Lang.Text("Approved", "स्वीकृत")">@context.RheoApproved</MudTd>
            <MudTd DataLabel="@Lang.Text("Rejected", "अस्वीकृत")">@context.RheoRejected</MudTd>
            <MudTd DataLabel="@Lang.Text("Pending", "लंबित")">@context.DdhPending</MudTd>
            <MudTd DataLabel="@Lang.Text("Approved", "स्वीकृत")">@context.DdhApproved</MudTd>
            <MudTd DataLabel="@Lang.Text("Rejected", "अस्वीकृत")">@context.DdhRejected</MudTd>
            <MudTd DataLabel="@Lang.Text("Action", "एक्शन")">
                @if (context.DdhPending > 0)
                {
                    <MudTooltip Text="@Lang.Text("View Applications", "आवेदन देखें")">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small"
                                       Href="@($"/district/scheme-wise-new-application-beneficiary-list/{context.SchemeTypeId}/{context.SchemeId}/{_currentUser.UserId}/{_selectedFinancialYear}")" />
                    </MudTooltip>
                }
                else
                {
                    <MudText>-</MudText>
                }
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalApplications ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.RheoPending ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.RheoApproved ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.RheoRejected ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.DdhPending ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.DdhApproved ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.DdhRejected ?? 0)</b></MudTd>
            <MudTd></MudTd>
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private List<FinancialYearDto> _finyears = [];
    private List<SchemeTypeDto> _schemesTypes = new();
    private int? _selectedFinancialYear;
    private int? _selectedSchemeTypeId;

    private bool _isLoading = false;

    private List<SchemeTypeWiseNewApplicationsListDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserContextService.GetCurrentUserAsync();
        await LoadFinancialYearsAsync();
        await LoadSchemeTypes();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(2).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadSchemeTypes()
    {
        var schemeTypesTask = await SchemesApiService.GetSchemesTypesAsync();
        if (schemeTypesTask.IsSuccess && schemeTypesTask.Data is not null)
        {
            _schemesTypes = schemeTypesTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadReport()
    {
        
        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            int _selectedDistrictCode = int.Parse(_currentUser.UserId);
            var result =
                await SchemeTypeWiseNewApplicationVerificationApiService
                    .GetSchemeTypeWiseNewDistrictApplicationsAsync(
                        _selectedSchemeTypeId!.Value,
                        _selectedDistrictCode,
                        _selectedFinancialYear!.Value
                      );

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    _reportData = result.Data;
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedSchemeTypeId = null;
    }

    private IEnumerable<SchemeTypeWiseNewApplicationsListDto> _filteredReportData =>
    _reportData.Where(t =>
    string.IsNullOrWhiteSpace(_searchString)
    || (t.SchemeName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalApplications?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.RheoPending?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.RheoApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.RheoRejected?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DdhPending?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DdhApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DdhRejected?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ExcelColumn<SchemeTypeWiseNewApplicationsListDto>> GetColumns() => new()
    {
        new() { HeaderEn = "Scheme", HeaderHi = "योजना",
                ValueSelector = x => x.SchemeName! },
        new() { HeaderEn = "Applications Count", HeaderHi = "आवेदनों की संख्या",
                ValueSelector = x => x.TotalApplications ?? 0,
                TotalSelector = list => list.Sum(x => x.TotalApplications ?? 0) },
        new() { HeaderEn = "Pending", HeaderHi = "लंबित",
                ValueSelector = x => x.RheoPending ?? 0,
                TotalSelector = list => list.Sum(x => x.RheoPending ?? 0) },
        new() { HeaderEn = "Approved", HeaderHi = "स्वीकृत",
                ValueSelector = x => x.RheoApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.RheoApproved ?? 0) },
        new() { HeaderEn = "Rejected", HeaderHi = "अस्वीकृत",
                ValueSelector = x => x.RheoRejected ?? 0,
                TotalSelector = list => list.Sum(x => x.RheoRejected ?? 0) },
        new() { HeaderEn = "Pending", HeaderHi = "लंबित",
                ValueSelector = x => x.RheoPending ?? 0,
                TotalSelector = list => list.Sum(x => x.DdhPending ?? 0) },
        new() { HeaderEn = "Approved", HeaderHi = "स्वीकृत",
                ValueSelector = x => x.RheoApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.DdhApproved ?? 0) },
        new() { HeaderEn = "Rejected", HeaderHi = "अस्वीकृत",
                ValueSelector = x => x.RheoRejected ?? 0,
                TotalSelector = list => list.Sum(x => x.DdhRejected ?? 0) },
    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                     .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("Scheme Wise Applications Report", "योजनावार आवेदन रिपोर्ट"),
            (en, hi) => Lang.Text(en, hi),
            $"SchemeWise_ApplicationsReport_{finYear}.xlsx");
    }
}
