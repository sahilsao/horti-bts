@page "/admin/add-midh-component-type"
@attribute [Authorize(Roles = "Admin")]

@using HortiBts.Client.Services.Components
@using HortiBts.Client.Services.MIDHComponents
@using HortiBts.Client.Services.MIDHSchemes
@using HortiBts.Client.Services.Schemes
@using HortiBts.Shared.Dtos.Components
@using HortiBts.Shared.Dtos.MIDHComponents
@using HortiBts.Shared.Dtos.MIDHSchemes
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Validation

@inject SchemesApiService SchemesApiService
@inject MidhSchemesApiService MidhSchemesApiService
@inject MIDHComponentTypeApiService MIDHComponentTypeApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>
    @Lang.Text("Add MIDH Component Type", "MIDH घटक प्रकार जोड़ें")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/box_add"
             Color="Color.Primary"
             Size="Size.Large" />

    @Lang.Text("Add MIDH Component Type", "MIDH घटक प्रकार जोड़ें")
</MudText>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text(
        "Fill in the fields below and save it to add a new MIDH component type.",
        "MIDH घटक प्रकार में नया विकल्प जोड़ने हेतु नीचे दिए गए फील्ड भरकर सुरक्षित करें।")
</MudText>

<MudForm @ref="Form" Model="@this">

    <div @ref="_formTopRef">

        <MudGrid Spacing="3" Class="mb-4">

            <!-- Scheme Type -->
            <MudItem xs="12" sm="4">
                <MudSelect T="int?"
                           Value="_selectedSchemeTypeId"
                           ValueChanged="OnSchemeTypeChanged"
                           Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                           Variant="Variant.Outlined"
                           Required="true">

                    @foreach (var type in _schemeTypes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)type.SchemeId)">
                            @Lang.Text(
                                type.SchemeTypeNameEn!,
                                type.SchemeTypeName!)
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <!-- MIDH Scheme -->
            <MudItem xs="12" sm="5">
                <MudSelect T="int?"
                           @bind-Value="_selectedMidhSchemeId"
                           Label="@Lang.Text("MIDH Scheme", "MIDH योजना")"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@(!_midhSchemes.Any())">

                    @foreach (var scheme in _midhSchemes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)scheme.MidhSchemeId)">
                            @scheme.MidhSchemeNameEn
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Component Type ID -->
            <MudItem xs="12" sm="3">
                <MudNumericField T="int?"
                                 @bind-Value="_selectedMidhComponentTypeId"
                                 Label="@Lang.Text("MIDH Component Type ID","MIDH घटक प्रकार ID")"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 Immediate="true" />
            </MudItem>

            <!-- English Name -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentTypeNameEn"
                              @ref="_midhComponentTypeNameEnField"
                              Label="@Lang.Text("MIDH Component Type Name (English)","MIDH घटक प्रकार का नाम (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- Hindi Name -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentTypeNameHi"
                              Label="@Lang.Text("MIDH Component Type Name (Hindi)","MIDH घटक प्रकार का नाम (हिंदी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- English Description -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentTypeDescriptionEn"
                              Label="@Lang.Text("MIDH Component Type Description (English)","MIDH घटक प्रकार का विवरण (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishDescription(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- Hindi Description -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentTypeDescriptionHi"
                              Label="@Lang.Text("MIDH Component Type Description (Hindi)","MIDH घटक प्रकार का विवरण (हिंदी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.HindiDescription(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

        </MudGrid>

    </div>

    <!-- Buttons -->
    <MudStack Row="true" Spacing="1">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   OnClick="SaveMidhComponentType"
                   Disabled="_isLoading">

            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2" />

                <span>
                    @Lang.Text("Saving...", "सुरक्षित हो रहा है...")
                </span>
            }
            else
            {
                <span>
                    @Lang.Text(
                        _selectedMidhComponentTypeId is null ? "Save" : "Update",
                        _selectedMidhComponentTypeId is null ? "सुरक्षित करें" : "अपडेट करें")
                </span>
            }

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="Reset"
                   Disabled="_isLoading">

            @Lang.Text("Reset", "रीसेट")

        </MudButton>

    </MudStack>

</MudForm>

<!-- MIDH Component Type List -->
@if (_midhComponentsTypes.Any())
{
    <MudTable Items="_filteredMidhComponentsTypes"
              Dense="true"
              Hover="true"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("MIDH Component Types", "MIDH घटक प्रकार")
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />

        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमांक")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Type ID", "MIDH घटक प्रकार ID")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Type ID", "MIDH घटक प्रकार ID")</MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<MIDHComponentTypeDto, object>(x => x.MidhComponentTypeNameEn ?? string.Empty)">
                    @Lang.Text(
                        "MIDH Component Type Name (English)",
                        "MIDH घटक प्रकार का नाम (अंग्रेज़ी)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<MIDHComponentTypeDto, object>(x => x.MidhComponentTypeNameHi ?? string.Empty)">
                    @Lang.Text(
                        "MIDH Component Type Name (Hindi)",
                        "MIDH घटक प्रकार का नाम (हिंदी)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>@Lang.Text("MIDH Component Type Description (English)", "MIDH घटक प्रकार का विवरण (अंग्रेज़ी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Type Description (Hindi)", "MIDH घटक प्रकार का विवरण (हिंदी)")</MudTh>
            <MudTh>@Lang.Text("Active Status", "एक्टिव स्टेटस")</MudTh>
            <MudTh>@Lang.Text("Edit", "संपादित करें")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमांक")">
                @(_filteredMidhComponentsTypes.ToList().IndexOf(context) + 1)
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Component Type ID (English)", "घटक प्रकार ID (अंग्रेज़ी)")">
                @context.ComponentTypeId
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Type ID (English)", "MIDH घटक प्रकार ID (अंग्रेज़ी)")">
                @context.MidhComponentTypeId
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Type Name (English)", "MIDH घटक प्रकार का नाम (अंग्रेज़ी)")">
                @context.MidhComponentTypeNameEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Name (Hindi)", "MIDH घटक का नाम (हिंदी)")">
                @context.MidhComponentTypeNameHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Description (English)", "MIDH घटक का विवरण (अंग्रेज़ी)")">
                @context.MidhComponentTypeDescriptionEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Description (Hindi)", "MIDH घटक का विवरण (हिंदी)")">
                @context.MidhComponentTypeDescriptionHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Active Status", "एक्टिव स्टेटस")">
                <MudSwitch T="bool"
                           Value="@context.Flag"
                           ValueChanged="@(newValue => ToggleFlag(context, newValue))"
                           Color="Color.Success"
                           Disabled="@_togglingIds.Contains(context.ComponentTypeId)" />
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Edit", "संपादित करें")">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@Lang.Text("Edit", "संपादित करें")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => LoadForEdit(context))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private ElementReference _formTopRef;
    private MudTextField<string> _midhComponentTypeNameEnField = default!;

    // Lists
    private List<SchemeTypeDto> _schemeTypes = new();
    private List<MIDHSchemeDto> _midhSchemes = new();
    private List<MIDHComponentTypeDto> _midhComponentsTypes = new();

    // Search
    private string _searchString = string.Empty;

    // Selected IDs
    private int? _selectedSchemeTypeId;
    private int? _selectedMidhSchemeId;
    private int? _selectedComponentTypeId;
    private int? _selectedMidhComponentTypeId;

    // Form fields
    private string? _midhComponentTypeNameEn;
    private string? _midhComponentTypeNameHi;
    private string? _midhComponentTypeDescriptionEn;
    private string? _midhComponentTypeDescriptionHi;

    // State
    private bool _isLoading;
    private HashSet<int?> _togglingIds = new();
    private bool _isEditMode = false;

    // Filter
    private IEnumerable<MIDHComponentTypeDto> _filteredMidhComponentsTypes =>
        _midhComponentsTypes.Where(c =>
            string.IsNullOrWhiteSpace(_searchString)
            || (c.MidhComponentTypeNameEn?.Contains(
                _searchString,
                StringComparison.OrdinalIgnoreCase) ?? false)
            || (c.MidhComponentTypeNameHi?.Contains(
                _searchString,
                StringComparison.OrdinalIgnoreCase) ?? false));


    protected override async Task OnInitializedAsync()
    {
        await LoadSchemeTypes();
        await LoadMidhComponentsTypes();
    }

    private async Task LoadSchemeTypes()
    {
        var result = await SchemesApiService.GetSchemesTypesAsync();

        if (result.IsSuccess && result.Data is not null)
        {
            _schemeTypes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task OnSchemeTypeChanged(int? schemeTypeId)
    {
        _selectedSchemeTypeId = schemeTypeId;

        _selectedMidhSchemeId = null;

        _midhSchemes.Clear();

        if (!schemeTypeId.HasValue)
            return;

        var result = await MidhSchemesApiService.GetMIDHSchemesListBySchemeTypeAsync(schemeTypeId.Value);

        if (result.IsSuccess && result.Data is not null && result.Data.Any())
        {
            _midhSchemes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load MIDH schemes.",
                    "MIDH योजनाएँ लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadMidhComponentsTypes()
    {
        var result = await MIDHComponentTypeApiService.GetMIDHComponentTypesListAsync();

        if (result.IsSuccess && result.Data is not null && result.Data.Any())
        {
            _midhComponentsTypes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load MIDH component types.",
                    "MIDH घटक प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadForEdit(MIDHComponentTypeDto component)
    {
        _isEditMode = true;
        _selectedComponentTypeId = component.ComponentTypeId;
        _selectedSchemeTypeId = component.MidhSchemeId;

        // Load MIDH schemes first
        await OnSchemeTypeChanged(component.SchemeTypeId);

        // Select existing scheme
        _selectedMidhSchemeId = component.MidhSchemeId;

        // Existing component type ID
        _selectedMidhComponentTypeId = component.MidhComponentTypeId;

        _midhComponentTypeNameEn = component.MidhComponentTypeNameEn;
        _midhComponentTypeNameHi = component.MidhComponentTypeNameHi;
        _midhComponentTypeDescriptionEn = component.MidhComponentTypeDescriptionEn;
        _midhComponentTypeDescriptionHi = component.MidhComponentTypeDescriptionHi;


        if (Form is not null)
            await Form.ResetValidationAsync();

        await JS.InvokeVoidAsync(
            "scrollAndFocus",
            _formTopRef);

        await _midhComponentTypeNameEnField.FocusAsync();
    }

    private async Task SaveMidhComponentType()
    {
        if (Form is null)
            return;

        await Form.ValidateAsync();

        if (!Form.IsValid)
            return;


        if (!_selectedSchemeTypeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please select scheme type.", "कृपया योजना प्रकार चुनें।"), Severity.Warning);
            return;
        }

        if (!_selectedMidhSchemeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please select MIDH scheme.", "कृपया MIDH योजना चुनें।"), Severity.Warning);
            return;
        }

        if (!_selectedMidhComponentTypeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please enter MIDH component type ID.", "कृपया MIDH घटक प्रकार ID दर्ज करें।"), Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var dto = new AddMIDHComponentTypeDto
            {
                MidhSchemeId = _selectedMidhSchemeId,
                ComponentTypeId = _selectedComponentTypeId,
                MidhComponentTypeId = _selectedMidhComponentTypeId,
                MidhComponentTypeNameEn = _midhComponentTypeNameEn!,
                MidhComponentTypeNameHi = _midhComponentTypeNameHi!,
                MidhComponentTypeDescriptionEn = _midhComponentTypeDescriptionEn!,
                MidhComponentTypeDescriptionHi = _midhComponentTypeDescriptionHi!
            };

            var result = _isEditMode
                    ? await MIDHComponentTypeApiService.UpdateMIDHComponentTypeAsync(dto)
                    : await MIDHComponentTypeApiService.SaveMIDHComponentTypesListAsync(dto);

            if (result.IsSuccess)
            {
                Snackbar.Add(Lang.Text(
                        _selectedMidhComponentTypeId is null
                            ? "Component type saved successfully."
                            : "Component type updated successfully.",

                        _selectedMidhComponentTypeId is null
                            ? "घटक प्रकार सफलतापूर्वक सुरक्षित किया गया।"
                            : "घटक प्रकार सफलतापूर्वक अपडेट किया गया।"),
                    Severity.Success);

                await Reset();
                await LoadMidhComponentsTypes();
            }
            else
            {
                Snackbar.Add(
                    result.Error ??
                    Lang.Text(
                        "Failed to save component type.",
                        "घटक प्रकार सुरक्षित करने में विफल।"),
                    Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to save component type.",
                    "घटक प्रकार सुरक्षित करने में विफल।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFlag(MIDHComponentTypeDto component, bool newValue)
    {
        _togglingIds.Add(component.ComponentTypeId);
        var previousValue = component.Flag;
        component.Flag = newValue; // optimistic UI update

        try
        {
            var result = await MIDHComponentTypeApiService.UpdateMIDHComponentTypeActiveFlagAsync(component.ComponentTypeId, newValue);
            if (!result.IsSuccess)
            {
                component.Flag = previousValue; // revert on failure
                Snackbar.Add(result.Error ?? Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
                await LoadMidhComponentsTypes();
            }
            else
            {
                Snackbar.Add(
                    newValue
                        ? Lang.Text("MIDH Component Type activated.", "MIDH घटक प्रकार सक्रिय किया गया।")
                        : Lang.Text("MIDH Component Type deactivated.", "MIDH घटक प्रकार निष्क्रिय किया गया।"),
                    Severity.Success);
            }
        }
        catch
        {
            component.Flag = previousValue;
            Snackbar.Add(Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
        }
        finally
        {
            _togglingIds.Remove(component.ComponentTypeId);
        }
    }

    private async Task Reset()
    {
        _isEditMode = false;
        _selectedSchemeTypeId = null;
        _selectedMidhSchemeId = null;
        _selectedMidhComponentTypeId = null;
        _midhSchemes.Clear();

        _midhComponentTypeNameEn = null;
        _midhComponentTypeNameHi = null;
        _midhComponentTypeDescriptionEn = null;
        _midhComponentTypeDescriptionHi = null;


        if (Form is not null)
            await Form.ResetValidationAsync();
    }
}