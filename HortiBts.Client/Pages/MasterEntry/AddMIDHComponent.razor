@page "/admin/add-midh-component"
@attribute [Authorize(Roles = "Admin")]

@using HortiBts.Client.Services.MIDHComponents
@using HortiBts.Client.Services.MIDHSchemes
@using HortiBts.Client.Services.Schemes
@using HortiBts.Shared.Dtos.MIDHComponents
@using HortiBts.Shared.Dtos.MIDHSchemes
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Validation

@inject SchemesApiService SchemesApiService
@inject MidhSchemesApiService MidhSchemesApiService
@inject MIDHComponentTypeApiService MIDHComponentTypeApiService
@inject MIDHComponentApiService MIDHComponentApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>
    @Lang.Text("Add MIDH Component", "MIDH घटक जोड़ें")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/bookmark_add"
             Color="Color.Primary"
             Size="Size.Large" />

    @Lang.Text("Add MIDH Component", "MIDH घटक जोड़ें")
</MudText>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text(
        "Fill in the fields below and save it to add a new MIDH component.",
        "MIDH घटक में नया विकल्प जोड़ने हेतु नीचे दिए गए फील्ड भरकर सुरक्षित करें।")
</MudText>

<MudForm @ref="Form" Model="@this">

    <div @ref="_formTopRef">

        <MudGrid Spacing="3" Class="mb-4">

            <!-- Scheme Type -->
            <MudItem xs="12" sm="3">
                <MudSelect T="int?"
                           Value="_selectedSchemeTypeId"
                           ValueChanged="OnSchemeTypeChanged"
                           Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                           Variant="Variant.Outlined"
                           Required="true">

                    @foreach (var type in _schemeTypes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)type.SchemeId)">
                            @Lang.Text(
                                type.SchemeTypeNameEn!,
                                type.SchemeTypeName!)
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <!-- MIDH Scheme -->
            <MudItem xs="12" sm="3">
                <MudSelect T="int?"
                           Value="_selectedMidhSchemeId"
                           ValueChanged="OnMidhSchemeChanged"
                           Label="@Lang.Text("MIDH Scheme", "MIDH योजना")"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@(!_midhSchemes.Any())">

                    @foreach (var scheme in _midhSchemes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)scheme.MidhSchemeId)">
                            @scheme.MidhSchemeNameEn
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Component Type -->
            <MudItem xs="12" sm="3">
                <MudSelect T="int?"
                           @bind-Value="_selectedMidhComponentTypeId"
                           Label="@Lang.Text("MIDH Component Type", "MIDH घटक प्रकार")"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@(!_midhComponentsTypes.Any())">

                    @foreach (var type in _midhComponentsTypes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)type.MidhComponentTypeId)">
                            @type.MidhComponentTypeNameEn
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Component ID -->
            <MudItem xs="12" sm="3">
                <MudNumericField T="int?"
                                 @bind-Value="_midhComponentId"
                                 Label="@Lang.Text("MIDH Component ID","MIDH घटक ID")"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 Immediate="true" />
            </MudItem>

            <!-- English Name -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentNameEn"
                              @ref="_midhComponentNameEnField"
                              Label="@Lang.Text("MIDH Component Name (English)","MIDH घटक का नाम (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- Hindi Name -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentNameHi"
                              Label="@Lang.Text("MIDH Component Name (Hindi)","MIDH घटक का नाम (हिंदी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- English Description -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentDescriptionEn"
                              Label="@Lang.Text("MIDH Component Description (English)","MIDH घटक का विवरण (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishDescription(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <!-- Hindi Description -->
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_midhComponentDescriptionHi"
                              Label="@Lang.Text("MIDH Component Description (Hindi)","MIDH घटक का विवरण (हिंदी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.HindiDescription(value,Lang.Text)))"
                              Immediate="true" />
            </MudItem>

        </MudGrid>

    </div>

    <!-- Buttons -->
    <MudStack Row="true" Spacing="1">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   OnClick="SaveMidhComponentType"
                   Disabled="_isLoading">

            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2" />

                <span>
                    @Lang.Text("Saving...", "सुरक्षित हो रहा है...")
                </span>
            }
            else if (!_isEditMode)
            {
                <span>@Lang.Text("Save", "सुरक्षित करे")</span>
            }
            else
            {
                <span>@Lang.Text("Update", "अपडेट करे")</span>
            }

        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="Reset"
                   Disabled="_isLoading">

            @Lang.Text("Reset", "रीसेट")

        </MudButton>

    </MudStack>

</MudForm>

<!-- MIDH Component Type List -->
@if (_midhComponents.Any())
{
    <MudTable Items="_filteredMidhComponents"
              Dense="true"
              Hover="true"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("MIDH Component", "MIDH घटक")
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />

        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमांक")</MudTh>
            <MudTh>@Lang.Text("Component ID", "घटक ID")</MudTh>
            <MudTh>@Lang.Text("MIDH Component ID", "MIDH घटक ID")</MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<MIDHComponentDto, object>(x => x.MidhComponentNameEn ?? string.Empty)">
                    @Lang.Text(
                        "MIDH Component Name (English)",
                        "MIDH घटक प्रकार का नाम (अंग्रेज़ी)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<MIDHComponentDto, object>(x => x.MidhComponentNameHi ?? string.Empty)">
                    @Lang.Text(
                        "MIDH Component Name (Hindi)",
                        "MIDH घटक का नाम (हिंदी)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>@Lang.Text("MIDH Component Description (English)", "MIDH घटक का विवरण (अंग्रेज़ी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Description (Hindi)", "MIDH घटक का विवरण (हिंदी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Type (English)", "MIDH घटक प्रकार (अंग्रेज़ी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Component Type (Hindi)", "MIDH घटक प्रकार (हिंदी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Scheme (English)", "MIDH योजना (अंग्रेज़ी)")</MudTh>
            <MudTh>@Lang.Text("MIDH Scheme (Hindi)", "MIDH योजना (हिंदी)")</MudTh>
            <MudTh>@Lang.Text("Active Status", "एक्टिव स्टेटस")</MudTh>
            <MudTh>@Lang.Text("Edit", "संपादित करें")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमांक")">
                @(_filteredMidhComponents.ToList().IndexOf(context) + 1)
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Component ID (English)", "घटक ID (अंग्रेज़ी)")">
                @context.ComponentId
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component ID (English)", "MIDH घटक ID (अंग्रेज़ी)")">
                @context.MidhComponentId
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Name (English)", "MIDH घटक का नाम (अंग्रेज़ी)")">
                @context.MidhComponentNameEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Name (Hindi)", "MIDH घटक का नाम (हिंदी)")">
                @context.MidhComponentNameHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Description (English)", "MIDH घटक का विवरण (अंग्रेज़ी)")">
                @context.MidhComponentDescriptionEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Description (Hindi)", "MIDH घटक का विवरण (हिंदी)")">
                @context.MidhComponentDescriptionHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Type (English)", "MIDH घटक प्रकार (अंग्रेज़ी)")">
                @context.MidhComponentTypeNameEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Component Type (Hindi)", "MIDH घटक प्रकार (हिंदी)")">
                @context.MidhComponentTypeNameHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme (English)", "MIDH योजना (अंग्रेज़ी)")">
                @context.MidhSchemeNameEn
            </MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme (Hindi)", "MIDH योजना (हिंदी)")">
                @context.MidhSchemeNameHi
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Active Status", "एक्टिव स्टेटस")">
                <MudSwitch T="bool"
                           Value="@context.Flag"
                           ValueChanged="@(newValue => ToggleFlag(context, newValue))"
                           Color="Color.Success"
                           Disabled="@_togglingIds.Contains(context.ComponentId)" />
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Edit", "संपादित करें")">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@Lang.Text("Edit", "संपादित करें")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => LoadForEdit(context))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private ElementReference _formTopRef;
    private MudTextField<string> _midhComponentNameEnField = default!;

    // Lists
    private List<SchemeTypeDto> _schemeTypes = new();
    private List<MIDHSchemeDto> _midhSchemes = new();
    private List<MIDHComponentTypeDto> _midhComponentsTypes = new();
    private List<MIDHComponentDto> _midhComponents = new();

    // Search
    private string _searchString = string.Empty;

    // Selected IDs
    private int? _selectedSchemeTypeId;
    private int? _selectedMidhSchemeId;
    private int? _selectedMidhComponentTypeId;

    // Form fields
    private int? _selectedComponentId;
    private int? _midhComponentId;
    private string? _midhComponentNameEn;
    private string? _midhComponentNameHi;
    private string? _midhComponentDescriptionEn;
    private string? _midhComponentDescriptionHi;

    // State
    private bool _isLoading;
    private HashSet<int?> _togglingIds = new();
    private bool _isEditMode = false;

    // Filter
    private IEnumerable<MIDHComponentDto> _filteredMidhComponents =>
        _midhComponents.Where(c =>
            string.IsNullOrWhiteSpace(_searchString)
            || (c.MidhComponentNameEn?.Contains(
                _searchString,
                StringComparison.OrdinalIgnoreCase) ?? false)
            || (c.MidhComponentNameHi?.Contains(
                _searchString,
                StringComparison.OrdinalIgnoreCase) ?? false));


    protected override async Task OnInitializedAsync()
    {
        await LoadSchemeTypes();
        await LoadMidhComponents();
    }

    private async Task LoadSchemeTypes()
    {
        var result = await SchemesApiService.GetSchemesTypesAsync();

        if (result.IsSuccess && result.Data is not null)
        {
            _schemeTypes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task OnSchemeTypeChanged(int? schemeTypeId)
    {

        _selectedMidhSchemeId = null;

        _midhSchemes.Clear();

        _selectedMidhComponentTypeId = null;

        _midhComponentsTypes.Clear();

        _selectedSchemeTypeId = schemeTypeId;

        if (!schemeTypeId.HasValue)
            return;

        var result = await MidhSchemesApiService.GetMIDHSchemesListBySchemeTypeAsync(schemeTypeId.Value);

        if (result.IsSuccess && result.Data is not null && result.Data.Any())
        {
            _midhSchemes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load MIDH schemes.",
                    "MIDH योजनाएँ लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task OnMidhSchemeChanged(int? schemeId)
    {
        _selectedMidhComponentTypeId = null;

        _midhComponentsTypes.Clear();

        _selectedMidhSchemeId = schemeId;

        if (!schemeId.HasValue)
            return;

        var result = await MIDHComponentTypeApiService.GetComponentTypesListBySchemeIdAsync(schemeId.Value);

        if (result.IsSuccess && result.Data is not null && result.Data.Any())
        {
            _midhComponentsTypes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load MIDH component types.",
                    "MIDH घटक प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadMidhComponents()
    {
        var result = await MIDHComponentApiService.GetMIDHComponentsListAsync();

        if (result.IsSuccess && result.Data is not null && result.Data.Any())
        {
            _midhComponents = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load MIDH component.",
                    "MIDH घटक लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadForEdit(MIDHComponentDto component)
    {
        _isEditMode = true;
        _selectedComponentId = component.ComponentId;
        _midhComponentId = component.MidhComponentId;

        // Load MIDH schemes first
        await OnSchemeTypeChanged(component.MidhSchemeTypeId);

        // Select existing scheme
        _selectedMidhSchemeId = component.MidhSchemeId;
        
        await OnMidhSchemeChanged(component.MidhSchemeId);

        // Existing component ID
        _selectedMidhComponentTypeId = component.MidhComponentTypeId;

        _midhComponentNameEn = component.MidhComponentNameEn;
        _midhComponentNameHi = component.MidhComponentNameHi;
        _midhComponentDescriptionEn = component.MidhComponentDescriptionEn;
        _midhComponentDescriptionHi = component.MidhComponentDescriptionHi;


        if (Form is not null)
            await Form.ResetValidationAsync();

        await JS.InvokeVoidAsync(
            "scrollAndFocus",
            _formTopRef);

        await _midhComponentNameEnField.FocusAsync();
    }

    private async Task SaveMidhComponentType()
    {
        if (Form is null)
            return;

        await Form.ValidateAsync();

        if (!Form.IsValid)
            return;


        if (!_selectedSchemeTypeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please select scheme type.", "कृपया योजना प्रकार चुनें।"), Severity.Warning);
            return;
        }

        if (!_selectedMidhSchemeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please select MIDH scheme.", "कृपया MIDH योजना चुनें।"), Severity.Warning);
            return;
        }

        if (!_selectedMidhComponentTypeId.HasValue)
        {
            Snackbar.Add(Lang.Text("Please enter MIDH component type ID.", "कृपया MIDH घटक प्रकार ID दर्ज करें।"), Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var dto = new AddMIDHComponentDto
            {
                // null for insert, existing ID for update
                ComponentId = _isEditMode ? _selectedComponentId : null,

                MidhComponentTypeId = _selectedMidhComponentTypeId,
                MidhComponentId = _midhComponentId,
                MidhComponentNameEn = _midhComponentNameEn!,
                MidhComponentNameHi = _midhComponentNameHi!,
                MidhComponentDescriptionEn = _midhComponentDescriptionEn!,
                MidhComponentDescriptionHi = _midhComponentDescriptionHi!
            };

            var result = _isEditMode
                    ? await MIDHComponentApiService.UpdateMIDHComponentAsync(dto)
                    : await MIDHComponentApiService.SaveMIDHComponentAsync(dto);

            if (result.IsSuccess)
            {
                Snackbar.Add(Lang.Text(
                        _midhComponentId is null
                            ? "Component saved successfully."
                            : "Component updated successfully.",

                        _midhComponentId is null
                            ? "घटक सफलतापूर्वक सुरक्षित किया गया।"
                            : "घटक सफलतापूर्वक अपडेट किया गया।"),
                    Severity.Success);

                await Reset();
                await LoadMidhComponents();
            }
            else
            {
                Snackbar.Add(
                    result.Error ??
                    Lang.Text(
                        "Failed to save component ",
                        "घटक सुरक्षित करने में विफल।"),
                    Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to save component.",
                    "घटक सुरक्षित करने में विफल।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFlag(MIDHComponentDto component, bool newValue)
    {
        _togglingIds.Add(component.MidhComponentId);
        var previousValue = component.Flag;
        component.Flag = newValue; // optimistic UI update

        try
        {
            var result = await MIDHComponentApiService.UpdateMIDHComponentActiveFlagAsync(component.ComponentId, newValue);
            if (!result.IsSuccess)
            {
                component.Flag = previousValue; // revert on failure
                Snackbar.Add(result.Error ?? Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
                await LoadMidhComponents();
            }
            else
            {
                Snackbar.Add(
                    newValue
                        ? Lang.Text("MIDH Component activated.", "MIDH घटक सक्रिय किया गया।")
                        : Lang.Text("MIDH Component deactivated.", "MIDH घटक निष्क्रिय किया गया।"),
                    Severity.Success);
            }
        }
        catch
        {
            component.Flag = previousValue;
            Snackbar.Add(Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
        }
        finally
        {
            _togglingIds.Remove(component.ComponentId);
        }
    }

    private async Task Reset()
    {
        _isEditMode = false;
        _selectedSchemeTypeId = null;
        _selectedMidhSchemeId = null;
        _midhComponentId = null;
        _selectedMidhComponentTypeId = null;
        _midhSchemes.Clear();
        _midhComponentsTypes.Clear();
        _midhComponentNameEn = null;
        _midhComponentNameHi = null;
        _midhComponentDescriptionEn = null;
        _midhComponentDescriptionHi = null;


        if (Form is not null)
            await Form.ResetValidationAsync();
    }
}