@page "/admin/add-midh-scheme"
@attribute [Authorize(Roles = "Admin")]
@using System.Text.RegularExpressions
@using HortiBts.Client.Pages.Home
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.MIDHSchemes
@using HortiBts.Client.Services.Schemes
@using HortiBts.Shared.Dtos.MIDHSchemes
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Validation
@using Microsoft.AspNetCore.Components.Forms;
@inject HttpClient Http
@inject SchemesApiService SchemesApiService
@inject MidhSchemesApiService MidhSchemesApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Lang.Text("Add MIDH Scheme", "MIDH योजना जोड़ें")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.PostAdd" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Add MIDH Scheme", "MIDH योजना जोड़ें")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Fill in the field below and save it to add a new option to the MIDH schemes.", "MIDH योजनाओ में नया विकल्प जोड़ने हेतु निचे दिए गये फील्ड को भरकर सुरक्षित करें।")
</MudText>

<MudForm @ref="Form" Model="@this">
    <div @ref="_formTopRef">
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudSelect T="int?"
                           @bind-Value="_selectedSchemeTypeId"
                           Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                           Variant="Variant.Outlined"
                           Required="true">

                    @foreach (var st in _schemesTypes)
                    {
                        <MudSelectItem T="int?" Value="@st.SchemeId">
                            @(Lang.IsHindi
                                ? st.SchemeTypeName
                                : st.SchemeTypeNameEn)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="_selectedMidhSchemeId"
                                 Label="@Lang.Text("MIDH Scheme ID", "MIDH योजना ID")"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="string"
                           @bind-Value="_selectedMidhSchemeCode"
                           Label="@Lang.Text("MIDH Scheme Code", "MIDH योजना कोड")"
                           Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="string" Value="@("F")">
                        @Lang.Text("F", "F")
                    </MudSelectItem>
                    <MudSelectItem T="string" Value="@("T")">
                        @Lang.Text("T", "T")
                    </MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_MidhSchemeNameEn" @ref="_midhSchemeNameEnField"
                              Label="@Lang.Text("MIDH Scheme Name (English)", "MIDH योजना का नाम (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_MidhSchemeNameHi"
                              Label="@Lang.Text("MIDH Scheme Name (Hindi)", "MIDH योजना का नाम (हिंदी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_MidhSchemeDescriptionEn"
                              Label="@Lang.Text("MIDH Scheme Description (English)", "MIDH योजना का विवरण (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishDescription(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_MidhSchemeDescriptionHi"
                              Label="@Lang.Text("MIDH Scheme Description (Hindi)", "MIDH योजना का विवरण (हिंदी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.HindiDescription(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    @Lang.Text("Upload PDF", "पीडीएफ अपलोड करें")
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-inline">*</MudText>
                </MudText>

                <MudFileUpload @ref="_fileUploadPDF"
                               T="IBrowserFile"
                               Accept=".pdf"
                               Required="true"
                               Validation="@(new Func<IBrowserFile, string?>(ValidatePDF))"
                               @bind-Files="_filesPDF">
                    <CustomContent Context="uploader">
                        <MudPaper Outlined="true"
                                  Class="pa-6 d-flex flex-column align-center justify-center gap-2 rounded-lg"
                                  Style="border-style:dashed; border-width:2px; cursor:pointer; min-height:140px;"
                                  @onclick="@uploader.OpenFilePickerAsync">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Align="Align.Center">
                                @Lang.Text("Click or drag a PDF here to upload", "अपलोड हेतु यहाँ पीडीएफ खींचें या क्लिक करें")
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @Lang.Text("PDF only · Max 2MB", "केवल पीडीएफ · अधिकतम 2MB")
                            </MudText>
                        </MudPaper>
                    </CustomContent>
                    <SelectedTemplate Context="selectedFile">
                        @if (selectedFile is not null)
                        {
                            <MudPaper Outlined="true" Class="pa-3 mt-2 d-flex align-center gap-3 rounded-lg">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error" Size="Size.Large" />
                                <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0;">
                                    <MudText Typo="Typo.body2" Class="text-truncate">@selectedFile.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatFileSize(selectedFile.Size)</MudText>
                                </MudStack>
                                <MudTooltip Text="@Lang.Text("Remove file", "फ़ाइल हटाएं")">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@RemovePdf" />
                                </MudTooltip>
                            </MudPaper>
                        }
                    </SelectedTemplate>
                </MudFileUpload>

                @{
                    var pdfError = _filesPDF is not null ? ValidatePDF(_filesPDF) : null;
                }
                @if (pdfError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1 d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                        @pdfError
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </div>

    <MudStack Row="true" Spacing="1">
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveMIDHScheme" Disabled="_isLoading">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@Lang.Text("Saving...", "सुरक्षित हो रहा है...")</span>
            }
            else if (!_isEditMode)
            {
                <span>@Lang.Text("Save", "सुरक्षित करे")</span>
            }
            else
            {
                <span>@Lang.Text("Update", "अपडेट करे")</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
            @Lang.Text("Reset", "रीसेट")
        </MudButton>
    </MudStack>
</MudForm>

@if (_midhSchemes.Any())
{
    <MudTable Items="_filteredMidhSchemes"
              SortLabel="Sort By"
              Dense="true"
              Hover="true"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Lang.Text("MIDH Schemes", "MIDH योजनाएँ")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<MIDHSchemeDto, object>(x => x.MidhSchemeTypeNameEn!)">@Lang.Text("MIDH Scheme Type (English)", "MIDH योजना का प्रकार (अंग्रेज़ी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<MIDHSchemeDto, object>(x => x.MidhSchemeTypeNameHi!)">@Lang.Text("MIDH Scheme Type (Hindi)", "MIDH योजना का प्रकार (हिंदी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<MIDHSchemeDto, object>(x => x.MidhSchemeNameEn!)">@Lang.Text("MIDH Scheme Name (English)", "MIDH योजना का नाम (अंग्रेज़ी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<MIDHSchemeDto, object>(x => x.MidhSchemeNameHi!)">@Lang.Text("MIDH Scheme Name (Hindi)", "MIDH योजना का नाम (हिंदी)")</MudTableSortLabel></MudTh>
            <MudTh>@Lang.Text("Active Status", "एक्टिव स्टेटस")</MudTh>
            <MudTh>@Lang.Text("Edit", "संपादित करें")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredMidhSchemes.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme Type (English)", "MIDH योजना का प्रकार (अंग्रेज़ी)")">@context.MidhSchemeTypeNameEn</MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme Type (Hindi)", "MIDH योजना का प्रकार (हिंदी)")">@context.MidhSchemeTypeNameHi</MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme Name (English)", "MIDH योजना का नाम (अंग्रेज़ी)")">@context.MidhSchemeNameEn</MudTd>
            <MudTd DataLabel="@Lang.Text("MIDH Scheme Name (Hindi)", "MIDH योजना का नाम (हिंदी)")">@context.MidhSchemeNameHi</MudTd>

            <MudTd DataLabel="@Lang.Text("Active Status", "एक्टिव स्टेटस")">
                <MudSwitch T="bool"
                           Value="@context.Flag"
                           ValueChanged="@(newValue => ToggleFlag(context, newValue))"
                           Color="Color.Success"
                           Disabled="@_togglingIds.Contains(context.MidhSchemeId)" />
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Edit", "संपादित करें")">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@Lang.Text("Edit", "संपादित करें")">
                        <MudTooltip Text="@Lang.Text("View", "देखें")">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenSchemeDialog(context))" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => LoadForEdit(context))" />
                    </MudTooltip>

                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}
@* ---------- Benefits Type List Result ---------- *@

@code {
    private List<SchemeTypeDto> _schemesTypes = new();
    private List<MIDHSchemeDto> _midhSchemes = new();
    private string _searchString = string.Empty;

    private int? _selectedMidhSchemeId;
    private int? _selectedSchemeTypeId;
    private string? _selectedMidhSchemeCode;
    private int? _selectedSchemeId;

    public string? _MidhSchemeCode { get; set; }
    public string? _MidhSchemeNameEn { get; set; }
    public string? _MidhSchemeNameHi { get; set; }
    public string? _MidhSchemeDescriptionEn { get; set; }
    public string? _MidhSchemeDescriptionHi { get; set; }

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;
    private HashSet<int?> _togglingIds = new();
    private bool _isEditMode = false;

    private ElementReference _formTopRef;
    private MudTextField<string> _midhSchemeNameEnField = default!;

    private IBrowserFile? _filesPDF;
    private MudFileUpload<IBrowserFile> _fileUploadPDF = default!;

    protected override async Task OnInitializedAsync()
    {
        var schemeTypesTask = SchemesApiService.GetSchemesTypesAsync();
        var midhSchemesTask = MidhSchemesApiService.GetMIDHSchemesListAsync();

        await Task.WhenAll(schemeTypesTask, midhSchemesTask);

        var resultSchemeTypes = schemeTypesTask.Result;
        if (resultSchemeTypes.IsSuccess && resultSchemeTypes.Data is not null)
            _schemesTypes = resultSchemeTypes.Data;
        else
            Snackbar.Add(Lang.Text("Failed to load scheme types.", "योजना प्रकार लोड करने में विफल।"), Severity.Error);

        var resultSchemes = midhSchemesTask.Result;
        if (resultSchemes.IsSuccess && resultSchemes.Data is not null)
            _midhSchemes = resultSchemes.Data;
        else
            Snackbar.Add(Lang.Text("Failed to load schemes list.", "योजना सूची लोड करने में विफल।"), Severity.Error);
    }

    private async Task LoadMidhSchemes()
    {
        var result = await MidhSchemesApiService.GetMIDHSchemesListAsync();
        if (result.IsSuccess && result.Data is not null)
            _midhSchemes = result.Data;
        else
            Snackbar.Add(Lang.Text("Failed to load midh schemes list.", "midh योजना सूची लोड करने में विफल।"), Severity.Error);
    }

    private IEnumerable<MIDHSchemeDto> _filteredMidhSchemes =>
    _midhSchemes.Where(s =>
        string.IsNullOrWhiteSpace(_searchString)
        || (s.MidhSchemeNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
        || (s.MidhSchemeNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
        || (s.MidhSchemeDescriptionEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
        || (s.MidhSchemeDescriptionHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task SaveMIDHScheme()
    {
        await Form!.ValidateAsync();

        if (!Form.IsValid)
            return;

        if (_filesPDF is null)
        {
            Snackbar.Add(
                Lang.Text("PDF file is required.", "PDF फ़ाइल आवश्यक है।"),
                Severity.Error);

            return;
        }

        _isLoading = true;

        try
        {
            var dto = new AddMIDHSchemeDto
            {
                SchemeId = _selectedSchemeId,
                MIDHSchemeId = _selectedMidhSchemeId,
                MIDHSchemeCode = _selectedMidhSchemeCode,
                SchemeTypeId = _selectedSchemeTypeId,
                MIDHSchemeNameEn = _MidhSchemeNameEn!,
                MIDHSchemeNameHi = _MidhSchemeNameHi!,
                MIDHSchemeDescriptionHi = _MidhSchemeDescriptionHi!,
                MIDHSchemeDescriptionEn = _MidhSchemeDescriptionEn!
            };

            var result = _isEditMode
                        ? await MidhSchemesApiService.UpdateMIDHSchemeAsync(dto, _filesPDF)
                        : await MidhSchemesApiService.SaveMIDHSchemeAsync(dto, _filesPDF);

            if (result.IsSuccess)
            {
                Snackbar.Add(
                    Lang.Text(
                        "MIDH Scheme saved successfully.",
                        "MIDH योजना सफलतापूर्वक सुरक्षित की गई।"),
                    Severity.Success);

                Reset();
                await LoadMidhSchemes();
            }
            else
            {
                Snackbar.Add(
                    result.Error ??
                    Lang.Text(
                        "Failed to save MIDH scheme.",
                        "MIDH योजना सुरक्षित करने में विफल।"),
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Snackbar.Add(
                Lang.Text(
                    "Failed to save MIDH scheme.",
                    "MIDH योजना सुरक्षित करने में विफल।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async void Reset()
    {
        _isEditMode = false;
        _selectedSchemeId = null;
        _selectedMidhSchemeId = null;
        _selectedSchemeTypeId = null;
        _selectedMidhSchemeCode = null;
        _MidhSchemeNameEn = null;
        _MidhSchemeNameHi = null;
        _MidhSchemeDescriptionEn = null;
        _MidhSchemeDescriptionHi = null;
        Form?.ResetValidationAsync();
        await RemovePdf();
    }

    private async Task RemovePdf()
    {
        _filesPDF = null;
        if (_fileUploadPDF is not null)
            await _fileUploadPDF.ClearAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }

    private string? ValidatePDF(IBrowserFile file)
    {
        if (file is null)
            return Lang.Text("PDF file is required.", "PDF फ़ाइल आवश्यक है।");

        return file.Size > 2 * 1024 * 1024
            ? Lang.Text("File size exceeds 2MB limit.", "फ़ाइल का आकार 2MB सीमा से अधिक है।")
            : null;
    }

   
    private async Task LoadForEdit(MIDHSchemeDto scheme)
    {
        _isEditMode = true;
        _selectedSchemeId = scheme.SchemeId;
        _selectedMidhSchemeId = scheme.MidhSchemeId;
        _selectedMidhSchemeCode = scheme.MidhSchemeCode;
        _selectedSchemeTypeId = scheme.SchemeTypeId;
        _MidhSchemeNameEn = scheme.MidhSchemeNameEn;
        _MidhSchemeNameHi = scheme.MidhSchemeNameHi;
        _MidhSchemeDescriptionEn = scheme.MidhSchemeDescriptionEn;
        _MidhSchemeDescriptionHi = scheme.MidhSchemeDescriptionHi;

        if (Form is not null)
            await Form.ResetValidationAsync();

        // scroll the form into view, then focus the first field
        await JS.InvokeVoidAsync("scrollAndFocus", _formTopRef);
        await _midhSchemeNameEnField.FocusAsync();
    }

    private async Task OpenSchemeDialog(MIDHSchemeDto scheme)
    {
        var parameters = new DialogParameters<MIDHSchemeDialog>
        {
            { x => x.MidhScheme, scheme },
            { x => x.DocType, "SCHEME_NEW" },
            {
                x => x.OnOpenDocument,
                EventCallback.Factory.Create<string?>(
                    this,
                    path => GetPdf(path, "scheme_new"))
            }
        };

        await DialogService.ShowAsync<MIDHSchemeDialog>(
            "",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });
    }

    private async Task GetPdf(string? fileName, string category)
    {

        if (string.IsNullOrWhiteSpace(fileName)) return;
        try
        {
            var bytes = await Http.GetByteArrayAsync($"api/files/{category}/{Uri.EscapeDataString(fileName)}");

            await using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);

            var downloadName = Path.GetFileName(fileName.Replace('\\', '/'));

            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                downloadName,   // now just "139_CCF_000120_New.pdf"
                streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GetPdf] failed to download {category}/{fileName}: {ex}");
        }
    }

    private async Task ToggleFlag(MIDHSchemeDto scheme, bool newValue)
    {
        _togglingIds.Add(scheme.MidhSchemeId);
        var previousValue = scheme.Flag;
        scheme.Flag = newValue; // optimistic UI update

        try
        {
            var result = await MidhSchemesApiService.UpdateMIDHSchemeActiveFlagAsync(scheme.MidhSchemeId, newValue);
            if (!result.IsSuccess)
            {
                scheme.Flag = previousValue; // revert on failure
                Snackbar.Add(result.Error ?? Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
                await LoadMidhSchemes();
            }
            else
            {
                Snackbar.Add(
                    newValue
                        ? Lang.Text("Scheme activated.", "योजना सक्रिय की गई।")
                        : Lang.Text("Scheme deactivated.", "योजना निष्क्रिय की गई।"),
                    Severity.Success);
            }
        }
        catch
        {
            scheme.Flag = previousValue;
            Snackbar.Add(Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
        }
        finally
        {
            _togglingIds.Remove(scheme.MidhSchemeId);
        }
    }
}