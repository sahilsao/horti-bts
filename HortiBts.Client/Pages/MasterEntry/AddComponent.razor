@page "/admin/add-component"
@attribute [Authorize(Roles = "Admin")]
@using System.Text.RegularExpressions
@using HortiBts.Client.Pages.Home
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Components
@using HortiBts.Client.Services.Schemes
@using HortiBts.Client.Services.Units
@using HortiBts.Shared.Dtos.Components
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Dtos.Units
@using HortiBts.Shared.Validation
@using Microsoft.AspNetCore.Components.Forms

@inject HttpClient Http
@inject SchemesApiService SchemesApiService
@inject ComponentsApiService ComponentsApiService
@inject UnitsApiService UnitsApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Lang.Text("Add Component", "घटक जोड़ें")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="@Icons.Material.Filled.BookmarkAdd"
             Color="Color.Primary"
             Size="Size.Large" />

    @Lang.Text("Add Component", "घटक जोड़ें")
</MudText>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text(
        "Fill in the field below and save it to add a new option to the component.",
        "घटकों में नया विकल्प जोड़ने हेतु निचे दिए गये फील्ड को भरकर सुरक्षित करें।")
</MudText>

<MudForm @ref="Form" Model="@this">
    <div @ref="_formTopRef">
        <MudGrid Spacing="3" Class="mb-4">
            <!-- Scheme Type -->
            <MudItem xs="12" sm="4">
                <MudSelect T="int?"
                           Value="_selectedSchemeTypeId"
                           ValueChanged="OnSchemeTypeChanged"
                           Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                           Variant="Variant.Outlined"
                           Required="true">
                    @foreach (var st in _schemesTypes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)st.SchemeId)">
                            @(Lang.IsHindi
                                ? st.SchemeTypeName
                                : st.SchemeTypeNameEn)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- Scheme -->
            <MudItem xs="12" sm="5">
                <MudSelect T="int?"
                           @bind-Value="_selectedSchemeId"
                           Label="@Lang.Text("Scheme", "योजना")"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@(!_schemes.Any())">
                    @foreach (var scheme in _schemes)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)scheme.SchemeId)">
                            @scheme.SchemeName

                            @if (!string.IsNullOrWhiteSpace(scheme.SchemeNameEn))
                            {
                                <span> / @scheme.SchemeNameEn</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudSelect T="int?"
                           @bind-Value="_selectedComponentUnitId"
                           Label="@Lang.Text("Component Unit Id", "घटक का यूनिट ID")"
                           Variant="Variant.Outlined"
                           Required="true">
                    @foreach (var unit in _units)
                    {
                        <MudSelectItem T="int?" Value="@((int?)unit.UnitId)">
                            @unit.UnitName
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_ComponentNameEn" @ref="_componentNameEnField"
                              Label="@Lang.Text("Component Name (English)", "घटक का नाम (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_ComponentNameHi"
                              Label="@Lang.Text("Component Name (Hindi)", "घटक का नाम (हिंदी)")"
                              Variant="Variant.Outlined"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishHindiWithSpecialCharsName(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_ComponentDescriptionEn"
                              Label="@Lang.Text("Component Description (English)", "घटक का विवरण (अंग्रेज़ी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.EnglishDescription(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_ComponentDescriptionHi"
                              Label="@Lang.Text("Component Description (Hindi)", "घटक का विवरण (हिंदी)")"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Required="true"
                              Validation="@(new Func<string, string?>(value => FieldValidators.HindiDescription(value, Lang.Text)))"
                              Immediate="true" />
            </MudItem>
        </MudGrid>
    </div>
    <MudStack Row="true" Spacing="1">
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveComponent" Disabled="_isLoading">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@Lang.Text("Saving...", "सुरक्षित हो रहा है...")</span>
            }
            else if (_selectedComponentId is null)
            {
                <span>@Lang.Text("Save", "सुरक्षित करे")</span>
            }
            else
            {
                <span>@Lang.Text("Update", "अपडेट करे")</span>
            }
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
            @Lang.Text("Reset", "रीसेट")
        </MudButton>
    </MudStack>
</MudForm>
@if (_components.Any())
{
    <MudTable Items="_filteredComponents"
              SortLabel="Sort By"
              Dense="true"
              Hover="true"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Lang.Text("Components", "घटक")</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<ComponentDto, object>(x => x.ComponentName!)">@Lang.Text("Component Name (English)", "घटक का नाम (अंग्रेज़ी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<ComponentDto, object>(x => x.ComponentNameHi!)">@Lang.Text("Component Name (Hindi)", "घटक का नाम (हिंदी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<ComponentDto, object>(x => x.ComponentDescriptionEn!)">@Lang.Text("Component Description (English)", "घटक का विवरण (अंग्रेज़ी)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<ComponentDto, object>(x => x.ComponentDescriptionHi!)">@Lang.Text("Component Description (Hindi)", "घटक का विवरण (हिंदी)")</MudTableSortLabel></MudTh>
            <MudTh>@Lang.Text("Active Status", "एक्टिव स्टेटस")</MudTh>
            <MudTh>@Lang.Text("Edit", "संपादित करें")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredComponents.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("Component Name (English)", "घटक का नाम (अंग्रेज़ी)")">@context.ComponentName</MudTd>
            <MudTd DataLabel="@Lang.Text("Component Name (Hindi)", "घटक का नाम (हिंदी)")">@context.ComponentNameHi</MudTd>
            <MudTd DataLabel="@Lang.Text("Component Description (English)", "घटक का विवरण (अंग्रेज़ी)")">@context.ComponentDescriptionEn</MudTd>
            <MudTd DataLabel="@Lang.Text("Component Description (Hindi)", "घटक का विवरण (हिंदी)")">@context.ComponentDescriptionHi</MudTd>

            <MudTd DataLabel="@Lang.Text("Edit", "संपादित करें")">
                <MudStack Row="true" Spacing="1">

                    @* <MudTooltip Text="@Lang.Text("View", "देखें")">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenSchemeDialog(context))" />
                    </MudTooltip> *@
                    <MudTd DataLabel="@Lang.Text("Active Status", "एक्टिव स्टेटस")">
                        <MudSwitch T="bool"
                                   Value="@context.ComponentFlag"
                                   ValueChanged="@(newValue => ToggleFlag(context, newValue))"
                                   Color="Color.Success"
                                   Disabled="@_togglingIds.Contains(context.ComponentId)" />
                    </MudTd>
                    <MudTooltip Text="@Lang.Text("Edit", "संपादित करें")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => LoadForEdit(context))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}
@* ---------- Benefits Type List Result ---------- *@

@code {

    private List<SchemeTypeDto> _schemesTypes = new();
    private List<SchemeDto> _schemes = new();
    private List<ComponentDto> _components = new();
    private List<UnitDto> _units = new();
    private string _searchString = string.Empty;

    private int? _selectedSchemeTypeId;
    private int? _selectedComponentId;
    private int? _selectedSchemeId;
    public int? _selectedComponentUnitId { get; set; }

    public string? _ComponentNameEn { get; set; }
    public string? _ComponentNameHi { get; set; }
    public string? _ComponentDescriptionEn { get; set; }
    public string? _ComponentDescriptionHi { get; set; }

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;
    private HashSet<int> _togglingIds = new();

    private ElementReference _formTopRef;
    private MudTextField<string> _componentNameEnField = default!;

    protected override async Task OnInitializedAsync()
    {
        var schemeTypesTask = await SchemesApiService.GetSchemesTypesAsync();
        if (schemeTypesTask.IsSuccess && schemeTypesTask.Data is not null)
        {
            _schemesTypes = schemeTypesTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }

        await LoadComponents();
        await LoadUnits();
    }

    private async Task LoadUnits()
    {
        var unitsTask = await UnitsApiService.GetUnitsAsync();
        if (unitsTask.IsSuccess && unitsTask.Data is not null)
        {
            _units = unitsTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load units.",
                    "इकाइयाँ लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task OnSchemeTypeChanged(int? schemeTypeId)
    {
        _selectedSchemeTypeId = schemeTypeId;
        _selectedSchemeId = null;
        _schemes.Clear();

        if (!schemeTypeId.HasValue)
            return;

        var result =
            await SchemesApiService.GetSchemesByTypeAsync(schemeTypeId.Value);

        if (result.IsSuccess && result.Data is not null)
        {
            _schemes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load schemes.",
                    "योजनाएँ लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private IEnumerable<ComponentDto> _filteredComponents =>
        _components.Where(c =>
            string.IsNullOrWhiteSpace(_searchString)
            || (c.ComponentName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (c.ComponentNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (c.ComponentDescriptionEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (c.ComponentDescriptionHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task LoadForEdit(ComponentDto component)
    {
        _selectedSchemeTypeId = component.SchemeTypeId;

        // Populate second dropdown
        await OnSchemeTypeChanged(_selectedSchemeTypeId);

        // Select existing scheme
        _selectedSchemeId = component.SchemeId;
        _selectedComponentId = component.ComponentId;
        _selectedComponentUnitId = component.ComponentUnitId;
        _ComponentNameEn = component.ComponentName;
        _ComponentNameHi = component.ComponentNameHi;
        _ComponentDescriptionEn = component.ComponentDescriptionEn;
        _ComponentDescriptionHi = component.ComponentDescriptionHi;

        if (Form is not null)
            await Form.ResetValidationAsync();

        await JS.InvokeVoidAsync("scrollAndFocus", _formTopRef);

        await _componentNameEnField.FocusAsync();
    }

    private async Task LoadComponents()
    {
        var componentsTask = await ComponentsApiService.GetComponentsListAsync();
        if (componentsTask.IsSuccess && componentsTask.Data is not null)
        {
            _components = componentsTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load components.",
                    "घटक लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task SaveComponent()
    {
        await Form!.ValidateAsync();

        if (!Form.IsValid)
            return;

        _isLoading = true;

        try
        {
            var dto = new AddComponentDto
            {
                SchemeId = _selectedSchemeId,
                ComponentId = _selectedComponentId,
                ComponentUnitId = _selectedComponentUnitId,
                ComponentNameEn = _ComponentNameEn!,
                ComponentNameHi = _ComponentNameHi!,
                ComponentDescriptionHi = _ComponentDescriptionHi!,
                ComponentDescriptionEn = _ComponentDescriptionEn!
            };

            var result = _selectedComponentId is null
                ? await ComponentsApiService.SaveComponentAsync(dto)
                : await ComponentsApiService.UpdateComponentAsync(dto);

            if (result.IsSuccess)
            {
                Snackbar.Add(
                    Lang.Text(
                        "Component saved successfully.",
                        "घटक सफलतापूर्वक सुरक्षित किया गया।"),
                    Severity.Success);

                await Reset();
                await LoadComponents();
            }
            else
            {
                Snackbar.Add(
                    result.Error ??
                    Lang.Text(
                        "Failed to save component.",
                        "घटक सुरक्षित करने में विफल।"),
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);

            Snackbar.Add(
                Lang.Text(
                    "Failed to save component.",
                    "घटक सुरक्षित करने में विफल।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFlag(ComponentDto benefit, bool newValue)
    {
        _togglingIds.Add(benefit.ComponentId);
        var previousValue = benefit.ComponentFlag;
        benefit.ComponentFlag = newValue; // optimistic UI update

        try
        {
            var result = await ComponentsApiService.UpdateComponentActiveFlagAsync(benefit.ComponentId, newValue);

            if (!result.IsSuccess)
            {
                benefit.ComponentFlag = previousValue; // revert on failure
                Snackbar.Add(result.Error ?? Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
            }
            else
            {
                Snackbar.Add(
                    newValue
                        ? Lang.Text("Component activated.", "घटक सक्रिय किया गया।")
                        : Lang.Text("Component deactivated.", "घटक निष्क्रिय किया गया।"),
                    Severity.Success);
            }
        }
        catch
        {
            benefit.ComponentFlag = previousValue;
            Snackbar.Add(Lang.Text("Failed to update status.", "स्थिति अपडेट करने में विफल।"), Severity.Error);
        }
        finally
        {
            _togglingIds.Remove(benefit.ComponentId);
        }
    }

    private async Task Reset()
    {
        _selectedSchemeId = null;
        _selectedSchemeTypeId = null;
        _selectedComponentId = null;
        _selectedComponentUnitId = null;

        _schemes.Clear();
        _units.Clear();

        _ComponentNameEn = null;
        _ComponentNameHi = null;
        _ComponentDescriptionEn = null;
        _ComponentDescriptionHi = null;

        if (Form is not null)
            await Form.ResetValidationAsync();
    }
}