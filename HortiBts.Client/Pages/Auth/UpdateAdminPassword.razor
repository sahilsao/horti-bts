@page "/admin/update-password"
@using HortiBts.Client.Pages.Auth.Models
@using HortiBts.Client.Services.Auth
@using HortiBts.Shared.Enums.Auth
@layout EmptyLayout
@inject IDialogService DialogService
@inject AuthApiService AuthService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Admin")]
@inherits AppComponentBase

<PageTitle>@Lang.Text("Update Admin Password", "एडमिन पासवर्ड बदलें")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center mt-6">

    <MudPaper Elevation=" 4" Class="pa-8 rounded-lg" Style="width:100%;">
        <EditForm Model="@_model" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Style="font-size:3.5rem;" />
                <MudText Typo="Typo.h5" Color="Color.Primary" Align="Align.Center">
                    @Lang.Text("Update Admin Password", "एडमिन पासवर्ड बदलें")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    @Lang.Text("Please change your admin password to continue.",
                               "जारी रखने के लिए कृपया अपना एडमिन पासवर्ड बदलें।")
                </MudText>
            </MudStack>

            <MudTextField Label="@Lang.Text("Current Password", "वर्तमान पासवर्ड")" @bind-Value="_model.CurrentPassword"
                          InputType="@(_showCurrent ? InputType.Text : InputType.Password)" Variant="Variant.Outlined"
                          FullWidth="true" Class="mb-1" Adornment="Adornment.End"
                          AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showCurrent = !_showCurrent)" />
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-3">
                <ValidationMessage For="@(() => _model.CurrentPassword)" />
            </MudText>

            <MudTextField Label="@Lang.Text("New Password", "नया पासवर्ड")" Value="_model.NewPassword"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)" Variant="Variant.Outlined" FullWidth="true"
                          Class="mb-1" Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showNew = !_showNew)"
                          ValueChanged="@((string val) => OnNewPasswordChanged(val))" />
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-1">
                <ValidationMessage For="@(() => _model.NewPassword)" />
            </MudText>

            @if (!string.IsNullOrEmpty(_model.NewPassword))
            {
                <MudProgressLinear Color="@_strengthColor" Value="@_strengthValue" Class="mb-1" Rounded="true"
                                   Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="@_strengthColor" Class="mb-3">
                    @_strengthLabel
                </MudText>
            }

            <MudTextField Label="@Lang.Text("Confirm New Password", "नया पासवर्ड दोबारा दर्ज करें")"
                          @bind-Value="_model.ConfirmPassword" InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Variant="Variant.Outlined" FullWidth="true" Class="mb-1" Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-4">
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </MudText>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ResetForm">
                    @Lang.Text("Reset", "रीसेट करें")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.Save">
                    @Lang.Text("Update Password", "पासवर्ड अपडेट करें")
                </MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>
</MudContainer>
<MudSpacer />
@code {
    private PasswordModel _model = new();

    private bool _showCurrent = false;
    private bool _showNew = false;
    private bool _showConfirm = false;

    private int _strengthValue = 0;
    private Color _strengthColor = Color.Error;
    private string _strengthLabel = string.Empty;

    private void OnNewPasswordChanged(string value)
    {
        _model.NewPassword = value;
        CalculateStrength(value);
    }

    private void CalculateStrength(string pwd)
    {
        if (string.IsNullOrEmpty(pwd))
        {
            _strengthValue = 0;
            _strengthLabel = string.Empty;
            return;
        }

        int score = 0;
        if (pwd.Length >= 8) score++;
        if (pwd.Any(char.IsUpper)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(c => !char.IsLetterOrDigit(c))) score++;

        (_strengthValue, _strengthColor, _strengthLabel) = score switch
        {
            1 => (25, Color.Error, Lang.Text("Weak", "कमज़ोर")),
            2 => (50, Color.Warning, Lang.Text("Fair", "ठीक है")),
            3 => (75, Color.Info, Lang.Text("Good", "अच्छा")),
            4 => (100, Color.Success, Lang.Text("Strong", "मज़बूत")),
            _ => (0, Color.Error, string.Empty)
        };
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Lang.Text("Confirm", "पुष्टि करें"),
            Lang.Text("Are you sure you want to update your password?",
                      "क्या आप पासवर्ड अपडेट करना चाहते हैं?"),
            yesText: Lang.Text("Yes, Update", "हाँ, अपडेट करें"),
            cancelText: Lang.Text("Cancel", "रद्द करें"));

        if (confirmed != true) return;

        try
        {
            var result = await AuthService.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error ?? Lang.Text("Failed to update password.", "पासवर्ड अपडेट करने में विफल।"), Severity.Error);
                return;
            }

            switch (result.Data)
            {
                case PasswordUpdateResult.Success:
                    Snackbar.Add(
                        Lang.Text("Password updated successfully!", "पासवर्ड सफलतापूर्वक अपडेट किया गया!"),
                        Severity.Success);
                    ResetForm();
                    break;

                case PasswordUpdateResult.WrongCurrentPassword:
                    Snackbar.Add(
                        Lang.Text("Current password is incorrect.", "वर्तमान पासवर्ड गलत है।"),
                        Severity.Error);
                    break;

                case PasswordUpdateResult.UserNotFound:
                    Snackbar.Add(
                        Lang.Text("User not found.", "उपयोगकर्ता नहीं मिला।"),
                        Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBoxAsync(
                Lang.Text("Error", "त्रुटि"),
                ex.Message,
                yesText: "OK");
        }
        finally
        {
            await AuthService.LogoutAsync();
        }
    }

    private void ResetForm()
    {
        _model = new PasswordModel();
        _strengthValue = 0;
        _strengthLabel = string.Empty;
        _showCurrent = false;
        _showNew = false;
        _showConfirm = false;
    }
}