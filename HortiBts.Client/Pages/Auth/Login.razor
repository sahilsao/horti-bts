@page "/login"

@using HortiBts.Shared.Enums.Auth
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Client.Shared
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Pages.Auth.Models
@using HortiBts.Client.MultiLanguage
@inject DistrictsApiService DistrictsService
@inject AuthApiService AuthService
@inject LoginHistoryApiService LoginHistoryService
@inject NavigationManager Nav

@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inherits AppComponentBase
@layout EmptyLayout

<PageTitle>@Lang.Text("Login", "लॉगिन")</PageTitle>
<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height:calc(100vh - 64px);">
    <MudGrid Justify="Justify.FlexEnd">
        @* <MudHidden Breakpoint="Breakpoint.Lg" Invert="true">
            <MudItem sm="5" Class="ml-15 mt-10">
                <MudImage Src="images/illustrations/login.svg"
                          Alt="Background"
                          Width="400"
                          Fluid="true" />
            </MudItem>
        </MudHidden> *@
        <MudSpacer />
        <MudItem xs="12" sm="5">
            <MudChip T="string" Color="Color.Primary" Class="mb-2">
                @Lang.Text("Chhattisgarh Horticulture Beneficiary Tracking System", "छत्तीसगढ़ हॉर्टिकल्चर बेनेफिशियरी ट्रैकिंग सिस्टम")
            </MudChip>
            <MudCard>
                <MudCardContent>
                    <EditForm Model="@_loginModel" OnValidSubmit="Authenticate" OnInvalidSubmit="FormInvalid">
                        <DataAnnotationsValidator />
                        <MudRadioGroup T="LoginType"
                                       Value="_loginModel.LoginType" ValueChanged="OnLoginTypeChanged"
                                       Class="mb-4">

                            <MudRadio Value="@LoginType.Admin" Color="Color.Primary">
                                @Lang.Text("Admin", "एडमिन")
                            </MudRadio>

                            <MudRadio Value="@LoginType.District" Color="Color.Primary">
                                @Lang.Text("District/Office", "जिला/कार्यालय")
                            </MudRadio>

                            <MudRadio Value="@LoginType.Rheo" Color="Color.Primary">
                                @Lang.Text(
                                    "Rural Horticulture Extension Officer / Horticulture Extension Officer / Senior Horticulture Extension Officer",
                                    "ग्रामीण उद्यान विस्तार अधिकारी/उद्यान विस्तार अधिकारी/वरिष्ठ उद्यान विस्तार अधिकारी")
                            </MudRadio>

                        </MudRadioGroup>

                        @if (_loginModel.LoginType == LoginType.District)
                        {
                            <MudSelect T="int?" Label="जिला चुने" Placeholder="--जिला चुने--"
                                       Value="_selectedDistrictCensus" ValueChanged="OnDistrictChanged"
                                       Variant="Variant.Outlined" FullWidth="true" Class="mb-3">
                                @foreach (var d in _districts)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                                        @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }

                        @if (_loginModel.LoginType == LoginType.Rheo)
                        {
                            <MudTextField Label="@Lang.Text("User Id", "यूजर आईडी")"
                                          Variant="Variant.Outlined"
                                          InputType="@_UserIdInput"
                                          Placeholder=@Lang.Text("Enter User Id", "यूजर आईडी दर्ज करें")
                                          @bind-Value="_loginModel.UserId"
                                          Required
                                          For="@(()=>_loginModel.UserId)"
                                          Class="mb-3" />
                        }

                        <MudTextField Label=@Lang.Text("Password", "पासवर्ड")
                                      @bind-Value="_loginModel.Password"
                                      For="@(() => _loginModel.Password)"
                                      InputType="@_passwordInput"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@_passwordInputIcon"
                                      OnAdornmentClick="ToggleVisibility"
                                      Placeholder=@Lang.Text("Enter Password", "पासवर्ड दर्ज करें")
                                      Required />

                        <Captcha @bind-CaptchaText="_captchaWord" Length="6" />

                        <MudTextField Label=@Lang.Text("Captcha", "कैप्चा")
                                      @bind-Value="_captchaInput"
                                      FullWidth
                                      Required
                                      Error="@_captchaError"
                                      ErrorText=@Lang.Text("Incorrect Captcha", "गलत कैप्चा।")
                                      Placeholder=@Lang.Text("Enter Captcha", "कैप्चा दर्ज करें")
                                      MaxLength="6" Class="mb-4"
                                      HelperText=@Lang.Text("Case Sensitive: Match capital and small letters accurately", "केस-संवेदनशील: बड़े और छोटे अक्षरों को सटीक रूप से मिलाएं") />

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>@Lang.Text("Login Processing", "लॉग इन हो रहा है...")</span>
                            }
                            else
                            {
                                <span>@Lang.Text("Login", "लॉगिन करे")</span>
                            }
                        </MudButton>
                        <MudButton OnClick="Reload" Variant="Variant.Filled" Color="Color.Error">
                            @Lang.Text("Reset", "रिसेट")
                        </MudButton>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private LoginModel _loginModel = new();
    private InputType _UserIdInput = InputType.Text;
    private InputType _passwordInput = InputType.Password;
    private List<DistrictsDto> _districts = [];
    private string _captchaWord = string.Empty;
    private string _captchaInput = string.Empty;
    private bool _captchaError = false;
    private bool _isLoading = false;
    private bool _isShow = false;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private int? _selectedDistrictCensus;

    protected override async Task OnInitializedAsync()
    {
        _loginModel.LoginType = LoginType.Admin;

        var result = await DistrictsService.GetDistrictsAsync();
        if (result.IsSuccess)
            _districts = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts.", "जिले लोड करने में विफल।"), Severity.Warning);
    }


    private void OnDistrictChanged(int? value)
    {
        _selectedDistrictCensus = value;
        _loginModel.UserId = value?.ToString() ?? string.Empty; // matches Angular's user_id = district_code before submit
    }

    private void ToggleVisibility()
    {
        if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    private LoginType _previousLoginType = LoginType.Admin;

    private void OnLoginTypeChanged(LoginType value)
    {
        if (_previousLoginType != value)
        {
            _loginModel.UserId = string.Empty;
            _loginModel.Password = string.Empty;
            _selectedDistrictCensus = null;
        }

        _loginModel.LoginType = value;

        _previousLoginType = value;

        StateHasChanged();
    }

    private void OnDistrictChanged(string value)
    {
        _loginModel.UserId = value;
    }

    private void FormInvalid(EditContext context)
    {
        foreach (var message in context.GetValidationMessages())
        {
            Snackbar.Add(message, Severity.Error);
        }
    }

    private async Task Authenticate()
    {
        _captchaError = false;

        if (!_captchaInput.Equals(_captchaWord, StringComparison.Ordinal))
        {
            _captchaError = true;
            Snackbar.Add(Lang.Text("Incorrect Captcha!", "गलत कैप्चा!"), Severity.Info);
            return;
        }

        if (_isLoading) return;
        _isLoading = true;

        try
        {
            if (_loginModel.LoginType == LoginType.Admin)
            {
                _loginModel.UserId = "100";
            }

            if (_loginModel.LoginType == LoginType.Rheo && string.IsNullOrWhiteSpace(_loginModel.UserId))
            {
                Snackbar.Add("User ID is required.", Severity.Error);
                return;
            }

            if (_loginModel.LoginType == LoginType.District && string.IsNullOrWhiteSpace(_loginModel.UserId))
            {
                Snackbar.Add("Please select a district.", Severity.Error);
                return;
            }

            // Check existing login
            var loginCheck = await LoginHistoryService.IsAlreadyLoggedInAsync(
                int.Parse(_loginModel.UserId!));

            if (loginCheck.IsSuccess && loginCheck.Data)
            {
                bool? confirm = await DialogService.ShowMessageBoxAsync(
                                 Lang.Text("Already Logged In", "उपयोगकर्ता पहले से लॉगिन है"),
                                 Lang.Text(
                                     "This user is already logged in from another device.\n\nDo you want to logout the previous session and continue?",
                                     "यह उपयोगकर्ता किसी अन्य डिवाइस पर पहले से लॉगिन है।\n\nक्या आप पिछले लॉगिन सत्र को समाप्त करके आगे लॉगिन करना चाहते हैं?"
                                 ),
                                 yesText: Lang.Text("Yes", "हाँ"),
                                 cancelText: Lang.Text("No", "नहीं"));

                if (confirm != true)
                    return;

                var active = await LoginHistoryService.GetActiveLoginAsync(
                    int.Parse(_loginModel.UserId),
                    _loginModel.LoginType switch
                    {
                        LoginType.Admin => "13",
                        LoginType.District => "14",
                        LoginType.Rheo => "12",
                        _ => ""
                    });

                if (active.IsSuccess)
                {
                    await LoginHistoryService.LogoutAsync(active.Data!.LoginHistoryId);
                }
            }

            //login
            var result = await AuthService.LoginAsync(
                _loginModel.LoginType,
                _loginModel.UserId!,
                _loginModel.Password!);

            if (!result.IsSuccess)
            {
                Snackbar.Add(Lang.Text("Invalid User ID or Password!", "अमान्य यूजर आईडी या पासवर्ड!"), Severity.Error);
                return;
            }

            if (!result.Data!.PasswordFlag)
            {
                Nav.NavigateTo("change-password");
                return;
            }

            switch (result.Data.UserType)
            {
                case 13://admin
                    Nav.NavigateTo("/admin/dashboard");
                    break;

                case 14://district
                    Nav.NavigateTo("/district/dashboard");
                    break;

                case 12:
                    Nav.NavigateTo("/rheo/dashboard");
                    break;

                default:
                    Nav.NavigateTo("/not-found");
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Lang.Text("Login Failed!", "लॉगिन विफल!")} {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Reload()
    {
        _captchaInput = string.Empty;
        Nav.NavigateTo("login", true);
    }
}
