    private async Task LoadRHEOMappedVillage(RheoOfficersDto component)
    {
        try
        {
            var result = await OfficersApiService.GetRheoOfficerMappedVillagesListAsync(3, component.OfficerCode!.Value);

            if (result.IsSuccess && result.Data is not null && result.Data.Any())
            {
                _reportMappedData = result.Data;
                _reportData.Clear();
            }
            else if (result.IsSuccess)
            {
                _reportMappedData = [];
                Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
            }
            else
            {
                Snackbar.Add(Lang.Text("Failed to load report data.", "रिपोर्ट डेटा लोड करने में विफल।"), Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Lang.Text("An error occurred while loading the report.", "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
    Severity.Error);
        }
    }

    private async Task ExportToExcelMappedData()
    {
        await ExcelExport.ExportAsync(
             _filteredMappedReportData.ToList(),
             GetMappedDataColumns(),
             Lang.Text("List of Villages Mapped into RHEO", "RHEO में मैप किए गए गाँव की सूची"),
             (en, hi) => Lang.Text(en, hi),
             $"RHEOListMappedByVillage.xlsx");
    }
