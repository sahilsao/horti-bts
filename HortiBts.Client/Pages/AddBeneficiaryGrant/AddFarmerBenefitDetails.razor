@page "/district/add-farmer-benefit-details/{ApplicationId:int}/{FinancialYear:int}"
@attribute [Authorize(Roles = "District")]

@using HortiBts.Client.Services.AddBeneficiaryGrant
@using HortiBts.Client.Services.Benefits
@using HortiBts.Shared.Dtos.AddBeneficiaryGrant
@using HortiBts.Shared.Dtos.Benefits
@using MudBlazor.Extensions
@inject ApprovedApplicationsWithNoAddedBenefitsApiService ApprovedApplicationsWithNoAddedBenefitsApiService
@inject ISnackbar Snackbar
@inject BenefitsApiService BenefitsApiService

<PageTitle>@Lang.Text("Add beneficiary grant (2026-27)", "लाभार्थी अनुदान जोड़ें (2026-27)")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/send_money" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Add beneficiary grant (2026-27)", "लाभार्थी अनुदान जोड़ें (2026-27)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("add Beneficiary grant to approved applications", "स्वीकृत आवेदनों में लाभार्थी अनुदान जोड़ें।")
</MudText>

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

@if (_reportData.Any())
{
    <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-4 mb-3">
        @Lang.Text("Scheme Details", "योजना का विवरण")
    </MudText>

    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-3">
        @Lang.Text(
            "Details of the benefits to be availed by the farmer under the government scheme.",
            "कृषक द्वारा शासकीय योजना के अंतर्गत लिए जाने वाले लाभ का विवरण।")
    </MudText>

    @foreach (var item in _reportData)
    {
        <MudPaper Elevation="1" Outlined="true" Class="pa-4 mt-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @Lang.Text("Application Number", "आवेदन क्रमांक")
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        @item.ApplicationId
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @Lang.Text("Area", "रकबा")
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        @item.Area?.ToString("N2") @Lang.Text("Hectare", "हेक्टेयर")
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @Lang.Text("Mobile Number", "मोबाइल नंबर")
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                        @item.MobileNo
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="_reportData" SortLabel="Sort By" Bordered="true" HeaderClass="report-header-row" Dense="true"
                  Hover="true" Elevation="1" Class="mt-4">
            <HeaderContent>
                <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.VillageName!)">
                        @Lang.Text("Village Name", "ग्राम का नाम")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.SchemeType!)">
                        @Lang.Text("Scheme Type", "योजना का प्रकार")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.SchemeName!)">
                        @Lang.Text("Scheme", "योजना")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.ComponentName!)">
                        @Lang.Text("Component", "घटक")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.KhasraNo!)">
                        @Lang.Text("Khasra number", "खसरा नंबर")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.Area!)">
                        @Lang.Text("Area (selected area) (in hectares)", "रकबा (चयनित रकबा) (हेक्ट. में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.Area!)">
                        @Lang.Text("Area (selected area) (in acres)", "रकबा (चयनित रकबा) (एकड़ में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel
                        SortBy="new Func<ApprovedApplicationsWithNoAddedBenefitsByDistrictCodeDto, object>(x => x.Quantity!)">
                        @Lang.Text("Quantity (optional)", "संख्या (वैकल्पिक)")
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_reportData.ToList().IndexOf(context) + 1)</MudTd>
                <MudTd DataLabel="@Lang.Text("Village Name", "ग्राम का नाम")"> @context.VillageName </MudTd>
                <MudTd DataLabel="@Lang.Text("Scheme Type", "योजना का प्रकार")">@context.SchemeTypeName</MudTd>
                <MudTd DataLabel="@Lang.Text("Scheme", "योजना")">@context.SchemeName</MudTd>
                <MudTd DataLabel="@Lang.Text("Component", "घटक")">@context.ComponentName</MudTd>
                <MudTd DataLabel="@Lang.Text("Khasra number", "खसरा नंबर")">@context.KhasraNo</MudTd>
                <MudTd DataLabel="@Lang.Text("Area (selected area) (in hectares)", "रकबा (चयनित रकबा) (हेक्ट. में)")">
                    @context.Area?.ToString("N2")
                </MudTd>
                <MudTd DataLabel="@Lang.Text("Area (selected area) (in acres)", "रकबा (चयनित रकबा) (एकड़ में)")">
                    @((context.Area * 2.47105m)?.ToString("N2"))
                </MudTd>
                <MudTd DataLabel="@Lang.Text("Quantity (optional)", "संख्या (वैकल्पिक)")">@context.Quantity</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
                <MudTd><b>@_reportData.Sum(x => x.Area)?.ToString("N2")</b></MudTd>
                <MudTd><b>@_reportData.Sum(x => x.Area * 2.47105m)?.ToString("N2")</b></MudTd>
                <MudTd><b>@_reportData.Sum(x => x.Quantity)</b></MudTd>
            </FooterContent>
        </MudTable>
    }

    <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-4 mb-3">
        @Lang.Text("Benefit Details", "अनुदान विवरण")
    </MudText>

    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-3">
        @Lang.Text(
            "Secure the grant amount for the approved application.",
            "स्वीकृत आवेदन का अनुदान राशि सुरक्षित करें।")
    </MudText>

    <MudForm @ref="_form" Model="@this">
        <MudPaper Outlined="true" Class="pa-4">
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_area" Format="N2" Immediate="true"
                                     Label="@Lang.Text("Area", "रकबा")" Variant="Variant.Outlined"
                                     Required="true" RequiredError="@Lang.Text("Area is required.", "रकबा भरना अनिवार्य है|")" Min="0" />

                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_itemNumber" Immediate="true"
                                     Label="@Lang.Text("Item Number (if any)", "सामग्री संख्या (यदि कोई हो)")" Variant="Variant.Outlined"
                                     Required="true" RequiredError="@Lang.Text("Item Number is required.", "सामग्री भरना अनिवार्य है|")" Min="0" />

                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect T="int" Label="@Lang.Text("Benefit", "लाभ")" Variant="Variant.Outlined" MultiSelection="true"
                               @bind-SelectedValues="_selectedBenefitIds" ToStringFunc="@GetBenefitName"
                               MultiSelectionTextFunc="@GetSelectedBenefitText" Required="true" Clearable="true"
                               RequiredError="@Lang.Text("Select a benefit.", "लाभ चुनना अनिवार्य है |")">
                        @foreach (var b in _benefits)
                        {
                            <MudSelectItem T="int" Value="@b.BenefitId">@b.BenefitNameHi</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_totalCostAmount" Format="N2" Immediate="true"
                                     Label="@Lang.Text("Total Cost Amount", "कुल लागत राशि")" Variant="Variant.Outlined"
                                     Required="true" RequiredError="@Lang.Text("Total Cost Amount is required.", "कुल लागत राशि भरना अनिवार्य है|")"
                                     Min="0" />

                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_totalSubsidyAmount" Format="N2" Immediate="true"
                                     Label="@Lang.Text("Total Subsidy Amount", "कुल अनुदान राशि")" Variant="Variant.Outlined"
                                     Required="true" RequiredError="@Lang.Text("Total Subsidy Amount is required.", "कुल अनुदान राशि भरना अनिवार्य है|")"
                                     Min="0" />

                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="@Lang.Text("Remarks", "टिप्पणी")" Variant="Variant.Outlined"
                                  @bind-Value="_remarks" Lines="3" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveBenefit" Disabled="_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@Lang.Text("Saving...", "सुरक्षित हो रहा है...")</span>
                    }
                    else
                    {
                        <span>@Lang.Text("Save", "सुरक्षित करे")</span>
                    }
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
                    @Lang.Text("Reset", "रीसेट")
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudForm>
}

@code {
    
    [Parameter]
    public int ApplicationId { get; set; }

    [Parameter]
    public int FinancialYear { get; set; }
    private List<BenefitsListDto> _benefits = new();
    private List<ApprovedApplicationsWithNoAddedBenefitsByApplicationIdDto> _reportData = new();
    private bool _isLoading = false;
    private MudForm? _form;
    private decimal? _area { get; set; }
    private decimal? _itemNumber { get; set; }
    private decimal? _totalCostAmount { get; set; }
    private decimal? _totalSubsidyAmount { get; set; }
    private string? _remarks { get; set; }
    private IReadOnlyCollection<int> _selectedBenefitIds = [];
    
    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
        await LoadBenefits();
        if (_reportData.Count > 0)
        {
            await LoadForEdit(_reportData[0]);
        }
    }
    private async Task LoadReport()
    {
        _isLoading = true;

        try
        {
            
            var result =
             await
                ApprovedApplicationsWithNoAddedBenefitsApiService.GetApprovedApplicationsWithNoAddedBenefitsByApplicationIdsync(ApplicationId,
                FinancialYear);

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    _reportData = result.Data;
                  
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBenefits()
    {
        var result = await BenefitsApiService.GetBenefitsListAsync();
        if (result.IsSuccess && result.Data is not null)
            _benefits = result.Data.Where(b => b.BenefitTypeId == 1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load benefits list.", "लाभ सूची लोड करने में विफल।"), Severity.Error);
    }

    private string GetBenefitName(int id)
    => _benefits.FirstOrDefault(b => b.BenefitId == id)?.BenefitNameHi?.Trim() ?? id.ToString();

    private string GetSelectedBenefitText(IReadOnlyList<string> selectedTexts)
        => string.Join(", ", selectedTexts);

    private async Task SaveBenefit()
    {
        await Form!.ValidateAsync();
        if (!Form.IsValid)
            return;

        _isLoading = true;
        try
        {
            @* // call your actual save API here, e.g.:
            var result = await BenefitsApiService.SaveBenefitAsync(new AddBenefitDto
            {
                BenefitId = _selectedBenefitId,
                BenefitTypeId = _selectedBenefitTypeId!.Value,
                BenefitNameEn = _BenefitNameEn!,
                BenefitNameHi = _BenefitNameHi!
            });

            if (result.IsSuccess)
            {
                Snackbar.Add(Lang.Text("Benefit saved successfully.", "लाभ सफलतापूर्वक सुरक्षित किया गया।"), Severity.Success);
                Reset();
                await LoadReport();
            }
            else
            {
                Snackbar.Add(result.Error ?? Lang.Text("Failed to save benefit.", "लाभ सुरक्षित करने में विफल।"), Severity.Error);
            } *@
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to save benefit.", "लाभ सुरक्षित करने में विफल।"), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _area = null;
        _itemNumber = null;
        _selectedBenefitIds = new HashSet<int>();
        if (_form is not null)
        {
            await _form.ResetAsync(); // clears values and validation state
        }
    }

    private async Task LoadForEdit(ApprovedApplicationsWithNoAddedBenefitsByApplicationIdDto _reportData)
    {
        _area = _reportData.Area;
        Form?.ResetValidationAsync();
    }
}
