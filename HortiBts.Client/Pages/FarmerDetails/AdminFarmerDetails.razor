@page "/admin/farmers-details"
@using HortiBts.Shared.Dtos.Farmers
@using HortiBts.Client.Services.Farmers

@inject FarmersDetailsApiService FarmersDetailsApiService
@inject ISnackbar Snackbar

@code {

    private List<FarmerBasicDetailsDto> _farmerBasicDetails = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await FarmersDetailsApiService.GetBasicDetailsAsync("1064302");

        if (result.IsSuccess && result.Data is not null)
        {   
            _farmerBasicDetails = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load farmer basic details.",
                    "किसान के मूल विवरण लोड करने में विफल।"),
                Severity.Warning);
        }
    }


}
