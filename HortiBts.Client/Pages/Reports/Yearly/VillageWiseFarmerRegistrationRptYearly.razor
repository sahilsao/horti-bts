@page "/reports/yearly/villagewise-farmer-registration-report"
@page "/reports/yearly/villagewise-farmer-registration-report/{DistrictCode:int}/{SubDistrictCode:int}/{OfficerCode:int}/{FinancialYear:int}"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.SubDistricts
@using HortiBts.Client.Services.Officers
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Reports.Yearly
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Reports
@using HortiBts.Shared.Dtos.SubDistricts
@using HortiBts.Shared.Dtos.Officers
@attribute [Authorize(Roles = "Admin")]

@inject DistrictsApiService DistrictsApiService
@inject SubDistrictsApiService SubDistrictsApiService
@inject OfficersApiService OfficersApiService
@inject FinancialYearsApiService FinancialYearsApiService
@inject YearlyFarmerRegistrationApiService YearlyFarmerRegistrationApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Lang.Text("Village-wise Farmer Registration Report (Yearly)", "ग्राम-वार कृषक पंजीयन रिपोर्ट (वार्षिक)")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/clarify" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Village-wise Farmer Registration Report (Yearly)", "ग्राम-वार कृषक पंजीयन रिपोर्ट (वार्षिक)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for Village-wise Farmer Registration (Yearly)", "ग्राम-वार कृषक पंजीयन रिपोर्ट (वार्षिक)")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedDistrictCensus"
                   Label="@Lang.Text("District", "जिला")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnDistrictChanged">

            @foreach (var d in _districts)
            {
                <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                    @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedSubDistrictCode"
                   Label="@Lang.Text("Block", "विकासखण्ड")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnSubDistrictChanged">

            @foreach (var s in _subdistricts)
            {
                <MudSelectItem T="int?" Value="@((int?)s.SubDistrictCode)">
                    @(Lang.IsHindi ? s.SubDistrictNameHi : s.SubDistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   @bind-Value="_selectedOfficerCode"
                   Label="@Lang.Text("Officer", "अधिकारी")"
                   Variant="Variant.Outlined">

            @foreach (var o in _officers)
            {
                <MudSelectItem T="int?" Value="@((int?)o.OfficerCode)">
                    @o.OfficerName
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               OnClick="LoadReport"
               Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करें")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudTable Items="_filteredReportData"
              SortLabel="Sort By"
              Dense="true"
              Hover="true"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("Village-wise Farmer Registration Report (Yearly)", "ग्राम-वार कृषक पंजीयन रिपोर्ट (वार्षिक)")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.VillageName!)">@Lang.Text("Village Name", "ग्राम का नाम")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.OfficerName!)">@Lang.Text("Officer Name", "अधिकारी का नाम")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.FarmerCount!)">@Lang.Text("Farmer Count", "कृषक संख्या")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.SchemeCount!)">@Lang.Text("Applications Count", "आवेदन संख्या")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.Area!)">@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<VillageWiseFarmerRegistrationDto, object>(x => x.Subsidy!)">@Lang.Text("Subsidy Amount", "अनुदान राशि")</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("Village Name", "ग्राम का नाम")">
                <MudLink Href="@($"/reports/yearly/farmerwise-farmer-registration-report/{3}/{context.DistrictCode!.Value}/{context.SubDistrictCode!.Value}/{context.VillageCode}/{context.OfficerCode!.Value}/{_selectedFinancialYear!.Value}/{0}/{0}/{0}")"                         
                           Color="Color.Info">
                    @context.VillageName
                </MudLink>
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Officer Name", "अधिकारी का नाम")">@context.OfficerName</MudTd>
            <MudTd DataLabel="@Lang.Text("Farmer Count", "कृषक संख्या")">@context.FarmerCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.SchemeCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")">@context.Area?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.Subsidy?.ToString("N2")</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.FarmerCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.SchemeCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.Area ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
            <MudTd><b>₹@_filteredReportData.Sum(x => x.Subsidy ?? 0).ToString("N2")</b></MudTd>
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}
@code {

    private List<DistrictsDto> _districts = [];
    private List<SubDistrictsDto> _subdistricts = [];
    private List<FinancialYearDto> _finyears = [];
    private List<RheoOfficersDto> _officers = [];
    private int? _selectedFinancialYear;
    private int? _selectedDistrictCensus;
    private int? _selectedSubDistrictCode;
    private int? _selectedOfficerCode;

    [Parameter]
    public int DistrictCode { get; set; }
    [Parameter]
    public int SubDistrictCode { get; set; }
    [Parameter]
    public int OfficerCode { get; set; }
    [Parameter]
    public int FinancialYear { get; set; }

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<VillageWiseFarmerRegistrationDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDistrictsAsync();
        await LoadFinancialYearsAsync();

        if (DistrictCode > 0 && SubDistrictCode > 0 && OfficerCode > 0 && FinancialYear > 0)
        {

            _selectedDistrictCensus = DistrictCode;
            await OnDistrictChanged(_selectedDistrictCensus);

            _selectedSubDistrictCode = SubDistrictCode;

            _selectedOfficerCode = OfficerCode;

            await OnSubDistrictChanged(_selectedSubDistrictCode);

            _selectedOfficerCode = OfficerCode;

            _selectedFinancialYear = FinancialYear;

            await LoadReport();
        }
    }

    private async Task LoadDistrictsAsync()
    {
        var result = await DistrictsApiService.GetDistrictsAsync();
        if (result.IsSuccess)
            _districts = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts.", "जिले लोड करने में विफल।"), Severity.Warning);
    }

    private async Task OnDistrictChanged(int? districtId)
    {
        _selectedDistrictCensus = districtId;

        // reset everything that depends on district
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _subdistricts.Clear();
        _officers.Clear();

        if (districtId is null) return;

        try
        {
            var result = await SubDistrictsApiService.GetSubDistrictsAsync(districtId.Value);
            if (result.IsSuccess && result.Data is not null)
                _subdistricts = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load subdistricts.", "उपजिलों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task OnSubDistrictChanged(int? subDistrictCode)
    {
        _selectedSubDistrictCode = subDistrictCode;

        // reset everything that depends on sub-district
        _selectedOfficerCode = null;
        _officers.Clear();

        if (subDistrictCode is null) return;

        try
        {
            int departmentCode = 3;
            var result = await OfficersApiService.GetRheoOfficersListFromSubdistrictCodeAsync(departmentCode, subDistrictCode.Value);
            if (result.IsSuccess && result.Data is not null)
                _officers = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load officers.", "अधिकारियों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data;
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        if (_selectedDistrictCensus is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a district.",
                    "कृपया एक जिला चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedSubDistrictCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a block.",
                    "कृपया एक ब्लॉक चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedSubDistrictCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a block.",
                    "कृपया एक ब्लॉक चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedOfficerCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select an officer.",
                    "कृपया एक अधिकारी चुनें।"),
                Severity.Warning);
            return;
        }

        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var result =
                await YearlyFarmerRegistrationApiService
                    .GetVillageWiseFarmerRegistrationListAsync(
                        _selectedOfficerCode!.Value,
                        _selectedFinancialYear!.Value);

            if (result.IsSuccess && result.Data is not null)
            {
                _reportData = result.Data;
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }     

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedDistrictCensus = null;
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _subdistricts.Clear();
        _officers.Clear();
        _reportData.Clear();

        Navigation.NavigateTo(
                "/reports/yearly/villagewise-farmer-registration-report",
                replace: true);
    }

    private IEnumerable<VillageWiseFarmerRegistrationDto> _filteredReportData =>
            _reportData.Where(t =>
                string.IsNullOrWhiteSpace(_searchString)
                || (t.VillageName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.FarmerCount.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.SchemeCount.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Subsidy.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.Area.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));
}