@page "/reports/applications/previous/approved-farmers-applications-list"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Officers
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Reports.PreviousFY.Applications
@using HortiBts.Client.Services.Schemes
@using HortiBts.Client.Services.SubDistricts
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Officers
@using HortiBts.Shared.Dtos.Reports.PreviousFY.Applications
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Dtos.SubDistricts
@attribute [Authorize(Roles = "Admin")]

@inject DistrictsApiService DistrictsApiService
@inject SubDistrictsApiService SubDistrictsApiService
@inject OfficersApiService OfficersApiService
@inject FinancialYearsApiService FinancialYearsApiService
@inject SchemesApiService SchemesApiService
@inject FarmerApplicationsListApiService FarmerApplicationsListApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

<PageTitle>@Lang.Text("Approved Farmer Report", "स्वीकृत कृषक रिपोर्ट")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/person_check" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Approved Farmer Report", "स्वीकृत कृषक रिपोर्ट")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for Approved Farmer", "स्वीकृत कृषक रिपोर्ट")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Value="_selectedDistrictCensus" Label="@Lang.Text("District", "जिला")"
                   Variant="Variant.Outlined" ValueChanged="OnDistrictChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var d in _districts)
            {
                <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                    @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Value="_selectedSubDistrictCode" Label="@Lang.Text("Block", "विकासखण्ड")"
                   Variant="Variant.Outlined" ValueChanged="OnSubDistrictChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var s in _subdistricts)
            {
                <MudSelectItem T="int?" Value="@((int?)s.SubDistrictCode)">
                    @(Lang.IsHindi ? s.SubDistrictNameHi : s.SubDistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Value="_selectedOfficerCode" Label="@Lang.Text("Officer", "अधिकारी")"
                   Variant="Variant.Outlined" ValueChanged="OnOfficerChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var o in _officers)
            {
                <MudSelectItem T="int?" Value="@((int?)o.OfficerCode)">
                    @o.OfficerName
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?" @bind-Value="_selectedVillageCode" Label="@Lang.Text("Village", "ग्राम")"
                   Variant="Variant.Outlined">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var v in _villages)
            {
                <MudSelectItem T="int?" Value="@((int?)v.VillageCode)">
                    @v.VillageName
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>


    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- Scheme Type -->
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Value="_selectedSchemeTypeId" ValueChanged="OnSchemeTypeChanged"
                   Label="@Lang.Text("Scheme Type", "योजना का प्रकार")" Variant="Variant.Outlined" Required="true">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>

            @foreach (var st in _schemesTypes)
            {
                <MudSelectItem T="int?" Value="@((int?)st.SchemeId)">
                    @st.SchemeTypeName

                    @if (!string.IsNullOrWhiteSpace(st.SchemeTypeNameEn))
                    {
                        <span> / @st.SchemeTypeNameEn</span>
                    }
                    @(Lang.IsHindi
                        ? st.SchemeTypeName
                        : st.SchemeTypeNameEn)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- Scheme -->
    <MudItem xs="12" sm="5">
        <MudSelect T="int?" @bind-Value="_selectedSchemeId" Label="@Lang.Text("Scheme", "योजना")"
                   Variant="Variant.Outlined" Required="true" Disabled="@(!_schemes.Any())">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var scheme in _schemes)
            {
                <MudSelectItem T="int?" Value="@((int?)scheme.SchemeId)">
                    @scheme.SchemeName

                    @if (!string.IsNullOrWhiteSpace(scheme.SchemeNameEn))
                    {
                        <span> / @scheme.SchemeNameEn</span>
                    }
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करें")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Dense="true" Bordered="true" HeaderClass="report-header-row"
              Hover="true" Elevation="1" Class="mt-4">
        <ToolBarContent>
            <MudStack Row="false" Spacing="0">
                <MudText Typo="Typo.h6">
                    @Lang.Text("Approved Farmer Report", "स्वीकृत कृषक रिपोर्ट")
                    (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
                </MudText>
                <MudText Typo="Typo.subtitle1">
                    पहले आओ पहले पाओ के आधार पर कृषकों का स्वीकृत या गया है|
                </MudText>
            </MudStack>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.UfId!)">@Lang.Text("UFID",
                       "यू.एफ.आईडी")</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.VillageName!)">
                        @Lang.Text("Village Name", "ग्राम का नाम")</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.FarmerNameEng!)">
                            @Lang.Text("Farmer Name", "किसान का नाम")</MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.FatherName!)">
                                @Lang.Text("Farmer Father Name", "पिता का नाम")</MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.MobileNo!)">
                                    @Lang.Text("Mobile No", "मोबाइल नंबर")</MudTableSortLabel>
                                </MudTh>
                                <MudTh>
                                    <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.ComponentName!)">
                                        @Lang.Text("Scheme", "योजना")</MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.Area!)">@Lang.Text("Area (for the scheme) (in hectares)", "रकबा (योजना के लिए) (हेक्ट. में)")</MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.KhasraNo!)">
                                            @Lang.Text("Khasra number against which the benefit has been availed.", "खसरा नंबर जिसमे लाभ लिया गया है")</MudTableSortLabel>
                                        </MudTh>
                                        <MudTh>
                                            <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.TotalLandKhasra!)">
                                                @Lang.Text("Total Khasra", "कुल खसरा")</MudTableSortLabel>
                                            </MudTh>
                                            <MudTh>
                                                <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.TotalLandArea!)">
                                                    @Lang.Text("Total area (in hectares)", "कुल रकबा (हेक्टेयर में)")</MudTableSortLabel>
                                                </MudTh>
                                                <MudTh>
                                                    <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.IfscCode!)">
                                                        @Lang.Text("IFSC Code", "आईएफएससी कोड")</MudTableSortLabel>
                                                    </MudTh>
                                                    <MudTh>
                                                        <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.AccountNo!)">
                                                            @Lang.Text("Account No", "खाता क्रमांक")</MudTableSortLabel>
                                                        </MudTh>
                                                        <MudTh>
                                                            <MudTableSortLabel SortBy="new Func<ApprovedFarmerApplicationsDto, object>(x => x.RegDate!)">
                                                                @Lang.Text("Registration Date", "पंजीयन दिनांक")</MudTableSortLabel>
                                                            </MudTh>
                                                        </HeaderContent>
                                                        <RowTemplate>
                                                            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("UFID", "यू.एफ.आईडी")">
                                                                <MudLink Href="@($"/report/farmer-details/{context.UfId}")" Target="_blank" Color="Color.Info">
                                                                    @context.UfId
                                                                </MudLink>
                                                            </MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Village Name", "ग्राम का नाम")">@context.VillageName</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Farmer Name", "किसान का नाम")">@context.FarmerNameEng</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Farmer Father Name", "पिता का नाम")">@context.FatherName</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Mobile No", "मोबाइल नंबर")">@context.MobileNo</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Scheme", "योजना")">@context.SchemeName - @context.ComponentName</MudTd>
                                                            <MudTd DataLabel="@Lang.Text("Area (for the scheme) (in hectares)", "रकबा (योजना के लिए) (हेक्ट. में)")">
                                                                @context.Area</MudTd>
                                                                <MudTd
                                                                    DataLabel="@Lang.Text("Khasra number against which the benefit has been availed.", "खसरा नंबर जिसमे लाभ लिया गया है")">
                                                                    @context.KhasraNo</MudTd>
                                                                    <MudTd DataLabel="@Lang.Text("Total Khasra", "कुल खसरा")">@context.TotalLandKhasra</MudTd>
                                                                    <MudTd DataLabel="@Lang.Text("Total area (in hectares)", "कुल रकबा (हेक्टेयर में)")">
                                                                        @context.TotalLandArea?.ToString("N2")</MudTd>
                                                                        <MudTd DataLabel="@Lang.Text("IFSC Code", "आईएफएससी कोड")">@context.IfscCode</MudTd>
                                                                        <MudTd DataLabel="@Lang.Text("Account No", "खाता क्रमांक")">@context.AccountNo</MudTd>
                                                                        <MudTd DataLabel="@Lang.Text("Registration Date", "पंजीयन दिनांक")">@context.RegDate?.ToString("dd/MM/yyyy")</MudTd>
                                                                    </RowTemplate>
                                                                    <FooterContent>
                                                                        <MudTd>
                                                                            <b>@Lang.Text("Total", "योग")</b>
                                                                        </MudTd>
                                                                        <MudTd></MudTd>
                                                                        <MudTd></MudTd>
                                                                        <MudTd>
                                                                            <b>@_filteredReportData.Where(x => !string.IsNullOrWhiteSpace(x.UfId!.ToString())).Select(x =>
                                                                                                x.UfId).Distinct().Count()</b>
                                                                                <span> @Lang.Text("Farmers", "कृषक")</span>
                                                                            </MudTd>
                                                                            <MudTd></MudTd>
                                                                            <MudTd></MudTd>
                                                                            <MudTd>
                                                                                <b>@_filteredReportData.Where(x => !string.IsNullOrWhiteSpace(x.ComponentName)).Select(x =>
                                                                                                    x.ComponentName).Distinct().Count()</b>
                                                                                    <span> @Lang.Text("Schemes", "योजनाएं")</span>
                                                                                </MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd>
                                                                                    <b>
                                                                                        @_filteredReportData.Sum(x => x.Area ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")
                                                                                    </b>
                                                                                </MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd>
                                                                                    <b>
                                                                                        @_filteredReportData.Sum(x => x.TotalLandArea ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")
                                                                                    </b>
                                                                                </MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd></MudTd>
                                                                                <MudTd></MudTd>
                                                                            </FooterContent>

                                                                            <PagerContent>
                                                                                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                                                                            </PagerContent>
                                                                        </MudTable>
                                                                    }
@code {

    private List<DistrictsDto> _districts = [];
    private List<SubDistrictsDto> _subdistricts = [];
    private List<FinancialYearDto> _finyears = [];
    private List<RheoOfficersDto> _officers = [];
    private List<RheoOfficerMappedVillagesDto> _villages = [];

    private List<SchemeTypeDto> _schemesTypes = new();
    private List<SchemeDto> _schemes = new();

    private int? _selectedDepartmentCode;
    private int? _selectedFinancialYear;
    private int? _selectedDistrictCensus;
    private int? _selectedSubDistrictCode;
    private int? _selectedOfficerCode;
    private int? _selectedVillageCode;
    private int? _selectedSchemeTypeId;
    private int? _selectedSchemeId;

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<ApprovedFarmerApplicationsDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDistrictsAsync();
        await LoadFinancialYearsAsync();
        await LoadSchemeTypes();
    }

    private async Task LoadDistrictsAsync()
    {
        var result = await DistrictsApiService.GetDistrictsAsync();
        if (result.IsSuccess)
            _districts = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts.", "जिले लोड करने में विफल।"), Severity.Warning);
    }

    private async Task OnDistrictChanged(int? districtId)
    {
        _selectedDistrictCensus = districtId;

        // reset everything that depends on district
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _selectedVillageCode = null;

        _subdistricts.Clear();
        _officers.Clear();
        _villages.Clear();

        if (districtId is null) return;

        try
        {
            var result = await SubDistrictsApiService.GetSubDistrictsAsync(districtId.Value);
            if (result.IsSuccess && result.Data is not null)
                _subdistricts = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load subdistricts.", "उपजिलों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task OnSubDistrictChanged(int? subDistrictCode)
    {
        _selectedSubDistrictCode = subDistrictCode;

        // reset everything that depends on sub-district
        _selectedOfficerCode = null;
        _selectedVillageCode = null;

        _officers.Clear();
        _villages.Clear();

        if (subDistrictCode is null) return;

        try
        {
            int departmentCode = 3;
            var result = await OfficersApiService.GetRheoOfficersListFromSubdistrictCodeAsync(departmentCode,
subDistrictCode.Value);
            if (result.IsSuccess && result.Data is not null)
                _officers = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load officers.", "अधिकारियों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task OnOfficerChanged(int? officerCode)
    {
        _selectedOfficerCode = officerCode;

        // reset everything that depends on sub-district
        _selectedVillageCode = null;
        _villages.Clear();

        if (officerCode is null) return;

        _isLoading = true; // added only for loading mapped village because it takes time to load
        try
        {
            int departmentCode = 3;
            var result = await OfficersApiService.GetRheoOfficerMappedVillagesListAsync(departmentCode, officerCode.Value);
            if (result.IsSuccess && result.Data is not null)
                _villages = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load mapped villages of officer.", "अधिकारी के मैप ग्राम लोड करने में विफल।"),
Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSchemeTypes()
    {
        var schemeTypesTask = await SchemesApiService.GetSchemesTypesAsync();
        if (schemeTypesTask.IsSuccess && schemeTypesTask.Data is not null)
        {
            _schemesTypes = schemeTypesTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }
    private async Task OnSchemeTypeChanged(int? schemeTypeId)
    {
        _selectedSchemeTypeId = schemeTypeId;
        _selectedSchemeId = null;
        _schemes.Clear();

        if (!schemeTypeId.HasValue || schemeTypeId.Value == 0)
            return;

        var result =
            await SchemesApiService.GetSchemesByTypeAsync(schemeTypeId.Value);

        if (result.IsSuccess && result.Data is not null)
        {
            _schemes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load schemes.",
                    "योजनाएँ लोड करने में विफल।"),
                Severity.Error);
        }
    }
    
    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Skip(3).Take(1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        if (_selectedDistrictCensus is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a district.",
                    "कृपया एक जिला चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedSubDistrictCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a block.",
                    "कृपया एक ब्लॉक चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedOfficerCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select an officer.",
                    "कृपया एक अधिकारी चुनें।"),
                Severity.Warning);
            return;
        }

        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            char _selectedStatusCode = 'S';

            var result =
                await FarmerApplicationsListApiService
                    .GetRptOfApprovedFarmersApplicationsListAsync(
                        _selectedDistrictCensus!.Value,
                        _selectedSubDistrictCode!.Value,
                        _selectedVillageCode ?? 0,
                        _selectedOfficerCode!.Value,
                        _selectedSchemeTypeId ?? 0,
                        _selectedSchemeId ?? 0,
                        _selectedStatusCode,
                        _selectedFinancialYear!.Value);

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    if (result.Data.Any())
                    {
                        _reportData = result.Data;
                    }
                    else
                    {
                        _reportData = [];
                        Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                    }
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedDistrictCensus = null;
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _selectedVillageCode = null;
        _subdistricts.Clear();
        _officers.Clear();
        _villages.Clear();
        _reportData.Clear();
    }

    private IEnumerable<ApprovedFarmerApplicationsDto> _filteredReportData =>
            _reportData.Where(t =>
                string.IsNullOrWhiteSpace(_searchString)
                || (t.VillageName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.FarmerNameEng?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.FatherName?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.KhasraNo?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.TotalLandArea.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ExcelColumn<ApprovedFarmerApplicationsDto>> GetColumns() => new()
    {
         new() { HeaderEn = "UFID", HeaderHi = "यू.एफ.आईडी",
                ValueSelector = x => x.UfId! },

        new() { HeaderEn = "Village Name", HeaderHi = "ग्राम का नाम",
                ValueSelector = x => x.VillageName! },
       
        new() { HeaderEn = "Farmer Name", HeaderHi = "किसान का नाम",
                ValueSelector = x => Lang.Text(x.FarmerNameEng!, x.FarmerNameHi!) },

        new() { HeaderEn = "Farmer Father Name", HeaderHi = "पिता का नाम",
                ValueSelector = x => x.FatherName! },

        new() { HeaderEn = "Mobile No", HeaderHi = "मोबाइल नंबर",
                ValueSelector = x => x.MobileNo! },

        new() { HeaderEn = "Scheme", HeaderHi = "योजना",
                ValueSelector = x => $"{x.SchemeName!} - {x.ComponentName!}" },
        
        new() { HeaderEn = "Beneficiary area (in hectares)", HeaderHi = "लाभान्वित रकबा(हेक्टेयर में)",
                ValueSelector = x => x.Area,
                TotalSelector = list => list.Sum(x => x.Area!) },

        new() { HeaderEn = "Total Khasra", HeaderHi = "कुल खसरा",
                ValueSelector = x => x.TotalLandKhasra! },

        new() { HeaderEn = "Total area (in hectares)", HeaderHi = "कुल रकबा (हेक्टेयर में)",
                ValueSelector = x => x.TotalLandArea!,
                TotalSelector = list => list.Sum(x => x.TotalLandArea!) },

    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("Approved Farmer Report", "स्वीकृत कृषक रिपोर्ट"),
            (en, hi) => Lang.Text(en, hi),
            $"Approved_FarmersReport_{finYear}.xlsx");
    }
}