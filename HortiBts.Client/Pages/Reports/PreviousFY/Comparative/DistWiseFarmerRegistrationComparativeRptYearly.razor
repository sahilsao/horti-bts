@page "/reports/comparative/previous/districtwise-farmer-registration-report"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Reports.PreviousFY.Comparative
@using HortiBts.Client.Services.Reports.PreviousFY.Yearly
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Reports.PreviousFY.Comparative
@using HortiBts.Shared.Dtos.Reports.PreviousFY.Yearly
@attribute [Authorize(Roles = "Admin")]

@inject FinancialYearsApiService FinancialYearsApiService
@inject ComparativeFarmerRegistrationApiService ComparativeFarmerRegistrationApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ExcelExportService ExcelExport

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

<PageTitle>
    @Lang.Text("District-Wise Comparative Farmer Registration Report (Yearly)", "जिलावार तुलनात्मक कृषक पंजीयन रिपोर्ट (वार्षिक)")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/lab_profile" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("District-Wise Comparative Farmer Registration Report (Yearly)", "जिलावार तुलनात्मक कृषक पंजीयन रिपोर्ट (वार्षिक)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for District-Wise Comparative Farmer Registration (Yearly)", "जिलावार तुलनात्मक कृषक पंजीयन रिपोर्ट (वार्षिक)")
</MudText>
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करे")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@{
    var y4 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear;
    var y3 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 1)?.FinancialYear;
    var y2 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 2)?.FinancialYear;
    var y1 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 3)?.FinancialYear;
}
@if (_reportData.Any())
{
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Bordered="true" CustomHeader="true" Dense="true" Hover="true" Elevation="1" Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("Distwise Farmer Comparative Registration Report (Yearly)", "जिलावार तुलनात्मक रिपोर्ट उद्यानिकी कृषक पंजीयन रिपोर्ट (वार्षिक)")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTHeadRow Class="report-header-row">

                <MudTh RowSpan="2">
                    @Lang.Text("S.No.", "क्रमाँक")
                </MudTh>

                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<DistWiseComparativeFarmerRegistrationDto, object>(x => Lang.Text(x.DistrictNameEn!, x.DistrictNameEn!))">
                        @Lang.Text("District", "जिला")
                    </MudTableSortLabel>
                </MudTh>

                <MudTh ColSpan="4" Style="text-align:center;">
                    @Lang.Text(
                        "Registered Farmer Count",
                        "पंजीकृत कृषकों की सँख्या")
                </MudTh>
            </MudTHeadRow>
            <MudTHeadRow Class="report-header-row">

                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseComparativeFarmerRegistrationDto, object>(x => x.TotalFarmerCountFyb4!)">
                        @Lang.Text($"Year {y4}", $"वर्ष {y4}")
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseComparativeFarmerRegistrationDto, object>(x => x.TotalFarmerCountFyb3!)">
                        @Lang.Text($"Year {y3}", $"वर्ष {y3}")
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseComparativeFarmerRegistrationDto, object>(x => x.TotalFarmerCountFyb2!)">
                        @Lang.Text($"Year {y2}", $"वर्ष {y2}")
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseComparativeFarmerRegistrationDto, object>(x => x.TotalFarmerCountFyb1!)">
                        @Lang.Text($"Year {y1}", $"वर्ष {y1}")
                    </MudTableSortLabel>
                </MudTh>

            </MudTHeadRow>

        </HeaderContent>
        <RowTemplate>
            @{
                var districtName = Lang.Text(context.DistrictNameEn!, context.DistrictNameHi!);
                var finYearLabel4 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear;
                var finYearLabel3 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 1)?.FinancialYear;
                var finYearLabel2 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 2)?.FinancialYear;
                var finYearLabel1 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 3)?.FinancialYear;
                var reportWord = Lang.Text("Report", "रिपोर्ट");
                var tooltipText4 = $"{districtName} - {finYearLabel4} - {reportWord}";
                var tooltipText3 = $"{districtName} - {finYearLabel3} - {reportWord}";
                var tooltipText2 = $"{districtName} - {finYearLabel2} - {reportWord}";
                var tooltipText1 = $"{districtName} - {finYearLabel1} - {reportWord}";
            }
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("District", "जिला")">
                <MudTooltip Text="@tooltipText4" Color="Color.Info" Placement="Placement.Top">
                    <MudLink Href="@($"/reports/comparative/previous/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{_selectedFinancialYear!.Value}")"
                             Color="Color.Info">
                        @Lang.Text(context.DistrictNameEn!, context.DistrictNameHi!)
                    </MudLink>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="@Lang.Text($"Year {y4}", $"वर्ष {y4}")">
                <MudTooltip Text="@tooltipText4" Color="Color.Info" Disabled="@(context.TotalFarmerCountFyb4 == 0)" Placement="Placement.Top">
                    <MudLink Href="@($"/reports/yearly/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{_selectedFinancialYear!.Value}")"
                             Disabled="@(context.TotalFarmerCountFyb4 == 0)" Color="Color.Info">
                        @context.TotalFarmerCountFyb4
                    </MudLink>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="@Lang.Text($"Year {y3}", $"वर्ष {y3}")">
                <MudTooltip Text="@tooltipText3" Color="Color.Info" Disabled="@(context.TotalFarmerCountFyb3 == 0)" Placement="Placement.Top">
                    <MudLink Href="@($"/reports/yearly/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{(_selectedFinancialYear - 1)!.Value}")"
                             Disabled="@(context.TotalFarmerCountFyb3 == 0)" Color="Color.Info">
                        @context.TotalFarmerCountFyb3
                    </MudLink>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="@Lang.Text($"Year {y2}", $"वर्ष {y2}")">
                <MudTooltip Text="@tooltipText2" Color="Color.Info" Disabled="@(context.TotalFarmerCountFyb2 == 0)" Placement="Placement.Top">
                    <MudLink Href="@($"/reports/yearly/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{(_selectedFinancialYear - 2)!.Value}")"
                             Disabled="@(context.TotalFarmerCountFyb2 == 0)" Color="Color.Info">
                        @context.TotalFarmerCountFyb2
                    </MudLink>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="@Lang.Text($"Year {y1}", $"वर्ष {y1}")">
                <MudTooltip Text="@tooltipText1" Color="Color.Info" Disabled="@(context.TotalFarmerCountFyb1 == 0)" Placement="Placement.Top">
                    <MudLink Href="@($"/reports/yearly/blockwise-farmer-registration-report/{context.DistrictCode!.Value}/{(_selectedFinancialYear - 3)!.Value}")"
                             Disabled="@(context.TotalFarmerCountFyb1 == 0)" Color="Color.Info">
                        @context.TotalFarmerCountFyb1
                    </MudLink>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalFarmerCountFyb4 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalFarmerCountFyb3 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalFarmerCountFyb2 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalFarmerCountFyb1 ?? 0)</b></MudTd>
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private List<FinancialYearDto> _finyears = [];
    private int? _selectedFinancialYear;

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<DistWiseComparativeFarmerRegistrationDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadFinancialYearsAsync();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Skip(1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(Lang.Text("Please select a financial year.", "कृपया एक वित्तीय वर्ष चुनें।"), Severity.Warning);
            return;
        }
        _isLoading = true;
        try
        {
            var result = await ComparativeFarmerRegistrationApiService.GetComparativeDistWiseFarmerRegistrationListAsync(_selectedFinancialYear!.Value);
            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    _reportData = result.Data;
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }

            }
            else
            {
                Snackbar.Add(Lang.Text("Failed to load report data.", "रिपोर्ट डेटा लोड करने में विफल।"), Severity.Warning);
                _isLoading = false;
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _reportData.Clear();
    }

    private IEnumerable<DistWiseComparativeFarmerRegistrationDto> _filteredReportData =>
    _reportData.Where(t =>
    string.IsNullOrWhiteSpace(_searchString)
    || (t.DistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalFarmerCountFyb4?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalFarmerCountFyb3?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalFarmerCountFyb2?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalFarmerCountFyb1?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

     
    private List<ExcelColumn<DistWiseComparativeFarmerRegistrationDto>> GetColumns() => new()
    {
        new() { HeaderEn = "District", HeaderHi = "जिला",
                ValueSelector = x => Lang.Text(x.DistrictNameEn!, x.DistrictNameHi!) },
        new() { HeaderEn = "Year-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear,
                HeaderHi = "वर्ष-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear,
                ValueSelector = x => x.TotalFarmerCountFyb4 ?? 0,
                TotalSelector = list => list.Sum(x => x.TotalFarmerCountFyb4 ?? 0) },
        new() { HeaderEn = "Year-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-1)?.FinancialYear,
                HeaderHi = "वर्ष-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-1)?.FinancialYear,
                ValueSelector = x => x.TotalFarmerCountFyb3 ?? 0,
                TotalSelector = list => list.Sum(x => x.TotalFarmerCountFyb3 ?? 0) },
        new() { HeaderEn = "Year-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-2)?.FinancialYear,
                HeaderHi = "वर्ष-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-2)?.FinancialYear,
                ValueSelector = x => x.TotalFarmerCountFyb2 ?? 0,
                TotalSelector = list => list.Sum(x => x.TotalFarmerCountFyb2 ?? 0) },
        new() { HeaderEn = "Year-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-3)?.FinancialYear,
                HeaderHi = "वर्ष-"+_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear-3)?.FinancialYear,
                ValueSelector = x => x.TotalFarmerCountFyb1 ?? 0,
                TotalSelector = list => list.Sum(x => x.TotalFarmerCountFyb1 ?? 0) }
    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("District-Wise Farmer Comparative Registration Report (Yearly)", "जिलावार तुलनात्मक कृषक पंजीयन रिपोर्ट (वार्षिक)"),
            (en, hi) => Lang.Text(en, hi),
            $"DistrictWise_Comparative_FarmerRegistrationReport_{finYear}.xlsx");
    }
}
