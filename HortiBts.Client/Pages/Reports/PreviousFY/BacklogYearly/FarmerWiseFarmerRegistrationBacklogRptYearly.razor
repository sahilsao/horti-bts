@page "/reports/backlog/previous/farmerwise-farmer-registration-report"
@page "/reports/backlog/previous/farmerwise-farmer-registration-report/{DepartmentCode:int}/{DistrictCode:int}/{SubDistrictCode:int}/{VillageCode:int}/{OfficerCode:int}/{FinancialYear:int}/{SchemeTypeId:int}/{SchemeId:int}/{ComponentId:int}"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Components
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Officers
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Reports.PreviousFY.BacklogYearly
@using HortiBts.Client.Services.Schemes
@using HortiBts.Client.Services.SubDistricts
@using HortiBts.Shared.Dtos.Components
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Officers
@using HortiBts.Shared.Dtos.Reports.PreviousFY.BacklogYearly
@using HortiBts.Shared.Dtos.Schemes
@using HortiBts.Shared.Dtos.SubDistricts
@attribute [Authorize(Roles = "Admin")]

@inject DistrictsApiService DistrictsApiService
@inject SubDistrictsApiService SubDistrictsApiService
@inject OfficersApiService OfficersApiService
@inject FinancialYearsApiService FinancialYearsApiService
@inject SchemesApiService SchemesApiService
@inject ComponentsApiService ComponentsApiService
@inject BacklogYearlyFarmerRegistrationApiService BacklogYearlyFarmerRegistrationApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

<PageTitle>
    @Lang.Text("Farmer-Wise Farmer Registration Backlog Report (Yearly)", "कृषकवार कृषक पंजीयन बैकलॉग रिपोर्ट (वार्षिक)")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/article_person" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("Farmer-Wise Farmer Registration Backlog Report (Yearly)", "कृषकवार कृषक पंजीयन बैकलॉग रिपोर्ट (वार्षिक)")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for Farmer-Wise Farmer Registration Backlog (Yearly)", "कृषकवार कृषक पंजीयन बैकलॉग रिपोर्ट (वार्षिक)")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedDistrictCensus"
                   Label="@Lang.Text("District", "जिला")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnDistrictChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var d in _districts)
            {
                <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                    @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedSubDistrictCode"
                   Label="@Lang.Text("Block", "विकासखण्ड")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnSubDistrictChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var s in _subdistricts)
            {
                <MudSelectItem T="int?" Value="@((int?)s.SubDistrictCode)">
                    @(Lang.IsHindi ? s.SubDistrictNameHi : s.SubDistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedOfficerCode"
                   Label="@Lang.Text("Officer", "अधिकारी")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnOfficerChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var o in _officers)
            {
                <MudSelectItem T="int?" Value="@((int?)o.OfficerCode)">
                    @o.OfficerName
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   @bind-Value="_selectedVillageCode"
                   Label="@Lang.Text("Village", "ग्राम")"
                   Variant="Variant.Outlined">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var v in _villages)
            {
                <MudSelectItem T="int?" Value="@((int?)v.VillageCode)">
                    @v.VillageName
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>


    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- Scheme Type -->
    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedSchemeTypeId"
                   ValueChanged="OnSchemeTypeChanged"
                   Label="@Lang.Text("Scheme Type", "योजना का प्रकार")"
                   Variant="Variant.Outlined"
                   Required="true">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>

            @foreach (var st in _schemesTypes)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)st.SchemeId)">
                    @st.SchemeTypeName

                    @if (!string.IsNullOrWhiteSpace(st.SchemeTypeNameEn))
                    {
                        <span> / @st.SchemeTypeNameEn</span>
                    }
                    @(Lang.IsHindi
                        ? st.SchemeTypeName
                        : st.SchemeTypeNameEn)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- Scheme -->
    <MudItem xs="12" sm="5">
        <MudSelect T="int?"
                   Value="_selectedSchemeId"
                   ValueChanged="OnSchemeChanged"
                   Label="@Lang.Text("Scheme", "योजना")"
                   Variant="Variant.Outlined"
                   Required="true"
                   Disabled="@(!_schemes.Any())">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var scheme in _schemes)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)scheme.SchemeId)">
                    @scheme.SchemeName

                    @if (!string.IsNullOrWhiteSpace(scheme.SchemeNameEn))
                    {
                        <span> / @scheme.SchemeNameEn</span>
                    }
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- Components -->
    <MudItem xs="12" sm="5">
        <MudSelect T="int?"
                   @bind-Value="_selectedComponentId"
                   Label="@Lang.Text("Component", "घटक")"
                   Variant="Variant.Outlined"
                   Required="true"
                   Disabled="@(!_components.Any())">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>


            @foreach (var component in _components)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)component.ComponentId)">
                    @component.ComponentNameHi

                    @if (!string.IsNullOrWhiteSpace(component.ComponentName))
                    {
                        <span> / @component.ComponentName</span>
                    }
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करे")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>
@if (_reportData.Any())
{
    <MudStack class="mt-2">
        @{
            var firstRow = _filteredReportData.FirstOrDefault();
        }
        @if (firstRow != null)
        {
            <MudText Typo="Typo.body2" Class="mt-1">
                @Lang.Text("District", "जिला"): <b>@Lang.Text(firstRow.DistrictNameEn!, firstRow.DistrictNameHi!)</b>
                &nbsp;|&nbsp;
                @Lang.Text("Block", "विकासखंड"): <b>@Lang.Text(firstRow.SubDistrictNameEn!, firstRow.SubDistrictNameHi!)</b>
                &nbsp;|&nbsp;
                @Lang.Text("Village", "ग्राम"): <b>@firstRow.VillageName</b>
                &nbsp;|&nbsp;
                @Lang.Text("Officer Name", "अधिकारी का नाम"): <b>@firstRow.OfficerName</b>
                &nbsp;|&nbsp;
                @Lang.Text("Officer Mob No.", "अधिकारी का मोबाइल नंबर"): <b>@firstRow.MobileNo</b>
            </MudText>
        }
    </MudStack>
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Bordered="true" Dense="true" Hover="true" Elevation="1" Class="mt-4" CustomHeader="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("Farmerwise Farmer Registration Backlog Report (Yearly)", "कृषक-वार कृषक पंजीयन बैकलॉग रिपोर्ट (वार्षिक)")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTHeadRow Class="report-header-row">
                <MudTh RowSpan="2">@Lang.Text("S.No.", "क्रमाँक")</MudTh>
                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.VillageName!)">
                        @Lang.Text("Village", "ग्राम")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.UFID!)">
                        @Lang.Text("UFID", "यू.एफ.आईडी")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.FarmerNameEng!)">
                        @Lang.Text("Farmer Name", "किसान का नाम")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.FarmerFatherName!)">
                        @Lang.Text("Father Name", "पिता का नाम")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh RowSpan="2">
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.MobileNo!)">
                        @Lang.Text("Mobile No", "मोबाइल नंबर")
                    </MudTableSortLabel>
                </MudTh>

                @{
                    var y4 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear;
                    var y3 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 1)?.FinancialYear;
                    var y2 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 2)?.FinancialYear;
                    var y1 = _finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear - 3)?.FinancialYear;
                }
                <MudTh ColSpan="3" Style="text-align:center;">@Lang.Text($"Year {y4}", $"वर्ष {y4}")</MudTh>
                <MudTh ColSpan="3" Style="text-align:center;">@Lang.Text($"Year {y3}", $"वर्ष {y3}")</MudTh>
                <MudTh ColSpan="3" Style="text-align:center;">@Lang.Text($"Year {y2}", $"वर्ष {y2}")</MudTh>
                <MudTh ColSpan="3" Style="text-align:center;">@Lang.Text($"Year {y1}", $"वर्ष {y1}")</MudTh>

                <MudTh RowSpan="2">@Lang.Text("Total Land (Khasra)", "कुल भूमि (खसरा)")</MudTh>
                <MudTh RowSpan="2">@Lang.Text("Total Land Area (Hect.)", "कुल भूमि क्षेत्रफल (हेक्ट.)")</MudTh>
            </MudTHeadRow>
            <MudTHeadRow Class="report-header-row">
                @* Back Year 4 *@
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalApplicationCountFyb4!)">
                        @Lang.Text("Applications Count", "आवेदन संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalAreaCoveredFyb4!)">
                        @Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalCashDisbursedFyb4!)">
                        @Lang.Text("Subsidy Amount (in rupees)", "अनुदान राशि (रुपए में)")
                    </MudTableSortLabel>
                </MudTh>
                @* Back Year 3 *@
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalApplicationCountFyb3!)">
                        @Lang.Text("Applications Count", "आवेदन संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalAreaCoveredFyb3!)">
                        @Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalCashDisbursedFyb3!)">
                        @Lang.Text("Subsidy Amount (in rupees)", "अनुदान राशि (रुपए में)")
                    </MudTableSortLabel>
                </MudTh>
                @* Back Year 2 *@
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalApplicationCountFyb2!)">
                        @Lang.Text("Applications Count", "आवेदन संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalAreaCoveredFyb2!)">
                        @Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalCashDisbursedFyb2!)">
                        @Lang.Text("Subsidy Amount (in rupees)", "अनुदान राशि (रुपए में)")
                    </MudTableSortLabel>
                </MudTh>
                @* Back Year 1 *@
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalApplicationCountFyb1!)">
                        @Lang.Text("Applications Count", "आवेदन संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalAreaCoveredFyb1!)">
                        @Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<FarmerWiseFarmerRegistrationDto, object>(x => x.TotalCashDisbursedFyb1!)">
                        @Lang.Text("Subsidy Amount (in rupees)", "अनुदान राशि (रुपए में)")
                    </MudTableSortLabel>
                </MudTh>
            </MudTHeadRow>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("Village", "ग्राम")">@context.VillageName</MudTd>
            <MudTd DataLabel="@Lang.Text("UFID", "यू.एफ.आईडी")">
                <MudLink Href="@($"/report/farmer-details/{context.UFID}")"
                         Target="_blank"
                         Color="Color.Info">
                    @context.UFID
                </MudLink>
                </MudTd>
            <MudTd DataLabel="@Lang.Text("Farmer Name", "किसान का नाम")">
                @Lang.Text(context.FarmerNameEng!, context.FarmerNameHi!)
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Father Name", "पिता का नाम")">@context.FarmerFatherName</MudTd>
            <MudTd DataLabel="@Lang.Text("Mobile No", "मोबाइल नंबर")">@context.MobileNo</MudTd>

            @* Back Year 4 *@
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.TotalApplicationCountFyb4</MudTd>
            <MudTd DataLabel="@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")">@context.TotalAreaCoveredFyb4?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.TotalCashDisbursedFyb4?.ToString("N2")</MudTd>

            @* Back Year 3 *@
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.TotalApplicationCountFyb3</MudTd>
            <MudTd DataLabel="@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")">@context.TotalAreaCoveredFyb3?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.TotalCashDisbursedFyb3?.ToString("N2")</MudTd>

            @* Back Year 2 *@
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.TotalApplicationCountFyb2</MudTd>
            <MudTd DataLabel="@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")">@context.TotalAreaCoveredFyb2?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.TotalCashDisbursedFyb2?.ToString("N2")</MudTd>

            @* Back Year 1 *@
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.TotalApplicationCountFyb1</MudTd>
            <MudTd DataLabel="@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")">@context.TotalAreaCoveredFyb1?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.TotalCashDisbursedFyb1?.ToString("N2")</MudTd>

            <MudTd DataLabel="@Lang.Text("Total Land (Khasra)", "कुल भूमि (खसरा)")">@context.TotalLandKhasra</MudTd>
            <MudTd DataLabel="@Lang.Text("Total Land Area", "कुल भूमि क्षेत्रफल")">@context.TotalLandArea?.ToString("N2")</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>

            @* Back Year 4 *@
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalApplicationCountFyb4 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalAreaCoveredFyb4 ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
            <MudTd><b>₹@_filteredReportData.Sum(x => x.TotalCashDisbursedFyb4 ?? 0).ToString("N2")</b></MudTd>

            @* Back Year 3 *@
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalApplicationCountFyb3 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalAreaCoveredFyb3 ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
            <MudTd><b>₹@_filteredReportData.Sum(x => x.TotalCashDisbursedFyb3 ?? 0).ToString("N2")</b></MudTd>

            @* Back Year 2 *@
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalApplicationCountFyb2 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalAreaCoveredFyb2 ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
            <MudTd><b>₹@_filteredReportData.Sum(x => x.TotalCashDisbursedFyb2 ?? 0).ToString("N2")</b></MudTd>

            @* Back Year 1 *@
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalApplicationCountFyb1 ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalAreaCoveredFyb1 ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
            <MudTd><b>₹@_filteredReportData.Sum(x => x.TotalCashDisbursedFyb1 ?? 0).ToString("N2")</b></MudTd>

            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.TotalLandArea ?? 0).ToString("N2")</b></MudTd>
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private List<DistrictsDto> _districts = [];
    private List<SubDistrictsDto> _subdistricts = [];
    private List<FinancialYearDto> _finyears = [];
    private List<RheoOfficersDto> _officers = [];
    private List<ComponentDto> _components = [];
    private List<RheoOfficerMappedVillagesDto> _villages = [];

    private List<SchemeTypeDto> _schemesTypes = new();
    private List<SchemeDto> _schemes = new();

    private int? _selectedDepartmentCode;
    private int? _selectedFinancialYear;
    private int? _selectedDistrictCensus;
    private int? _selectedSubDistrictCode;
    private int? _selectedOfficerCode;
    private int? _selectedVillageCode;
    private int? _selectedSchemeTypeId;
    private int? _selectedComponentId;
    private int? _selectedSchemeId;

    [Parameter]
    public int DepartmentCode { get; set; }
    [Parameter]
    public int DistrictCode { get; set; }
    [Parameter]
    public int SubDistrictCode { get; set; }
    [Parameter]
    public int VillageCode { get; set; }
    [Parameter]
    public int OfficerCode { get; set; }
    [Parameter]
    public int FinancialYear { get; set; }
    [Parameter]
    public int SchemeTypeId { get; set; }
    [Parameter]
    public int SchemeId { get; set; }
    [Parameter]
    public int ComponentId { get; set; }

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<FarmerWiseFarmerRegistrationDto> _reportData = new();

    private string _searchString = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await LoadDistrictsAsync();
        await LoadFinancialYearsAsync();
        await LoadSchemeTypes();

        if (DistrictCode > 0 && SubDistrictCode > 0 && OfficerCode > 0 && FinancialYear > 0)
        {
            _selectedDistrictCensus = DistrictCode;
            await OnDistrictChanged(_selectedDistrictCensus);

            _selectedSubDistrictCode = SubDistrictCode;
            await OnSubDistrictChanged(_selectedSubDistrictCode);

            _selectedOfficerCode = OfficerCode;
            await OnOfficerChanged(_selectedOfficerCode);

            _selectedVillageCode = VillageCode;

            // NEW: cascade scheme type -> scheme -> component
            _selectedSchemeTypeId = SchemeTypeId;
            await OnSchemeTypeChanged(_selectedSchemeTypeId);   // loads _schemes, but also resets _selectedSchemeId to null

            _selectedSchemeId = SchemeId;
            await OnSchemeChanged(_selectedSchemeId);           // loads _components, but resets _selectedComponentId to null

            _selectedComponentId = ComponentId;

            _selectedFinancialYear = FinancialYear;

            await LoadReport();
        }
    }

    private async Task LoadDistrictsAsync()
    {
        var result = await DistrictsApiService.GetDistrictsAsync();
        if (result.IsSuccess)
            _districts = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts.", "जिले लोड करने में विफल।"), Severity.Warning);
    }

    private async Task OnDistrictChanged(int? districtId)
    {
        _selectedDistrictCensus = districtId;

        // reset everything that depends on district
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _selectedVillageCode = null;

        _subdistricts.Clear();
        _officers.Clear();
        _villages.Clear();

        if (districtId is null) return;

        try
        {
            var result = await SubDistrictsApiService.GetSubDistrictsAsync(districtId.Value);
            if (result.IsSuccess && result.Data is not null)
                _subdistricts = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load subdistricts.", "उपजिलों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task OnSubDistrictChanged(int? subDistrictCode)
    {
        _selectedSubDistrictCode = subDistrictCode;

        // reset everything that depends on sub-district
        _selectedOfficerCode = null;
        _selectedVillageCode = null;

        _officers.Clear();
        _villages.Clear();

        if (subDistrictCode is null) return;

        try
        {
            int departmentCode = 3;
            var result = await OfficersApiService.GetRheoOfficersListFromSubdistrictCodeAsync(departmentCode, subDistrictCode.Value);
            if (result.IsSuccess && result.Data is not null)
                _officers = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load officers.", "अधिकारियों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task OnOfficerChanged(int? officerCode)
    {
        _selectedOfficerCode = officerCode;

        // reset everything that depends on sub-district
        _selectedVillageCode = null;
        _villages.Clear();

        if (officerCode is null) return;

        _isLoading = true; // added only for loading mapped village because it takes time to load
        try
        {
            int departmentCode = 3;
            var result = await OfficersApiService.GetRheoOfficerMappedVillagesListAsync(departmentCode, officerCode.Value);
            if (result.IsSuccess && result.Data is not null)
                _villages = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load mapped villages of officer.", "अधिकारी के मैप ग्राम लोड करने में विफल।"), Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSchemeTypes()
    {
        var schemeTypesTask = await SchemesApiService.GetSchemesTypesAsync();
        if (schemeTypesTask.IsSuccess && schemeTypesTask.Data is not null)
        {
            _schemesTypes = schemeTypesTask.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load scheme types.",
                    "योजना प्रकार लोड करने में विफल।"),
                Severity.Error);
        }
    }
    private async Task OnSchemeTypeChanged(int? schemeTypeId)
    {
        _selectedSchemeTypeId = schemeTypeId;
        _selectedSchemeId = null;
        _schemes.Clear();

        _selectedComponentId = null;
        _components.Clear();

        if (!schemeTypeId.HasValue || schemeTypeId.Value == 0)
            return;

        var result =
            await SchemesApiService.GetSchemesByTypeAsync(schemeTypeId.Value);

        if (result.IsSuccess && result.Data is not null)
        {
            _schemes = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load schemes.",
                    "योजनाएँ लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task OnSchemeChanged(int? schemeId)
    {
        _selectedSchemeId = schemeId;

        _selectedComponentId = null;
        _components.Clear();

        if (!schemeId.HasValue || schemeId.Value == 0)
            return;

        var result =
            await ComponentsApiService.GetComponentsListBySchemeIdAsync(schemeId.Value);

        if (result.IsSuccess && result.Data is not null)
        {
            _components = result.Data;
        }
        else
        {
            Snackbar.Add(
                Lang.Text(
                    "Failed to load components.",
                    "घटक लोड करने में विफल।"),
                Severity.Error);
        }
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Skip(1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        if (_selectedDistrictCensus is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a district.",
                    "कृपया एक जिला चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedSubDistrictCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a block.",
                    "कृपया एक ब्लॉक चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedSubDistrictCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a block.",
                    "कृपया एक ब्लॉक चुनें।"),
                Severity.Warning);
            return;
        }
        if (_selectedOfficerCode is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select an officer.",
                    "कृपया एक अधिकारी चुनें।"),
                Severity.Warning);
            return;
        }

        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            _selectedDepartmentCode = 3;

            var result =
                await BacklogYearlyFarmerRegistrationApiService
                    .GetFarmerWiseFarmerRegistrationListAsync(
                        _selectedDepartmentCode!.Value,
                        _selectedDistrictCensus!.Value,
                        _selectedSubDistrictCode!.Value,
                        _selectedVillageCode ?? 0,
                        _selectedOfficerCode!.Value,
                        _selectedFinancialYear!.Value,
                        _selectedSchemeTypeId ?? 0,
                        _selectedSchemeId ?? 0,
                        _selectedComponentId ?? 0);

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    if (result.Data.Any())
                    {
                        _reportData = result.Data;
                    }
                    else
                    {
                        _reportData = [];
                        Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                    }
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedDistrictCensus = null;
        _selectedSubDistrictCode = null;
        _selectedOfficerCode = null;
        _selectedVillageCode = null;
        _subdistricts.Clear();
        _officers.Clear();
        _villages.Clear();
        _reportData.Clear();

        Navigation.NavigateTo(
                "/reports/backlog/previous/farmerwise-farmer-registration-report",
                replace: true);
    }

    private IEnumerable<FarmerWiseFarmerRegistrationDto> _filteredReportData =>
    _reportData.Where(t =>
    string.IsNullOrWhiteSpace(_searchString)
    || (t.DistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.SubDistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.SubDistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.VillageName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.OfficerName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalApplicationCountFyb1?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalApplicationCountFyb2?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalApplicationCountFyb3?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalApplicationCountFyb4?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalCashDisbursedFyb1?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalCashDisbursedFyb2?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalCashDisbursedFyb3?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalCashDisbursedFyb4?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalAreaCoveredFyb1?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalAreaCoveredFyb2?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalAreaCoveredFyb3?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.TotalAreaCoveredFyb4?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

