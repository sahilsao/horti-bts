                        $"Year {y2}",
                        $"वर्ष {y2}")
                </MudTh>
                <MudTh ColSpan="5" Style="text-align:center;">
                    @Lang.Text(
                        $"Year {y1}",
                        $"वर्ष {y1}")
                </MudTh>
            </MudTHeadRow>
            <MudTHeadRow Class="report-header-row">

                @* Back Year 4 *@
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.TargetFyb4!)">
                        @Lang.Text("Farmer Registration Target", "कृषक पंजीकरण लक्ष्य")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.TotalFarmerCountFyb4!)">
                        @Lang.Text("Registered Farmer Count", "पंजीकृत कृषकों की सँख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.TotalApplicationCountFyb4!)">
                        @Lang.Text("Applications Count", "आवेदन संख्या")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto, object>(x => x.TotalAreaCoveredFyb4!)">
                        @Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")
