                <MudTh RowSpan="2">
                     <MudTableSortLabel SortBy="new Func<DistWiseFarmerRegistrationDto,  object>(x => Lang.Text(x.DistrictNameEn!, x.DistrictNameEn!))">
                    @Lang.Text("District", "जिला")
                     </MudTableSortLabel>
                </MudTh>
