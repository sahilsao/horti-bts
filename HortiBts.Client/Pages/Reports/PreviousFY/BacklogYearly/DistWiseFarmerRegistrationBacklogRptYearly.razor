            <MudTd DataLabel="@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")">@context.TotalAreaCoveredFyb3?.ToString("N2")</MudTd>
            <MudTd DataLabel="@Lang.Text("Subsidy Amount", "अनुदान राशि")">₹@context.TotalCashDisbursedFyb3?.ToString("N2")</MudTd>
