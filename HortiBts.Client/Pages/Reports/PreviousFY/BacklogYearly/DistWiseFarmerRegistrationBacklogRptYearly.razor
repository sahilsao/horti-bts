    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("District-Wise Farmer Registration Backlog Report (Yearly)", "जिलावार कृषक पंजीयन बैकलॉग रिपोर्ट (वार्षिक)"),
            (en, hi) => Lang.Text(en, hi),
            $"DistrictWise_FarmerRegistrationReport_Backlog_From_FY_{finYear}.xlsx");
    }

