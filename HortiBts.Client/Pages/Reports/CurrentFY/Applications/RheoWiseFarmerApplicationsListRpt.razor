@page "/reports/applications/current/rheowise-farmer-applications-list"
@page "/reports/applications/current/rheowise-farmer-applications-list/{DepartmentCode:int}/{DistrictCode:int}/{SubDistrictCode:int}/{FinancialYear:int}"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.Districts
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Reports.CurrentFY.Applications
@using HortiBts.Client.Services.SubDistricts
@using HortiBts.Shared.Dtos.Districts
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Reports.CurrentFY.Applications
@using HortiBts.Shared.Dtos.SubDistricts
@attribute [Authorize(Roles = "Admin")]

@inject DistrictsApiService DistrictsApiService
@inject SubDistrictsApiService SubDistrictsApiService
@inject FinancialYearsApiService FinancialYearsApiService
@inject NewFarmerApplicationsListApiService NewFarmerApplicationsListApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ExcelExportService ExcelExport

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

<PageTitle>@Lang.Text("RHEO-wise Farmer Applications Report", "आर.एच.ई.ओ. वार कृषक आवेदन रिपोर्ट")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/clinical_notes" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("RHEO-wise Farmer Applications Report", "आर.एच.ई.ओ. वार कृषक आवेदन रिपोर्ट")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for RHEO-wise Farmer Applications", "आर.एच.ई.ओ. वार कृषक आवेदन रिपोर्ट")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Value="_selectedDistrictCensus"
                   Label="@Lang.Text("District", "जिला")"
                   Variant="Variant.Outlined"
                   ValueChanged="OnDistrictChanged">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>

            @foreach (var d in _districts)
            {
                <MudSelectItem T="int?" Value="@((int?)d.DistrictCensus)">
                    @(Lang.IsHindi ? d.DistrictNameHindi : d.DistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   @bind-Value="_selectedSubDistrictCode"
                   Label="@Lang.Text("Block", "विकासखण्ड")"
                   Variant="Variant.Outlined"
                   FullWidth="true">

            <MudSelectItem T="int?" Value="0">
                @Lang.Text("All", "सभी")
            </MudSelectItem>

            @foreach (var s in _subdistricts)
            {
                <MudSelectItem T="int?" Value="@((int?)s.SubDistrictCode)">
                    @(Lang.IsHindi ? s.SubDistrictNameHi : s.SubDistrictName)
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="4">
        <MudSelect T="int?"
                   Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear"
                   Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               OnClick="LoadReport"
               Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करें")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudStack class="mt-2">
        @{
            var firstRow = _filteredReportData.FirstOrDefault();
        }
        @if (firstRow != null)
        {
            <MudText Typo="Typo.body2" Class="mt-1">
                @Lang.Text("District", "जिला"): <b>@Lang.Text(firstRow.DistrictNameEn!, firstRow.DistrictNameHi!)</b>
                &nbsp;|&nbsp;
                @Lang.Text("Block", "विकासखंड"): <b>@Lang.Text(firstRow.SubDistrictNameEn!, firstRow.SubDistrictNameHi!)</b>
                </MudText>
        }
    </MudStack>
    <MudTable Items="_filteredReportData"
              SortLabel="Sort By"
              Dense="true"
              Hover="true"
              Bordered="true"
              HeaderClass="report-header-row"
              Elevation="1"
              Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("RHEO Wise Farmer Applications Report", "आर.एच.ई.ओ. वार रिपोर्ट उद्यानिकी कृषक आवेदन रिपोर्ट")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<RHEOWiseFarmerApplicationsDto, object>(x => x.OfficerName!)">@Lang.Text("Officer Name", "अधिकारी का नाम")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<RHEOWiseFarmerApplicationsDto, object>(x => x.FCount!)">@Lang.Text("Farmer Count", "कृषक संख्या")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<RHEOWiseFarmerApplicationsDto, object>(x => x.SCount!)">@Lang.Text("Applications Count", "आवेदन संख्या")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<RHEOWiseFarmerApplicationsDto, object>(x => x.Area!)">@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")</MudTableSortLabel></MudTh>
             <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Area!)">
                    @Lang.Text("Number of applications approved by the RHEO", "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Area!)">
                    @Lang.Text("Number of applications approved by the DDH", "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या")
                </MudTableSortLabel>
            </MudTh>
            </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("Officer Name", "अधिकारी का नाम")">
                <MudLink Href="@($"/reports/applications/current/villagewise-farmer-applications-list/{_selectedDistrictCensus}/{_selectedSubDistrictCode}/{context.OfficerCode!.Value}/{_selectedFinancialYear!.Value}")"
                         Color="Color.Info">
                    @context.OfficerName
                </MudLink>
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Farmer Count", "कृषक संख्या")">@context.FCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.SCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")">@context.Area?.ToString("N2")</MudTd>
             <MudTd
                DataLabel="@Lang.Text("Number of applications approved by the RHEO", "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या")">
                @context.RApproved
            </MudTd>
            <MudTd
                DataLabel="@Lang.Text("Number of applications approved by the DDH", "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या")">
                @context.DApproved
            </MudTd>
            </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.FCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.SCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.Area ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b></MudTd>
           <MudTd><b>@_filteredReportData.Sum(x => x.RApproved ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.DApproved ?? 0)</b></MudTd>
           </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}
@code {

    private List<DistrictsDto> _districts = [];
    private List<SubDistrictsDto> _subdistricts = [];
    private List<FinancialYearDto> _finyears = [];
    private int? _selectedFinancialYear;

    // Default both to 0 = "All" rather than null, so the "All" option is pre-selected on first load
    private int? _selectedDistrictCensus = 0;
    private int? _selectedSubDistrictCode = 0;

    private int? _selectedDepartmentCode;

    [Parameter]
    public int DepartmentCode { get; set; }
    [Parameter]
    public int DistrictCode { get; set; }
    [Parameter]
    public int SubDistrictCode { get; set; }
    [Parameter]
    public int FinancialYear { get; set; }

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<RHEOWiseFarmerApplicationsDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDistrictsAsync();
        await LoadFinancialYearsAsync();

        // FinancialYear is the only truly required deep-link param now;
        // DistrictCode / SubDistrictCode of 0 mean "All" and are valid
        if (DepartmentCode > 0 && FinancialYear > 0)
        {
            _selectedDepartmentCode = 3;

            if (DistrictCode > 0)
            {
                _selectedDistrictCensus = DistrictCode;
                await OnDistrictChanged(_selectedDistrictCensus);
            }
            else
            {
                _selectedDistrictCensus = 0; // All
                _subdistricts.Clear();
            }

            _selectedSubDistrictCode = SubDistrictCode; // 0 = All, or a real code
            _selectedFinancialYear = FinancialYear;

            await LoadReport();
        }
    }

    private async Task LoadDistrictsAsync()
    {
        var result = await DistrictsApiService.GetDistrictsAsync();
        if (result.IsSuccess)
            _districts = result.Data!;
        else
            Snackbar.Add(Lang.Text("Failed to load districts.", "जिले लोड करने में विफल।"), Severity.Warning);
    }

    private async Task OnDistrictChanged(int? districtId)
    {
        _selectedDistrictCensus = districtId;
        _selectedSubDistrictCode = 0; // reset block to "All" whenever district changes
        _subdistricts = new();

        // 0 (or null) means "All districts" — there's no single district to load blocks for
        if (districtId is null || districtId == 0)
            return;

        try
        {
            var result = await SubDistrictsApiService.GetSubDistrictsAsync(districtId.Value);
            if (result.IsSuccess && result.Data is not null)
                _subdistricts = result.Data;
        }
        catch
        {
            Snackbar.Add(Lang.Text("Failed to load subdistricts.", "उपजिलों को लोड करने में विफल।"), Severity.Error);
        }
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        // District and Block are optional now — 0 ("All") is a valid, deliberate selection.
        // Only financial year remains mandatory.
        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(
                Lang.Text(
                    "Please select a financial year.",
                    "कृपया एक वित्त वर्ष चुनें।"),
                Severity.Warning);
            return;
        }

        var districtCode = _selectedDistrictCensus ?? 0; // 0 means "All"
        var subDistrictCode = _selectedSubDistrictCode ?? 0; // 0 means
        _selectedDepartmentCode = 3; // Assuming department code is fixed as 3 for this report

        _isLoading = true;

        try
        {
            var result =
                await NewFarmerApplicationsListApiService
                    .GetRptOfRheoWiseFarmerApplicationsListAsync(
                        _selectedDepartmentCode!.Value,
                        districtCode,
                        subDistrictCode,
                        _selectedFinancialYear!.Value);

            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    _reportData = result.Data;
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(
                    Lang.Text(
                        "Failed to load report data.",
                        "रिपोर्ट डेटा लोड करने में विफल।"),
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _selectedDistrictCensus = 0; // back to "All"
        _selectedSubDistrictCode = 0; // back to "All"
        _subdistricts.Clear();
        _reportData.Clear();

        Navigation.NavigateTo(
               "/reports/applications/current/rheowise-farmer-Applications-report",
               replace: true);
    }

    private IEnumerable<RHEOWiseFarmerApplicationsDto> _filteredReportData =>
            _reportData.Where(t =>
                string.IsNullOrWhiteSpace(_searchString)
                || (t.DistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.DistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.SubDistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.SubDistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.FCount.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.SCount.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
                  || (t.Area?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.RApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ExcelColumn<RHEOWiseFarmerApplicationsDto>> GetColumns() => new()
    {
        new() { HeaderEn = "District", HeaderHi = "जिला",
                ValueSelector = x => Lang.Text(x.DistrictNameEn!, x.DistrictNameHi!) },
        new() { HeaderEn = "Block", HeaderHi = "विकासखंड",
                ValueSelector = x => Lang.Text(x.SubDistrictNameEn!, x.SubDistrictNameHi!) },
        new() { HeaderEn = "Officer Name", HeaderHi = "अधिकारी का नाम",
                ValueSelector = x => x.OfficerName! },
        new() { HeaderEn = "Farmer Count", HeaderHi = "कृषक संख्या",
                ValueSelector = x => x.FCount ?? 0,
                TotalSelector = list => list.Sum(x => x.FCount ?? 0) },
        new() { HeaderEn = "Applications Count", HeaderHi = "आवेदन संख्या",
                ValueSelector = x => x.SCount ?? 0,
                TotalSelector = list => list.Sum(x => x.SCount ?? 0) },
        new() { HeaderEn = "Area (Hectares)", HeaderHi = "रकबा (हेक्टेयर में)",
                ValueSelector = x => x.Area ?? 0,
                TotalSelector = list => list.Sum(x => x.Area ?? 0) },
        new() { HeaderEn = "Number of applications approved by the RHEO", HeaderHi = "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या",
                ValueSelector = x => x.RApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.RApproved ?? 0) },
        new() { HeaderEn = "Number of applications approved by the DDH", HeaderHi = "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या",
                ValueSelector = x => x.DApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.DApproved ?? 0) },
    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("Rheo-Wise Farmer Applications Report", "आर.एच.ई.ओ. वार कृषक आवेदन रिपोर्ट"),
            (en, hi) => Lang.Text(en, hi),
            $"RheoWise_FarmerApplicationsReport_{finYear}.xlsx");
    }
}