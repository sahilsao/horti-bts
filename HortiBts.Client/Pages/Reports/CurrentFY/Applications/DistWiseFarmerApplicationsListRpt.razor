@page "/reports/applications/current/districtwise-farmer-applications-list"
@using HortiBts.Client.Services.Auth
@using HortiBts.Client.Services.FinancialYears
@using HortiBts.Client.Services.Reports
@using HortiBts.Client.Services.Reports.CurrentFY.Applications
@using HortiBts.Shared.Dtos.FinancialYear
@using HortiBts.Shared.Dtos.Reports.CurrentFY.Applications
@attribute [Authorize(Roles = "Admin")]

@inject FinancialYearsApiService FinancialYearsApiService
@inject NewFarmerApplicationsListApiService NewFarmerApplicationsListApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ExcelExportService ExcelExport

<style>
    .report-header-row th,
    .mud-table-container td {
        border: 1px solid var(--mud-palette-table-lines) !important;
    }

    .mud-table-container table {
        border-collapse: collapse;
    }
</style>

<PageTitle>
    @Lang.Text("District-Wise Farmer Applications Report", "जिलावार कृषक आवेदन रिपोर्ट")
</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1 d-flex align-center gap-2">
    <MudIcon Icon="material-symbols-outlined/domain" Color="Color.Primary" Size="Size.Large" />
    @Lang.Text("District-Wise Farmer Applications Report", "जिलावार कृषक आवेदन रिपोर्ट")
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    @Lang.Text("Report for District-Wise Farmer Applications", "जिलावार कृषक आवेदन रिपोर्ट")
</MudText>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@Lang.Text("Select Financial Year", "वित्त वर्ष चुने")"
                   @bind-Value="_selectedFinancialYear" Variant="Variant.Outlined" FullWidth="true" Class="mb-3"
                   Required="true">
            @foreach (var f in _finyears)
            {
                <MudSelectItem T="int?" Value="@((int?)f.Id)">
                    @f.FinancialYear
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<MudStack Row="true" Spacing="1">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="LoadReport" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>@Lang.Text("Loading...", "लोड हो रहा है...")</span>
        }
        else
        {
            <span>@Lang.Text("Search", "खोज करे")</span>
        }
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reset" Disabled="_isLoading">
        @Lang.Text("Reset", "रीसेट")
    </MudButton>
</MudStack>

@if (_reportData.Any())
{
    <MudTable Items="_filteredReportData" SortLabel="Sort By" Bordered="true" HeaderClass="report-header-row" Dense="true"
              Hover="true" Elevation="1" Class="mt-4">
        <ToolBarContent>
            <MudText Typo="Typo.h6">
                @Lang.Text("Distwise Farmer Applications Report", "जिलावार रिपोर्ट उद्यानिकी कृषक आवेदन रिपोर्ट")
                (@_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear)
            </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="@Lang.Text("Search", "खोजें")"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mr-4" />
            <MudTooltip Text="@Lang.Text("Export to Excel", "एक्सेल में निर्यात करें")">
                <MudIconButton Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" OnClick="ExportToExcel" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Lang.Text("S.No.", "क्रमाँक")</MudTh>
            <MudTh>
                <MudTableSortLabel
                    SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => Lang.Text(x.DistrictNameEn!, x.DistrictNameEn!))">
                    @Lang.Text("District", "जिला")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Target!)">
                    @Lang.Text("Target Count", "लक्ष्य (संख्या में)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.FCount!)">
                    @Lang.Text("Farmer Count", "कृषक संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.SCount!)">
                    @Lang.Text("Applications Count", "आवेदन संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Area!)">
                    @Lang.Text("Target Area (Hectares)", "लक्षित रकबा (हेक्टेयर में)")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Area!)">
                    @Lang.Text("Number of applications approved by the RHEO", "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या")
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<DistrictWiseFarmerApplicationsDto, object>(x => x.Area!)">
                    @Lang.Text("Number of applications approved by the DDH", "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या")
                </MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Lang.Text("S.No.", "क्रमाँक")">@(_filteredReportData.ToList().IndexOf(context) + 1)</MudTd>
            <MudTd DataLabel="@Lang.Text("District", "जिला")">
                <MudLink
                    Href="@($"/reports/applications/current/blockwise-farmer-applications-list/{context.DistrictCode!.Value}/{_selectedFinancialYear!.Value}")"
                    Color="Color.Info">
                    @Lang.Text(context.DistrictNameEn!, context.DistrictNameHi!)
                </MudLink>
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Target Count", "लक्ष्य (संख्या में)")">@context.Target</MudTd>
            <MudTd DataLabel="@Lang.Text("Farmer Count", "कृषक संख्या")">@context.FCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Applications Count", "आवेदन संख्या")">@context.SCount</MudTd>
            <MudTd DataLabel="@Lang.Text("Area (Hectares)", "रकबा (हेक्टेयर में)")">
                @context.Area?.ToString("N2")
            </MudTd>
            <MudTd DataLabel="@Lang.Text("Number of applications approved by the RHEO", "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या")">@context.RApproved</MudTd>
            <MudTd DataLabel="@Lang.Text("Number of applications approved by the DDH", "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या")">@context.DApproved</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd><b>@Lang.Text("Total", "योग")</b></MudTd>
            <MudTd></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.Target ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.FCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.SCount ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.Area ?? 0).ToString("N2") @Lang.Text("(Hect.)", "(हेक्ट.)")</b>
            </MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.RApproved ?? 0)</b></MudTd>
            <MudTd><b>@_filteredReportData.Sum(x => x.DApproved ?? 0)</b></MudTd>
        </FooterContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
}

@code {

    private List<FinancialYearDto> _finyears = [];
    private int? _selectedFinancialYear;

    private CurrentUserInfo _currentUser = new("", "", "", 0);
    private bool _isLoading = false;

    private List<DistrictWiseFarmerApplicationsDto> _reportData = new();

    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadFinancialYearsAsync();
    }

    private async Task LoadFinancialYearsAsync()
    {
        var result = await FinancialYearsApiService.GetFinancialYearsForReportAsync();

        if (result.IsSuccess && result.Data is not null)
            _finyears = result.Data.Take(1).ToList();
        else
            Snackbar.Add(Lang.Text("Failed to load financial years.", "वित्त वर्ष लोड करने में विफल।"), Severity.Warning);

    }

    private async Task LoadReport()
    {
        if (_selectedFinancialYear is null)
        {
            Snackbar.Add(Lang.Text("Please select a financial year.", "कृपया एक वित्तीय वर्ष चुनें।"), Severity.Warning);
            return;
        }
        _isLoading = true;
        try
        {
            var result = await
NewFarmerApplicationsListApiService.GetRptOfDistrictWiseFarmerApplicationsListAsync(_selectedFinancialYear!.Value);
            if (result.IsSuccess && result.Data is not null)
            {
                if (result.Data.Any())
                {
                    _reportData = result.Data;
                }
                else
                {
                    _reportData = [];
                    Snackbar.Add(Lang.Text("No data found.", "कोई डेटा नहीं मिला।"), Severity.Info);
                }

            }
            else
            {
                Snackbar.Add(Lang.Text("Failed to load report data.", "रिपोर्ट डेटा लोड करने में विफल।"), Severity.Warning);
                _isLoading = false;
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                Lang.Text(
                    "An error occurred while loading the report.",
                    "रिपोर्ट लोड करते समय एक त्रुटि हुई।"),
                Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task Reset()
    {
        _selectedFinancialYear = null;
        _reportData.Clear();
    }

    private IEnumerable<DistrictWiseFarmerApplicationsDto> _filteredReportData =>
    _reportData.Where(t =>
    string.IsNullOrWhiteSpace(_searchString)
    || (t.DistrictNameEn?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DistrictNameHi?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.Target?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.FCount?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.SCount?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.Area?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.RApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
    || (t.DApproved?.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ExcelColumn<DistrictWiseFarmerApplicationsDto>> GetColumns() => new()
    {
        new() { HeaderEn = "District", HeaderHi = "जिला",
                ValueSelector = x => Lang.Text(x.DistrictNameEn!, x.DistrictNameHi!) },
        new() { HeaderEn = "Target Count", HeaderHi = "लक्ष्य (संख्या में)",
                ValueSelector = x => x.Target ?? 0,
                TotalSelector = list => list.Sum(x => x.Target ?? 0) },
        new() { HeaderEn = "Farmer Count", HeaderHi = "कृषक संख्या",
                ValueSelector = x => x.FCount ?? 0,
                TotalSelector = list => list.Sum(x => x.FCount ?? 0) },
        new() { HeaderEn = "Applications Count", HeaderHi = "आवेदन संख्या",
                ValueSelector = x => x.SCount ?? 0,
                TotalSelector = list => list.Sum(x => x.SCount ?? 0) },
        new() { HeaderEn = "Area (Hectares)", HeaderHi = "रकबा (हेक्टेयर में)",
                ValueSelector = x => x.Area ?? 0,
                TotalSelector = list => list.Sum(x => x.Area ?? 0) },
        new() { HeaderEn = "Number of applications approved by the RHEO", HeaderHi = "आरएचईओ द्वारा स्वीकृत आवेदनों की संख्या",
                ValueSelector = x => x.RApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.RApproved ?? 0) },
        new() { HeaderEn = "Number of applications approved by the DDH", HeaderHi = "डीडीएच द्वारा स्वीकृत आवेदनों की संख्या",
                ValueSelector = x => x.DApproved ?? 0,
                TotalSelector = list => list.Sum(x => x.DApproved ?? 0) },
    };

    private async Task ExportToExcel()
    {
        var finYear = (_finyears.FirstOrDefault(f => f.Id == _selectedFinancialYear)?.FinancialYear!)
                      .Replace("/", "-");

        await ExcelExport.ExportAsync(
            _filteredReportData.ToList(),
            GetColumns(),
            Lang.Text("District-Wise Farmer Applications Report", "जिलावार कृषक आवेदन रिपोर्ट"),
            (en, hi) => Lang.Text(en, hi),
            $"DistrictWise_FarmerApplicationsReport_{finYear}.xlsx");
    }
}
