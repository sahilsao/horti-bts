@using System.Threading.Tasks

<MudPaper Elevation="0" Class="pe-3">
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        @((MarkupString)GenerateCaptchaSvg())

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Primary"
                       OnClick="RegenerateCaptcha"
                       Size="Size.Medium" />
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public string CaptchaText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> CaptchaTextChanged { get; set; }

    [Parameter]
    public int Length { get; set; } = 6;

    private Random _random = new Random();
    private string[] _colors = new[]
    {
        "#7e6fff", "#594ae2", "#4a86ff",
        "#3dcb6c", "#ff3f5f", "#ffb545",
        "#5C6BC0", "#26A69A", "#AB47BC"
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(CaptchaText))
        {
            await RegenerateCaptcha();
        }
    }

    private async Task RegenerateCaptcha()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789";
        CaptchaText = new string(Enumerable.Repeat(chars, Length)
            .Select(s => s[_random.Next(s.Length)]).ToArray());

        await CaptchaTextChanged.InvokeAsync(CaptchaText);
        StateHasChanged();
    }

    private string GenerateCaptchaSvg()
    {
        var svg = new System.Text.StringBuilder();
        svg.Append("<svg width=\"220\" height=\"60\">");

        // Add text characters
        for (int i = 0; i < CaptchaText.Length; i++)
        {
            var x = 25 + (i * 32);
            var y = 40 + _random.Next(-8, 8);
            var rotation = _random.Next(-20, 20);
            var color = _colors[_random.Next(_colors.Length)];

            svg.Append($"<text x=\"{x}\" y=\"{y}\" font-size=\"32\" font-family=\"Courier New, monospace\" font-weight=\"bold\" fill=\"{color}\" transform=\"rotate({rotation} {x} {y})\" style=\"user-select: none;\">{CaptchaText[i]}</text>");
        }

        // Add noise lines
        for (int i = 0; i < 8; i++)
        {
            var x1 = _random.Next(0, 200);
            var y1 = _random.Next(0, 60);
            var x2 = _random.Next(0, 220);
            var y2 = _random.Next(0, 60);
            var lineColor = _colors[_random.Next(_colors.Length)];

            svg.Append($"<line x1=\"{x1}\" y1=\"{y1}\" x2=\"{x2}\" y2=\"{y2}\" stroke=\"{lineColor}\" stroke-width=\"2\" opacity=\"0.3\" />");
        }

        // Add noise dots
        for (int i = 0; i < 30; i++)
        {
            var cx = _random.Next(0, 220);
            var cy = _random.Next(0, 60);
            var dotColor = _colors[_random.Next(_colors.Length)];

            svg.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"2\" fill=\"{dotColor}\" opacity=\"0.4\" />");
        }

        svg.Append("</svg>");
        return svg.ToString();
    }
}